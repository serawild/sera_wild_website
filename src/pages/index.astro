    </a>


    <!-- Bildgruppe: gross 214×286 bei 0/0, klein 176×236 bei 164/86 → Unterkanten 36px versetzt -->
    <div class="relative mx-auto" style="width:340px;height:322px">
      <div class="absolute overflow-hidden rounded-[3px]" style="left:0;top:0;width:214px;height:286px">
        <BildPicture
