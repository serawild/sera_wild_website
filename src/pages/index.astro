---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---

<Base title="sera Wild — Footer-Vorschau">
  <!-- Platzhalter-Inhalt, damit der Footer am Seitenende sitzt -->
  <main class="flex flex-1 items-center justify-center px-sm py-xl text-center">
    <div class="max-w-2xl">
      <h1 class="font-display text-h1">sera Wild</h1>
      <p class="mt-md font-body text-body">
        Vorschau-Seite. Der eigentliche Inhalt folgt — unten der aus Figma
        umgesetzte Footer (Desktop &amp; Mobile). Fenster schmaler ziehen für die
        Mobile-Variante.
      </p>
    </div>
  </main>

  <Footer />
</Base>
