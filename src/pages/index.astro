---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import BildPicture from '../components/BildPicture.astro';
import DekoIllustration from '../components/DekoIllustration.astro';
import Wortmarke from '../components/Wortmarke.astro';

const referenzen = [
  {
    id: 'referenz-patricia',
    name: 'PATRICIA',
    zitat:
      'Sie ist voll auf meine Ideen eingegangen und hat sie noch mit ihrer inspirierenden Art «auf der Jagd nach dem schönsten Bild» optimiert. Ich konnte davon Einiges für mein Leben und meinen Weg mitnehmen.',
  },
  {
    id: 'referenz-ivor',
    name: 'IVOR',
    zitat:
      'Die Session bei Seraina ist unkompliziert und kurzweilig, geht aber gerade dadurch in die Tiefe. Man erhält nicht nur tolle Bilder, sondern introspektive Einblicke. Sehr empfehlenswert.',
  },
  {
    id: 'referenz-simona',
    name: 'SIMONA',
    zitat:
      'Ich habe mich gesehen, gehalten, ernst genommen und frei gefühlt. Man merkt, dass du nicht nur Bilder machst, sondern Räume öffnest, in denen etwas entstehen darf.',
  },
  {
    id: 'referenz-beatrice',
    name: 'BEATRICE',
    zitat:
      'Vor der Kamera zu stehen löst bei den meisten eher Unbehagen aus. Doch Seraina schafft es, dass man sich trotzdem wohl fühlt, sich selbst sein kann und daraus authentische Bilder entstehen.',
  },
];

const galerieIds = [
  'galerie-geschichten-01',
  'galerie-geschichten-02',
  'galerie-geschichten-03',
  'galerie-geschichten-04',
  'galerie-geschichten-05',
];

// Texte, die in mobile und desktop identisch vorkommen
const haltungH2   = 'Bei Sera Wild steht der Prozess im Mittelpunkt.';
const haltungBold = `Mir geht's um dich. Das Bild kommt von selbst.`;
const haltungText = 'Um den Moment, in dem du aufhörst, dich von aussen zu betrachten und beginnst, dich wirklich zu sehen. Trau dich vor die Kamera und erlebe den Moment, in dem du dich zeigst, ohne Rücksicht auf Erwartungen aus der Aussenwelt.';
const angebotH2   = 'Veränderung beginnt dort, wo du in Kontakt gehst. Mit dir selbst und mit anderen.';
const angebotText = 'Ich biete dir den Raum. Du probierst aus, folgst deinen Impulsen und entdeckst Schritt für Schritt, was entsteht, wenn du dir selbst Raum gibst.';
const galerieH2   = 'Jede Begegnung hinterlässt Spuren. Hier findest du Momente, die geblieben sind.';
const referenzenH2 = 'Was meine Kunden über mich sagen';
const kontaktH2   = 'Für alle, die sich selbst zurückfinden möchten.';
const kontaktText1 = 'Du musst noch nicht wissen, wie das aussehen soll. Schreib mir einfach, was dich gerade beschäftigt – oder ruf an, wenn dir das leichter fällt.';
const kontaktText2 = 'Wir telefonieren kurz und unverbindlich. Danach entscheidest du in Ruhe, ohne Anzahlung und ohne Druck.';
---

<Base
  title="sera Wild — prozessorientierte Fotografie"
  description="Prozessorientierte Fotografie in der Schweiz. Sera Wild begleitet Menschen dabei, sich wirklich zu sehen – mutig, spontan und echt."
>

  <!-- ===== 1. HERO ===== -->
  <section class="relative h-[43.75rem] overflow-hidden md:h-[100svh] md:min-h-[600px]">

    <!-- Hintergrundbild: mobil (-hoch), Desktop (normal) -->
    <div class="absolute inset-0 overflow-hidden md:hidden">
      <BildPicture
        id="hero-startseite"
        mobil={true}
        class="absolute inset-0 h-full w-full object-cover object-top"
        loading="eager"
        fetchpriority="high"
        widths={[390, 780]}
        sizes="100vw"
      />
    </div>
    <div class="absolute inset-0 hidden overflow-hidden md:block">
      <BildPicture
        id="hero-startseite"
        class="absolute inset-0 h-full w-full object-cover object-[78%_0%] scale-[1.26] origin-[78%_0%]"
        loading="eager"
        fetchpriority="high"
        widths={[768, 1280, 1728, 2560]}
        sizes="100vw"
      />
    </div>

    <div class="absolute inset-0 bg-black/40 pointer-events-none" aria-hidden="true"></div>
    <Navigation farbe="hell" />

    <!-- Text: mobil links unten, desktop rechts unten -->
    <div class="absolute bottom-16 left-6 flex max-w-[calc(100%-3rem)] flex-col items-start gap-6 text-left
                md:bottom-[5rem] md:left-auto md:right-[7.5rem] md:max-w-[56.25rem] md:items-end md:gap-[2.5rem] md:text-right">
      <h1 class="font-display text-[1.9375rem] font-semibold leading-[1.3] text-cream md:text-h1 md:leading-normal">
        Hier beginnt die Begegnung mit dir selbst: Du zeigst dich. Ich mach's sichtbar.
      </h1>
      <a
        href="/kontakt"
        class="inline-flex items-center justify-center rounded-[8px] bg-rust px-7 py-[0.9375rem] font-body text-[0.875rem] uppercase tracking-[0.088em] text-cream transition-colors hover:bg-orange
               md:rounded-[1.0625rem] md:px-md md:py-sm md:text-cta"
      >
        Los geht's!
      </a>
    </div>
  </section>


  <!-- ===== 2a. MOBILE: 01 Haltung ===== -->
  <section class="relative isolate overflow-visible z-[2] bg-cream px-6 pt-12 pb-12 md:hidden">
    <DekoIllustration motiv="tulpe" farbe="#A0886D" breite={186} cssRotate={-27} obenAbAnkerAnteil={0.16} seite="rechts" abstand={-86} mobil={true} deckkraft={0.6} />
    <!-- Kapitelmarke -->
    <div class="mb-[18px] flex items-center gap-3">
      <span class="font-body font-bold text-[0.75rem] uppercase tracking-[0.08em] text-dark/50">01</span>
      <div class="h-px w-5 bg-dark/50" aria-hidden="true"></div>
      <span class="font-body text-[0.75rem] uppercase tracking-[0.16em] text-dark/50">HALTUNG</span>
    </div>

    <!-- H2 -->
    <h2 class="mb-[18px] font-display text-[1.6875rem] font-semibold leading-[1.3] text-dark">
      {haltungH2}
    </h2>

    <!-- Text -->
    <div class="mb-6 flex flex-col gap-[14px]">
      <p class="font-body text-[1.0625rem] font-bold leading-[1.68] text-dark">{haltungBold}</p>
      <p class="font-body text-[1.0625rem] leading-[1.68] text-dark">{haltungText}</p>
    </div>

    <!-- Button -->
    <a
      href="/ueber"
      class="mb-8 inline-flex items-center justify-center rounded-[8px] bg-rust px-7 py-[0.9375rem] font-body text-[0.875rem] uppercase tracking-[0.088em] text-cream transition-colors hover:bg-orange"
    >
      MEHR DAZU
    </a>

    <!-- Bildgruppe: gross 224×298 bei 0/0, klein 160×214 bei 164/120 → Unterkanten um 36px versetzt -->
    <div class="relative mx-auto" style="width:324px;height:334px">
      <div class="absolute overflow-hidden rounded-[3px]" style="left:0;top:0;width:224px;height:298px">
        <BildPicture
          id="ueber-mich-01"
          mobil={true}
          class="h-full w-full object-cover"
          widths={[224, 448]}
          sizes="224px"
        />
      </div>
      <div class="absolute overflow-hidden rounded-[3px]" style="left:164px;top:120px;width:160px;height:214px">
        <BildPicture
          id="ueber-mich-02"
          mobil={true}
          class="h-full w-full object-cover"
          widths={[160, 320]}
          sizes="160px"
        />
      </div>
    </div>
  </section>

  <!-- ===== 2b. DESKTOP: Über mich ===== -->
  <section class="relative isolate overflow-visible z-10 bg-cream py-xl hidden md:block">
    <DekoIllustration motiv="tulpe" farbe="#5B5C4F" breite={261} cssRotate={29} top={703} seite="links" abstand={-108} />
    <div class="mx-auto flex max-w-inhalt items-center gap-[5rem]">

      <div class="relative shrink-0" style="width:35rem;height:43.75rem">
        <div class="absolute" style="left:1.875rem;top:2.5rem;width:15rem;height:20rem">
          <BildPicture id="ueber-mich-02" class="absolute inset-0 h-full w-full object-cover" widths={[240, 480]} sizes="15rem" />
        </div>
        <div class="absolute" style="left:15rem;top:1.25rem;width:18.75rem;height:25rem">
          <BildPicture id="ueber-mich-01" class="absolute inset-0 h-full w-full object-cover" widths={[300, 600]} sizes="18.75rem" />
        </div>
        <div class="absolute" style="left:9.375rem;top:19.375rem;width:16.25rem;height:21.25rem">
          <BildPicture id="ueber-mich-03" class="absolute inset-0 h-full w-full object-cover" widths={[260, 520]} sizes="16.25rem" />
        </div>
      </div>

      <div class="flex flex-1 min-w-0 flex-col items-start gap-[3rem]">
        <h2 class="font-display text-h2 font-semibold leading-normal md:-ml-sm">{haltungH2}</h2>
        <div class="flex flex-col gap-6">
          <p class="font-body text-body font-bold leading-[1.65]">{haltungBold}</p>
          <p class="font-body text-body leading-[1.65]">{haltungText}</p>
        </div>
        <a href="/ueber" class="inline-flex items-center justify-center rounded-[1.0625rem] bg-rust px-md py-sm font-body text-cta uppercase text-cream transition-colors hover:bg-orange">
          MEHR DAZU
        </a>
      </div>

    </div>
  </section>


  <!-- ===== 3. ERLÄBNIS — nur Desktop ===== -->
  <section class="hidden md:block relative isolate overflow-visible z-0 bg-dark py-xl">
    <DekoIllustration motiv="mohn" farbe="#5B5C4F" breite={450} cssRotate={-30} top={568} seite="rechts" abstand={-270} />
    <div class="mx-auto flex max-w-inhalt flex-col items-center gap-[3rem] px-[12.5rem]">

      <div role="img" aria-label="W – Erläbnis">
        <Wortmarke wort="Erläbnis" breite={25} klasse="text-cream" />
      </div>

      <p class="font-body text-body leading-[1.65] text-center" style="max-width:50rem">
        Du weisst, da steckt mehr in dir. Du hast nur noch nicht den Raum gehabt, es zu zeigen. Ich biete dir einen Raum, in dem du mutig, spontan und kreativ sein darfst.
      </p>

      <div class="relative shrink-0" style="width:43.75rem;height:20rem">
        <div class="absolute overflow-hidden rounded-[0.25rem]" style="left:2.5rem;top:0.625rem;width:23.75rem;height:16.875rem">
          <BildPicture id="startseite-erlaebnis-01" class="absolute inset-0 h-full w-full object-cover" widths={[380, 760]} sizes="23.75rem" />
        </div>
        <div class="absolute overflow-hidden rounded-[0.25rem]" style="left:20rem;top:3.125rem;width:21.875rem;height:15.625rem">
          <BildPicture id="startseite-erlaebnis-02" class="absolute inset-0 h-full w-full object-cover" widths={[350, 700]} sizes="21.875rem" />
        </div>
      </div>

      <a href="/w-erlaebnis" class="inline-flex items-center justify-center rounded-[1.0625rem] bg-beige px-md py-sm font-body text-cta uppercase text-cream transition-colors hover:bg-orange">
        Zum W–Erläbnis
      </a>
    </div>
  </section>


  <!-- ===== 4. AUTHENTIZITÄT — nur Desktop ===== -->
  <section class="hidden md:flex relative isolate overflow-visible z-10 bg-cream py-xl">
    <DekoIllustration motiv="blattzweig" farbe="#BC541F" breite={371} cssRotate={-30} top={672} seite="rechts" abstand={-348} />
    <div class="mx-auto flex max-w-inhalt items-center gap-[5rem]">

      <div class="flex flex-1 min-w-0 flex-col items-start gap-[3rem]">
        <h2 class="font-display text-h2 font-semibold leading-normal md:-ml-sm">
          Du musst nicht jemand anderes sein, um gesehen zu werden.
        </h2>
        <p class="font-body text-body leading-[1.65]">
          Viele Menschen kommen zu mir und sagen: <span class="font-display text-h3 font-semibold italic">Ich bin nicht fotogen. </span>Was sie eigentlich meinen: <span class="font-display text-h3 font-semibold italic">Ich habe mich noch nie wirklich gesehen. </span>Und genau dort beginnen wir.
        </p>
        <a href="/kontakt" class="inline-flex items-center justify-center rounded-[1.0625rem] bg-rust px-md py-sm font-body text-cta uppercase text-cream transition-colors hover:bg-orange">
          schreib mir!
        </a>
      </div>

      <div class="relative shrink-0" style="width:37.5rem;height:46.875rem">
        <div class="absolute overflow-hidden" style="left:12.125rem;top:3rem;width:25.375rem;height:30.5625rem">
          <BildPicture id="authentizitaet-01" class="absolute inset-0 h-full w-full object-cover" widths={[406, 812]} sizes="25.375rem" />
        </div>
        <div class="absolute overflow-hidden" style="left:0;top:17.0625rem;width:20rem;height:26.25rem">
          <BildPicture id="authentizitaet-02" class="absolute inset-0 h-full w-full object-cover" widths={[320, 640]} sizes="20rem" />
        </div>
      </div>

    </div>
  </section>


  <!-- ===== 5a. MOBILE: 02 Angebot (dunkel) ===== -->
  <section class="relative isolate overflow-visible z-[1] bg-dark px-6 pt-[52px] pb-[52px] md:hidden">
    <DekoIllustration motiv="mohn" farbe="#5B5C4F" breite={162} cssRotate={21} obenAbAnkerAnteil={0.16} seite="links" abstand={-75} mobil={true} deckkraft={0.6} />
    <!-- Kapitelmarke -->
    <div class="mb-[18px] flex items-center gap-3">
      <span class="font-body font-bold text-[0.75rem] uppercase tracking-[0.08em] text-cream/50">02</span>
      <div class="h-px w-5 bg-cream/50" aria-hidden="true"></div>
      <span class="font-body text-[0.75rem] uppercase tracking-[0.16em] text-cream/50">ANGEBOT</span>
    </div>

    <!-- H2 -->
    <h2 class="mb-[18px] font-display text-[1.6875rem] font-semibold leading-[1.3] text-cream">
      {angebotH2}
    </h2>

    <!-- Text -->
    <p class="mb-6 font-body text-[1.0625rem] leading-[1.68] text-cream/80">{angebotText}</p>

    <!-- Button -->
    <a
      href="/kontakt"
      class="mb-8 inline-flex items-center justify-center rounded-[8px] bg-beige px-7 py-[0.9375rem] font-body text-[0.875rem] uppercase tracking-[0.088em] text-cream transition-colors hover:bg-orange"
    >
      Kontaktiere mich
    </a>

    <!-- Bildgruppe: gross 214×286 bei 0/0, klein 178×238 bei 164/84 → Unterkanten 36px versetzt -->
    <div class="relative mx-auto" style="width:342px;height:322px">
      <div class="absolute overflow-hidden rounded-[3px]" style="left:0;top:0;width:214px;height:286px">
        <BildPicture
          id="startseite-erlaebnis-01"
          mobil={true}
          class="h-full w-full object-cover"
          widths={[214, 428]}
          sizes="214px"
        />
      </div>
      <div class="absolute overflow-hidden rounded-[3px]" style="left:164px;top:84px;width:178px;height:238px">
        <BildPicture
          id="startseite-erlaebnis-02"
          mobil={true}
          class="h-full w-full object-cover"
          widths={[178, 356]}
          sizes="178px"
        />
      </div>
    </div>
  </section>

  <!-- ===== 5b. DESKTOP: Angebot (rust) ===== -->
  <section class="hidden md:block relative isolate overflow-visible z-0 bg-rust pt-xl pb-[7rem]">
    <DekoIllustration motiv="eukalyptus" farbe="#BC541F" breite={320} cssRotate={29.2} top={260} seite="links" abstand={-159} />
    <div class="mx-auto flex max-w-inhalt flex-col items-center gap-[3rem] px-[12.5rem]">
      <h2 class="font-display text-h2 font-semibold leading-normal text-center" style="max-width:56.25rem">
        {angebotH2}
      </h2>
      <p class="font-body text-body leading-[1.65] text-center" style="max-width:56.25rem">{angebotText}</p>
      <a href="/kontakt" class="inline-flex items-center justify-center rounded-[1.0625rem] bg-beige px-md py-sm font-body text-cta uppercase text-cream transition-colors hover:bg-orange">
        Kontaktiere mich
      </a>
    </div>
  </section>


  <!-- ===== 6. GALERIE / GESCHICHTEN (responsive) ===== -->
  <section class="relative z-0 bg-cream py-12 md:py-xl">
    <DekoIllustration motiv="eukalyptus" farbe="#A0886D" breite={140} cssRotate={-33} obenAbAnkerAnteil={0.16} seite="rechts" abstand={-64} mobil={true} deckkraft={0.6} />
    <div class="mx-auto mb-5 px-6 text-center md:mb-[3rem] md:max-w-inhalt md:px-[7.5rem]">
      <h2 class="font-display text-[1.6875rem] font-semibold leading-[1.3] md:text-h2 md:leading-normal" style="max-width:75rem">
        {galerieH2}
      </h2>
    </div>

    <div class="relative">
      <!-- Prev-Pfeil (nur Desktop) -->
      <button
        id="galerie-prev"
        aria-label="Vorherige Bilder"
        class="absolute left-[3rem] top-1/2 z-10 hidden -translate-y-1/2 items-center justify-center rounded-full bg-dark/70 text-cream transition-opacity hover:bg-dark/90"
        style="width:3rem;height:3rem"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" />
        </svg>
      </button>

      <!-- Scroll-Container -->
      <div id="galerie-scroll" class="overflow-x-auto" style="scrollbar-width:none;-webkit-overflow-scrolling:touch">
        <div id="galerie-track" class="flex gap-[0.625rem] pl-6 pr-3 md:gap-[1rem] md:px-[7.5rem]">
          {galerieIds.map((gId, i) => (
            <div class="carousel-item relative shrink-0 overflow-hidden rounded-[3px] w-[16.25rem] h-[21.25rem] md:w-[32.4375rem] md:h-[43.25rem]">
              <BildPicture
                id={gId}
                class="absolute inset-0 h-full w-full object-cover"
                widths={[260, 519, 1038]}
                sizes="(max-width:767px) 260px, 32.4375rem"
              />
            </div>
          ))}
        </div>
      </div>

      <!-- Next-Pfeil (nur Desktop) -->
      <button
        id="galerie-next"
        aria-label="Nächste Bilder"
        class="absolute right-[3rem] top-1/2 z-10 hidden -translate-y-1/2 items-center justify-center rounded-full bg-dark/70 text-cream transition-opacity hover:bg-dark/90 md:flex"
        style="width:3rem;height:3rem"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
          <path d="M9 18l6-6-6-6" />
        </svg>
      </button>
    </div>

    <!-- Scroll-Punkte (nur Mobile) -->
    <div class="mt-4 flex justify-center gap-2 md:hidden" id="galerie-dots" aria-hidden="true">
      {galerieIds.map((_, i) => (
        <div
          class:list={['galerie-dot rounded-full bg-dark transition-opacity', i === 0 ? 'opacity-100' : 'opacity-40']}
          style="width:7px;height:7px"
        />
      ))}
    </div>

    <div class="mt-8 flex justify-center md:mt-[3rem]">
      <a href="/geschichten" class="inline-flex items-center justify-center rounded-[8px] bg-rust px-7 py-[0.9375rem] font-body text-[0.875rem] uppercase tracking-[0.088em] text-cream transition-colors hover:bg-orange md:rounded-[1.0625rem] md:px-md md:py-sm md:text-cta">
        Zu den Geschichten
      </a>
    </div>
  </section>

  <script>
    const scroll = document.getElementById('galerie-scroll') as HTMLElement;
    const track  = document.getElementById('galerie-track')  as HTMLElement;
    const prev   = document.getElementById('galerie-prev')   as HTMLButtonElement;
    const next   = document.getElementById('galerie-next')   as HTMLButtonElement;
    const dots   = Array.from(document.querySelectorAll<HTMLElement>('.galerie-dot'));

    function stepWidth(): number {
      const item = track?.querySelector('.carousel-item') as HTMLElement | null;
      if (!item) return 540;
      const gap = parseFloat(getComputedStyle(track).gap) || 10;
      return item.offsetWidth + gap;
    }

    function updateButtons() {
      if (!scroll || !prev || !next) return;
      const atStart = scroll.scrollLeft <= 4;
      const atEnd   = scroll.scrollLeft >= scroll.scrollWidth - scroll.clientWidth - 4;
      prev.classList.toggle('hidden', atStart);
      prev.classList.toggle('flex', !atStart);
      next.classList.toggle('hidden', atEnd);
      next.classList.toggle('flex', !atEnd);
    }

    function updateDots() {
      if (!scroll || !dots.length) return;
      const sw = stepWidth();
      const idx = Math.round(scroll.scrollLeft / sw);
      dots.forEach((d, i) => {
        d.classList.toggle('opacity-100', i === idx);
        d.classList.toggle('opacity-40',  i !== idx);
      });
    }

    prev?.addEventListener('click', () => { scroll.scrollBy({ left: -stepWidth(), behavior: 'smooth' }); });
    next?.addEventListener('click', () => { scroll.scrollBy({ left:  stepWidth(), behavior: 'smooth' }); });
    scroll?.addEventListener('scroll', () => { updateButtons(); updateDots(); }, { passive: true });
    updateButtons();
  </script>


  <!-- ===== 7. GESCHICHTEN gespiegelt — nur Desktop ===== -->
  <section class="hidden md:flex bg-dark py-xl">
    <div class="mx-auto flex max-w-inhalt items-start gap-[5rem]">

      <div class="flex min-w-0 flex-1 flex-col items-start gap-[3rem]">
        <h2 class="font-display text-h2 font-semibold leading-normal">
          Wenn du etwas willst, das du noch nie hattest, musst du etwas tun, das du noch nie getan hast.
        </h2>
        <div class="font-body text-body leading-[1.65]">
          <p>Ich bin Seraina und ich begleite dich</p>
          <p>hinter der Kamera durch diesen wunder-vollen Prozess. Ich freue mich auf dich!</p>
        </div>
        <a href="/ueber" class="inline-flex items-center justify-center rounded-[1.0625rem] bg-beige px-md py-sm font-body text-cta uppercase text-cream transition-colors hover:bg-orange">
          ÜBER SERAWILD
        </a>
      </div>

      <div class="relative shrink-0 overflow-hidden" style="width:37.5rem;height:46.875rem">
        <BildPicture id="seraina-portrait" class="absolute inset-0 h-full w-full object-cover object-center" widths={[600, 1200]} sizes="37.5rem" />
      </div>

    </div>
  </section>


  <!-- ===== 8a. MOBILE: 04 Stimmen (oliv) ===== -->
  <section class="relative z-0 bg-olive px-6 pt-[52px] pb-[52px] md:hidden">
    <DekoIllustration motiv="blattzweig" farbe="#5B5C4F" breite={122} cssRotate={15} obenAbAnkerAnteil={0.16} seite="links" abstand={-56} mobil={true} deckkraft={0.6} />
    <!-- Kapitelmarke -->
    <div class="mb-[18px] flex items-center gap-3">
      <span class="font-body font-bold text-[0.75rem] uppercase tracking-[0.08em] text-cream/50">04</span>
      <div class="h-px w-5 bg-cream/50" aria-hidden="true"></div>
      <span class="font-body text-[0.75rem] uppercase tracking-[0.16em] text-cream/50">STIMMEN</span>
    </div>

    <h2 class="mb-5 font-display text-[1.6875rem] font-semibold leading-[1.3] text-cream">{referenzenH2}</h2>

    <!-- Wischleiste -->
    <div class="overflow-x-auto -mx-6" style="scrollbar-width:none">
      <div class="flex gap-[10px] pl-6 pr-6" id="stimmen-track">
        {referenzen.map(({ id, name, zitat }) => (
          <div class="relative shrink-0 flex flex-col items-center gap-4 overflow-hidden rounded-[8px] px-5 py-6" style="width:260px;background:rgba(255,255,255,0.12)">
            <div class="relative shrink-0 overflow-hidden rounded-full" style="width:50px;height:50px">
              <BildPicture
                id={id}
                mobil={true}
                class="absolute inset-0 h-full w-full object-cover"
                widths={[50, 100]}
                sizes="50px"
              />
            </div>
            <p class="font-display text-[1.25rem] font-semibold text-cream text-center">{name}</p>
            <p class="font-body text-[1rem] italic leading-[1.65] text-cream/80 text-center">{zitat}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Scroll-Punkte -->
    <div class="mt-4 flex justify-center gap-2" id="stimmen-dots" aria-hidden="true">
      {referenzen.map((_, i) => (
        <div
          class:list={['stimmen-dot rounded-full bg-cream transition-opacity', i === 0 ? 'opacity-100' : 'opacity-40']}
          style="width:7px;height:7px"
        />
      ))}
    </div>
  </section>

  <script>
    const stimmenTrack = document.getElementById('stimmen-track') as HTMLElement | null;
    const stimmenScroll = stimmenTrack?.parentElement as HTMLElement | null;
    const stimmenDots = Array.from(document.querySelectorAll<HTMLElement>('.stimmen-dot'));

    function stimmenStep(): number {
      const item = stimmenTrack?.querySelector<HTMLElement>('div') ?? null;
      if (!item) return 270;
      return item.offsetWidth + 10;
    }

    function updateStimmenDots() {
      if (!stimmenScroll || !stimmenDots.length) return;
      const idx = Math.round(stimmenScroll.scrollLeft / stimmenStep());
      stimmenDots.forEach((d, i) => {
        d.classList.toggle('opacity-100', i === idx);
        d.classList.toggle('opacity-40',  i !== idx);
      });
    }

    stimmenScroll?.addEventListener('scroll', updateStimmenDots, { passive: true });
  </script>

