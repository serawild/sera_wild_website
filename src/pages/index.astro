            <div class="relative shrink-0 overflow-hidden rounded-full" style="width:5rem;height:5rem">
              <BildPicture id={id} class="absolute inset-0 h-full w-full object-cover" widths={[80, 160]} sizes="5rem" />
            </div>
            <p class="font-display text-h3 font-semibold text-dark text-center">{name}</p>
            <p class="font-body text-body-klein italic leading-[1.7] text-dark text-center">{zitat}</p>
