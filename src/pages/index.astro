---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import Photo from '../components/Photo.astro';

import bildmarkeWhite from '../assets/bildmarke-white.svg';
import decoHero from '../assets/deco-hero.png';
import decoBranch from '../assets/deco-branch-rust.png';
import decoTulip from '../assets/deco-tulip-rust.png';
import decoTulipDark from '../assets/deco-tulip-dark.png';
import decoEucalyptus from '../assets/deco-eucalyptus-rust.png';
import decoFlower from '../assets/deco-flower-rust.png';
import seraina from '../assets/seraina-portrait.png';

import hero from '../assets/hero.jpg';
import prozess1 from '../assets/prozess-1.jpg';
import prozess2 from '../assets/prozess-2.jpg';
import prozess3 from '../assets/prozess-3.jpg';
import gesehen1 from '../assets/gesehen-1.jpg';
import gesehen2 from '../assets/gesehen-2.jpg';
import geschichte1 from '../assets/geschichte-1.jpg';
import geschichte2 from '../assets/geschichte-2.jpg';
import geschichte3 from '../assets/geschichte-3.jpg';
import geschichte4 from '../assets/geschichte-4.jpg';
import fueralle1 from '../assets/fueralle-1.jpg';
import fueralle2 from '../assets/fueralle-2.jpg';
import werlaebnis1 from '../assets/werlaebnis-1.jpg';
import werlaebnis2 from '../assets/werlaebnis-2.jpg';

const geschichten = [geschichte1, geschichte2, geschichte3, geschichte4];
---

<Base title="sera Wild — prozessorientierte Fotografie">
  <Navigation />

  <main class="relative flex-1 overflow-x-hidden">

    {/* ===== 1 · Hero — Text unten rechts ===== */}
    <section class="relative overflow-hidden bg-cream">
      <img
        src={decoHero.src}
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute -right-[6rem] -top-[5rem] z-10 w-[20rem] rotate-[-55deg] md:-right-[20rem] md:-top-[14rem] md:w-[34rem]"
      />
      <div class="relative w-full">
        <Image
          src={hero}
          alt="Frau mit Strohhut im Lavendelfeld"
          widths={[640, 1024, 1440, 1728, 2000]}
          sizes="100vw"
          class="aspect-[4/5] w-full object-cover object-[25%_center] md:aspect-[3/2] md:object-center"
        />
        {/* Headline-Overlay Desktop — unten rechts */}
        <div class="absolute inset-0 hidden items-end justify-end pb-xl md:flex">
          <div class="mr-xl flex max-w-2xl flex-col items-end text-right">
            <h1 class="font-display text-h1 font-semibold leading-[1.05] text-dark">
              Hier beginnt die Begegnung mit dir selbst: Du zeigst dich. Ich mach's sichtbar.
            </h1>
            <Button href="/angebot" variant="rust" class="mt-md">Los geht's!</Button>
          </div>
        </div>
      </div>
      {/* Headline Mobile — unter dem Bild */}
      <div class="flex flex-col gap-md px-sm py-lg md:hidden">
        <h1 class="font-display text-h1 font-semibold leading-[1.05] text-dark">
          Hier beginnt die Begegnung mit dir selbst: Du zeigst dich. Ich mach's sichtbar.
        </h1>
        <Button href="/angebot" variant="rust" class="self-start">Los geht's!</Button>
      </div>
    </section>

    {/* ===== 2 · Prozess (cream, Foto-Collage links) ===== */}
    <section class="relative overflow-hidden bg-cream">
      <img
        src={decoBranch.src}
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute bottom-0 left-0 z-10 w-32 opacity-80 md:w-40"
      />
      <div class="mx-auto grid max-w-content items-center gap-lg px-sm py-xl md:grid-cols-2 md:px-lg">
        <div class="relative aspect-[689/780] w-full">
          <Photo src={prozess1} alt="Prozess: Schreiben und Festhalten" class="absolute left-0 top-[7.4%] h-[47.9%] w-[41.1%]" />
          <Photo src={prozess3} alt="Porträt, entspannt" class="absolute left-[14.9%] top-[48.5%] h-[51.5%] w-[44%]" />
          <Photo src={prozess2} alt="Porträt am Fenster" class="absolute left-[46.6%] top-0 h-[62.6%] w-[53.4%]" />
        </div>
        <div class="flex flex-col gap-md">
          <h2 class="font-display text-h2 font-semibold text-dark md:-ml-sm">Bei Sera Wild steht der Prozess im Mittelpunkt.</h2>
          <p class="font-body text-body text-dark">
            <span class="font-body font-bold">Mir geht's um dich. Das Bild kommt von selbst.</span>
            {' '}Um den Moment, in dem du aufhörst, dich von aussen zu betrachten und beginnst, dich wirklich zu
            sehen. Trau dich vor die Kamera und erlebe den Moment, in dem du dich zeigst, ohne Rücksicht auf
            Erwartungen aus der Aussenwelt.
          </p>
          <Button href="/angebot" variant="rust" class="self-start">Mehr dazu</Button>
        </div>
      </div>
    </section>

    {/* ===== 3 · W-Erläbnis (dark, 3 Spalten mit schwebenden Fotos) ===== */}
    <section class="relative overflow-hidden bg-dark py-xl text-cream">
      <img
        src={decoEucalyptus.src}
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute bottom-0 right-0 z-0 w-36 opacity-20 md:w-48"
      />
      <div class="relative z-10 mx-auto grid max-w-content items-center px-sm md:grid-cols-[1fr_1.8fr_1fr] md:px-lg">
        {/* Foto links — Querformat, ganz unten */}
        <div class="hidden md:flex md:items-end md:justify-end md:pr-lg">
          <div class="w-[95%]">
            <Image
              src={werlaebnis1}
              alt="Frau im Lavendelfeld"
              widths={[300, 500]}
              sizes="14vw"
              class="aspect-[8/5] w-full object-cover object-center"
            />
          </div>
        </div>

        {/* Text zentriert */}
        <div class="flex flex-col items-center gap-md text-center">
          <div class="flex items-baseline">
            <img src={bildmarkeWhite.src} alt="" aria-hidden="true" class="relative z-10 h-20 w-auto md:h-[11rem]" style="margin-right: -2rem;" />
            <span class="font-display text-h2 font-semibold">– Erläbnis</span>
          </div>
          <p class="font-body text-body">
            Du weisst, da steckt mehr in dir. Du hast nur noch nicht den Raum gehabt, es zu zeigen. Ich biete
            dir einen Raum, in dem du mutig, spontan und kreativ sein darfst.
          </p>
          <Button href="/angebot" variant="beige">Zum W–Erläbnis</Button>
        </div>

        {/* Foto rechts — Hochformat, ganz oben */}
        <div class="hidden md:flex md:items-start md:justify-start md:pl-lg">
          <div class="w-[85%]">
            <Image
              src={werlaebnis2}
              alt="Frau lachend im Lavendelfeld"
              widths={[200, 400]}
              sizes="12vw"
              class="aspect-[5/8] w-full object-cover object-top"
            />
          </div>
        </div>
      </div>
    </section>

    {/* ===== 4 · Gesehen werden (beige, Grossformat wie Hero) ===== */}
    <section class="relative overflow-hidden bg-beige">
      <img
        src={decoTulipDark.src}
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute bottom-0 right-0 z-10 w-32 opacity-60 md:w-44"
      />
      <div class="flex flex-col md:grid md:aspect-[3/2] md:grid-cols-[1.1fr_0.9fr]">
        {/* Foto links — vollflächig, goldener Schnitt */}
        <div class="relative aspect-[4/5] overflow-hidden md:aspect-auto">
          <Image
            src={gesehen1}
            alt="Porträt, lachend"
            widths={[600, 900, 1400]}
            sizes="(max-width: 768px) 100vw, 55vw"
            class="absolute inset-0 h-full w-full object-cover object-[20%_center]"
          />
        </div>
        {/* Text rechts */}
        <div class="flex flex-col justify-between gap-lg px-sm py-xl md:px-lg">
          <div class="flex flex-col gap-md">
            <h2 class="font-display text-h2 font-semibold text-dark md:-ml-sm">
              Du musst nicht jemand anderes sein, um gesehen zu werden.
            </h2>
            <p class="font-body text-body text-dark">
              Viele Menschen kommen zu mir und sagen:{' '}
              <span class="font-display text-highlight font-semibold italic">Ich bin nicht fotogen.</span>{' '}
              Was sie eigentlich meinen:{' '}
              <span class="font-display text-highlight font-semibold italic">Ich habe mich noch nie wirklich gesehen.</span>{' '}
              Und genau dort beginnen wir.
            </p>
            <Button href="/kontakt" variant="rust" class="self-start">Schreib mir!</Button>
          </div>
          {/* 2. Foto — Hochformat, unten rechts */}
          <div class="hidden overflow-hidden md:block md:w-[45%] md:self-end">
            <Image
              src={gesehen2}
              alt="Porträt"
              widths={[200, 400]}
              sizes="22vw"
              class="aspect-[5/8] w-full object-cover"
            />
          </div>
        </div>
      </div>
    </section>

    {/* ===== 5 · Veränderung (rust, zentriert mit Illustrationen) ===== */}
    <section class="relative overflow-hidden bg-rust text-cream">
      <img
        src={decoEucalyptus.src}
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute left-0 top-1/2 z-10 w-28 -translate-y-1/2 opacity-40 md:w-40"
      />
      <img
        src={decoTulip.src}
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute right-0 top-1/2 z-10 w-28 -translate-y-1/2 opacity-40 md:w-40"
      />
      <div class="mx-auto flex max-w-4xl flex-col items-center gap-md px-sm py-xl text-center md:px-lg">
        <h2 class="font-display text-h2 font-semibold">
          Veränderung beginnt dort, wo du in Kontakt gehst. Mit dir selbst und mit anderen.
        </h2>
        <p class="max-w-2xl font-body text-body">
          Ich biete dir den Raum. Du probierst aus, folgst deinen Impulsen und entdeckst Schritt für Schritt,
          was entsteht, wenn du dir selbst Raum gibst.
        </p>
        <Button href="/kontakt" variant="beige">Kontaktiere mich</Button>
      </div>
    </section>

    {/* ===== 6 · Geschichten (cream, horizontaler Strip) ===== */}
    <section class="bg-cream py-xl">
      <div class="mx-auto max-w-content px-sm text-center md:px-lg">
        <h2 class="font-display text-h2 font-semibold text-dark">
          Jede Begegnung hinterlässt Spuren. Hier findest du Momente, die geblieben sind.
        </h2>
      </div>
      <div class="mt-lg overflow-x-auto" style="scrollbar-width:none;-webkit-overflow-scrolling:touch;">
        <ul class="flex px-sm md:px-lg" style="gap:4px;">
          {
            geschichten.map((bild, i) => (
              <li class="aspect-[5/6] w-[clamp(14rem,23vw,23rem)] shrink-0">
                <a href="/geschichten" class="group block h-full">
                  <Photo
                    src={bild}
                    alt={`Geschichte ${i + 1}`}
                    class="h-full transition duration-300 group-hover:opacity-90"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="mt-lg px-sm text-center md:px-lg">
        <Button href="/geschichten" variant="rust">Zu den Geschichten</Button>
      </div>
    </section>

    {/* ===== 7 · Seraina (dark, Text links / Portrait rechts mit Padding) ===== */}
    <section class="relative overflow-hidden bg-dark text-cream">
      <img
        src={decoBranch.src}
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute bottom-0 left-0 z-10 w-32 opacity-70 md:w-40"
      />
      <div class="mx-auto grid max-w-content items-center gap-lg px-sm py-xl md:grid-cols-2 md:px-lg">
        <div class="flex flex-col gap-md">
          <h2 class="font-display text-h2 font-semibold">
            Wenn du etwas willst, das du noch nie hattest, musst du etwas tun, das du noch nie getan hast.
          </h2>
          <p class="font-body text-body">
            Ich bin Seraina und ich begleite dich hinter der Kamera durch diesen wunder&shy;vollen Prozess.
            Ich freue mich auf dich!
          </p>
          <Button href="/sera-wild" variant="beige" class="self-start">Über SeraWild</Button>
        </div>
        <div class="flex justify-center md:justify-end">
          <Image
            src={seraina}
            alt="Seraina Wild, Fotografin"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 80vw, 40vw"
            class="max-h-[70vh] w-auto object-cover"
          />
        </div>
      </div>
    </section>

    {/* ===== 8 · Für alle (rust, Collage links) ===== */}
    <section class="relative overflow-hidden bg-rust text-cream">
      <img
        src={decoFlower.src}
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute bottom-0 right-0 z-10 w-32 opacity-60 md:w-44"
      />
      <div class="mx-auto grid max-w-content items-center gap-lg px-sm py-xl md:grid-cols-2 md:px-lg">
        <div class="relative aspect-[720/417] w-full">
          <Photo src={fueralle1} alt="Porträt am Wasser" class="absolute left-[35.8%] top-0 h-[77.5%] w-[64.2%]" />
          <Photo src={fueralle2} alt="Porträt am See" class="absolute left-0 top-[34.5%] h-[65.5%] w-[57.4%]" />
        </div>
        <div class="flex flex-col items-start gap-md md:items-end md:text-right">
          <h2 class="font-display text-h2 font-semibold">Für alle, die sich selbst zurückfinden möchten.</h2>
          <Button href="/kontakt" variant="beige">Kontakt</Button>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Base>
