  <!-- ===== 9b. DESKTOP: Kontakt-Teaser (rust) ===== -->
  <section class="hidden md:flex bg-rust py-xl">
    <div class="mx-auto flex max-w-inhalt items-center gap-[5rem]">

      <div class="relative shrink-0" style="width:37.5rem;height:31.25rem">
        <div class="absolute overflow-hidden" style="left:8.75rem;top:0;width:28.75rem;height:20rem">
          <BildPicture id="kontakt-teaser-01" class="absolute inset-0 h-full w-full object-cover" widths={[460, 920]} sizes="28.75rem" />
