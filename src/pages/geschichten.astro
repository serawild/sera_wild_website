---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import BildPicture from '../components/BildPicture.astro';
import DekoIllustration from '../components/DekoIllustration.astro';
import FotoStory from '../components/FotoStory.astro';

const heroSubtitel = 'Authentizität verlangt Mut, doch diesen Schritt braucht es, damit du dein Leben führst.';

const fotostoryH2 = 'Bereit, deinen ganz eigenen Prozess zu entdecken? Diese Reise haben viele schon entdeckt.';
const fotostoryP  = 'Gemeinsam schaffen wir einen Raum, in dem du dich wohlfühlst und einfach du selbst sein darfst.';

const authH2 = 'Du musst nicht jemand anderes sein, um gesehen zu werden.';

const angebotH2 = 'Veränderung beginnt dort, wo du in Kontakt gehst. Mit dir selbst und mit anderen.';
const angebotP  = 'Ich biete dir den Raum. Du probierst aus, folgst deinen Impulsen und entdeckst Schritt für Schritt, was entsteht, wenn du dir selbst Raum gibst.';

const kundenstoryQuote = 'Ich habe mich gesehen, gehalten, ernst genommen und frei gefühlt. Der Prozess war für mich mindestens so wertvoll wie das Ergebnis. Man merkt, dass du nicht nur Bilder machst, sondern Räume öffnest, in denen etwas entstehen darf.';
const kundenstoryName  = 'Simona, Studio Benanti';

const zitatText = 'Was wäre ein Leben, das sich wahr anfühlt – für mich, hier, jetzt?';

const kontaktH2 = 'Für alle, die sich selbst zurückfinden oder etwas Neues wagen möchten.';
const kontaktP1 = 'Du musst noch nicht wissen, wie das aussehen soll. Schreib mir einfach, was dich gerade beschäftigt – oder ruf an, wenn dir das leichter fällt.';
const kontaktP2 = 'Wir telefonieren kurz und unverbindlich. Danach entscheidest du in Ruhe, ohne Anzahlung und ohne Druck.';
---

<Base
  title="Geschichten — sera Wild"
  description="Echte Geschichten von echten Menschen: Wie prozessorientierte Fotografie Verbindung schafft."
>

  <Navigation farbe="hell" />

  <!-- ===== HERO ===== -->

  <!-- Mobile -->
  <section class="relative md:hidden h-[43.75rem] overflow-hidden bg-olive">
    <BildPicture
      id="hero-geschichten"
      class="absolute inset-0 h-full w-full object-cover"
      mobil={true}
      loading="eager"
      fetchpriority="high"
      widths={[390, 780]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-black/35 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-10 left-6 max-w-[21rem]">
      <h1 class="font-display text-[1.9375rem] leading-[1.3] font-semibold text-cream">Geschichten</h1>
      <p class="font-body text-[1.125rem] leading-[1.6] text-cream mt-[0.5rem]">{heroSubtitel}</p>
    </div>
  </section>

  <!-- Desktop -->
  <section class="hidden md:block relative h-[100svh] min-h-[600px] overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <BildPicture
        id="hero-geschichten"
        class="absolute inset-0 h-full w-full object-cover object-[78%_83%] scale-[1.20] origin-[78%_83%]"
        loading="eager"
        fetchpriority="high"
        widths={[768, 1280, 1728, 2560]}
        sizes="100vw"
      />
    </div>
    <div class="absolute inset-0 bg-black/40 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-[10rem] right-[7.5rem] flex max-w-[74.875rem] flex-col items-end text-right">
      <h1 class="font-display text-h1 font-semibold leading-normal text-cream">Geschichten</h1>
      <p class="font-display text-h2 font-semibold leading-normal text-cream">{heroSubtitel}</p>
    </div>
  </section>

  <!-- ===== 01 FOTO-STORY ===== -->

  <!-- Mobile: cream -->
  <section class="relative isolate md:hidden bg-cream py-12">
    <DekoIllustration motiv="tulpe" farbe="#A0886D" breite={186} cssRotate={-27} obenAbAnkerAnteil={0.16} seite="rechts" abstand={-86} mobil={true} deckkraft={0.6} />
    <div class="px-6 flex flex-col gap-[1.125rem]">
      <div class="flex items-center gap-2 mb-[0.375rem]">
        <span class="font-body text-xs font-bold uppercase tracking-[0.08em] text-dark/50">01</span>
        <span class="w-5 h-px bg-dark/50"></span>
        <span class="font-body text-xs uppercase tracking-[0.08em] text-dark/50">FOTO-STORY</span>
      </div>
      <h2 class="font-display text-[1.6875rem] leading-[1.28] font-semibold">{fotostoryH2}</h2>
      <p class="font-body text-[1.0625rem] leading-[1.68]">{fotostoryP}</p>
    </div>
    <!-- Wischleiste 260×340 -->
    <div
      class="mt-[1.25rem] overflow-x-auto"
      id="fotostory-track"
      style="scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;"
    >
      <div class="flex gap-3 px-6" style="width:max-content;">
        {['geschichten-fotostory-01','geschichten-fotostory-02','geschichten-fotostory-03'].map(id => (
          <div class="shrink-0" style="scroll-snap-align:start;width:16.25rem;height:21.25rem;overflow:hidden;position:relative;">
            <BildPicture id={id} class="absolute inset-0 h-full w-full object-cover" mobil={true} widths={[260,520]} sizes="260px" />
          </div>
        ))}
        <div class="shrink-0 w-3" aria-hidden="true"></div>
      </div>
    </div>
    <!-- Dots -->
    <div class="flex justify-center gap-[0.5rem] mt-[1.25rem]">
      {Array.from({length: 3}, (_, i) => (
        <span class={`fotostory-dot h-[0.375rem] w-[0.375rem] rounded-full bg-dark transition-opacity ${i === 0 ? 'opacity-60' : 'opacity-20'}`}></span>
      ))}
    </div>
    <div class="px-6 mt-[1.5rem]">
      <a href="/kontakt" class="inline-flex items-center justify-center rounded-[1.0625rem] bg-beige px-md py-sm font-body text-cta uppercase text-cream">
        KONTAKT
      </a>
    </div>
  </section>

  <!-- Desktop: dark -->
  <section class="hidden md:block relative isolate overflow-visible bg-dark py-xl">
    <DekoIllustration motiv="mohn" farbe="#5B5C4F" breite={276} cssRotate={35} top={51} seite="links" abstand={-176} />
    <div class="mx-auto max-w-inhalt px-[7.5rem] flex flex-col items-center gap-[1.5rem] text-center">
      <h2 class="font-display text-h2 font-semibold text-cream max-w-[62.5rem]">{fotostoryH2}</h2>
      <p class="font-body text-body leading-[1.65] text-cream max-w-[62.5rem]">{fotostoryP}</p>
    </div>
    <div class="mt-[3rem]">
      <FotoStory id1="geschichten-fotostory-01" id2="geschichten-fotostory-02" id3="geschichten-fotostory-03" />
    </div>
    <div class="mx-auto max-w-inhalt px-[7.5rem] mt-[3rem] flex justify-center">
      <a href="/kontakt" class="rounded-[17px] bg-beige px-md py-sm font-body text-small font-medium uppercase tracking-[1.5px] text-cream">
        KONTAKT
      </a>
    </div>
  </section>

  <!-- ===== 02 AUTHENTIZITÄT ===== -->

  <!-- Mobile: dark -->
  <section class="relative isolate md:hidden bg-dark py-[52px] px-6">
    <DekoIllustration motiv="mohn" farbe="#5B5C4F" breite={162} cssRotate={21} obenAbAnkerAnteil={0.16} seite="links" abstand={-75} mobil={true} deckkraft={0.6} />
    <div class="flex flex-col gap-[1.125rem]">
      <div class="flex items-center gap-2 mb-[0.375rem]">
        <span class="font-body text-xs font-bold uppercase tracking-[0.08em] text-cream/50">02</span>
        <span class="w-5 h-px bg-cream/50"></span>
        <span class="font-body text-xs uppercase tracking-[0.08em] text-cream/50">AUTHENTIZITÄT</span>
      </div>
      <h2 class="font-display text-[1.6875rem] leading-[1.28] font-semibold text-cream">{authH2}</h2>
      <p class="font-body text-[1.0625rem] leading-[1.68] text-cream">
        <span>Viele Menschen kommen zu mir und sagen: </span>
        <span class="font-display font-semibold italic text-[1.5rem] leading-[1.6]">Ich bin nicht fotogen. </span>
        <span>Was sie eigentlich meinen: </span>
        <span class="font-display font-semibold italic text-[1.5rem] leading-[1.6]">Ich habe mich noch nie wirklich gesehen. </span>
        <span>Und genau dort beginnen wir.</span>
      </p>
      <a href="/kontakt" class="self-start inline-flex items-center justify-center rounded-[1.0625rem] bg-rust px-md py-sm font-body text-cta text-cream mt-[0.375rem]">
        schreib mir!
      </a>
    </div>
    <!-- Bildgruppe: gross oben links, klein unten rechts -->
    <div class="relative mx-auto mt-[1.5rem]" style="width:342px;height:322px;">
      <div class="absolute overflow-hidden" style="left:0;top:0;width:214px;height:286px;">
        <BildPicture id="authentizitaet-01" class="h-full w-full object-cover" mobil={true} widths={[214,428]} sizes="214px" />
      </div>
      <div class="absolute overflow-hidden" style="left:164px;top:84px;width:178px;height:238px;">
        <BildPicture id="authentizitaet-02" class="h-full w-full object-cover" mobil={true} widths={[178,356]} sizes="178px" />
      </div>
    </div>
  </section>

  <!-- Desktop: cream -->
  <section class="hidden md:block relative isolate overflow-visible z-10 bg-cream py-xl px-[7.5rem]">
    <DekoIllustration motiv="eukalyptus" farbe="#BC541F" breite={320} cssRotate={-16.1} top={669} seite="rechts" abstand={-177} />
    <div class="mx-auto flex max-w-inhalt items-center gap-[5rem]">
      <div class="flex flex-1 min-w-0 flex-col gap-[3rem]">
        <h2 class="font-display text-h2 font-semibold">{authH2}</h2>
        <p class="font-body text-body leading-[1.65]">
          <span>Viele Menschen kommen zu mir und sagen: </span>
          <span class="font-display text-h3 font-semibold italic">Ich bin nicht fotogen. </span>
          <span>Was sie eigentlich meinen: </span>
          <span class="font-display text-h3 font-semibold italic">Ich habe mich noch nie wirklich gesehen. </span>
          <span>Und genau dort beginnen wir.</span>
        </p>
        <a href="/kontakt" class="self-start rounded-[17px] bg-rust px-md py-sm font-body text-small font-medium text-cream">
          schreib mir!
        </a>
      </div>
      <div class="relative h-[46.875rem] w-[37.5rem] shrink-0">
        <div class="absolute h-[30.5625rem] w-[25.375rem]" style="left:12.125rem;top:3rem;">
          <BildPicture id="authentizitaet-01" class="h-full w-full object-cover" />
        </div>
        <div class="absolute h-[26.25rem] w-[20rem]" style="left:0;top:17.0625rem;">
          <BildPicture id="authentizitaet-02" class="h-full w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 03 ANGEBOT ===== -->

  <!-- Mobile: cream -->
  <section class="md:hidden bg-cream py-12 px-6">
    <div class="flex flex-col gap-[1.125rem]">
      <div class="flex items-center gap-2 mb-[0.375rem]">
        <span class="font-body text-xs font-bold uppercase tracking-[0.08em] text-dark/50">03</span>
        <span class="w-5 h-px bg-dark/50"></span>
        <span class="font-body text-xs uppercase tracking-[0.08em] text-dark/50">ANGEBOT</span>
      </div>
      <h2 class="font-display text-[1.6875rem] leading-[1.28] font-semibold">{angebotH2}</h2>
      <p class="font-body text-[1.0625rem] leading-[1.68]">{angebotP}</p>
      <a href="/kontakt" class="self-start inline-flex items-center justify-center rounded-[1.0625rem] bg-beige px-md py-sm font-body text-cta text-cream mt-[0.375rem]">
        Kontaktiere mich
      </a>
    </div>
  </section>

  <!-- Desktop: rust -->
  <section class="hidden md:block relative isolate overflow-visible z-0 bg-rust py-[7rem] px-[12.5rem]">
    <DekoIllustration motiv="blattzweig" farbe="#BC541F" breite={404} cssRotate={29} top={443} seite="links" abstand={-360} />
    <div class="mx-auto flex max-w-inhalt flex-col items-center gap-[3rem] text-center">
      <h2 class="font-display text-h2 font-semibold max-w-[56.25rem] text-cream">{angebotH2}</h2>
      <p class="font-body text-body leading-[1.65] max-w-[56.25rem] text-cream">{angebotP}</p>
      <a href="/kontakt" class="rounded-[17px] bg-beige px-md py-sm font-body text-small font-medium text-cream">
        Kontaktiere mich
      </a>
    </div>
  </section>

  <!-- ===== 04 KUNDENSTORY ===== -->

  <!-- Mobile: olive -->
  <section class="relative isolate md:hidden bg-olive py-[52px]">
    <DekoIllustration motiv="eukalyptus" farbe="#5B5C4F" breite={140} cssRotate={-33} obenAbAnkerAnteil={0.16} seite="rechts" abstand={-64} mobil={true} deckkraft={0.6} />
    <div class="px-6 flex flex-col gap-[1.125rem]">
      <div class="flex items-center gap-2 mb-[0.375rem]">
        <span class="font-body text-xs font-bold uppercase tracking-[0.08em] text-cream/50">04</span>
        <span class="w-5 h-px bg-cream/50"></span>
        <span class="font-body text-xs uppercase tracking-[0.08em] text-cream/50">KUNDENSTORY</span>
      </div>
    </div>
    <!-- Wischleiste 260×340 -->
    <div
      class="mt-[1.25rem] overflow-x-auto"
      id="kundenstory-track"
      style="scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;"
    >
      <div class="flex gap-3 px-6" style="width:max-content;">
        {['kundenstory-01','kundenstory-02'].map(id => (
          <div class="shrink-0" style="scroll-snap-align:start;width:16.25rem;height:21.25rem;overflow:hidden;position:relative;">
            <BildPicture id={id} class="absolute inset-0 h-full w-full object-cover" mobil={true} widths={[260,520]} sizes="260px" />
          </div>
        ))}
        <div class="shrink-0 w-3" aria-hidden="true"></div>
      </div>
    </div>
    <!-- Dots -->
    <div class="flex justify-center gap-[0.5rem] mt-[1.25rem]">
      {Array.from({length: 2}, (_, i) => (
        <span class={`kundenstory-dot h-[0.375rem] w-[0.375rem] rounded-full bg-cream transition-opacity ${i === 0 ? 'opacity-100' : 'opacity-30'}`}></span>
      ))}
    </div>
    <div class="px-6 mt-[1.5rem] flex flex-col gap-[1.125rem]">
      <p class="font-display text-[1.375rem] font-semibold italic leading-[1.4] text-cream">
        &laquo;{kundenstoryQuote}&raquo;
      </p>
      <p class="font-body text-[1rem] leading-[1.65] text-cream/70">{kundenstoryName}</p>
    </div>
  </section>

  <!-- Desktop: cream -->
  <section class="hidden md:block relative isolate overflow-visible z-10 bg-cream py-xl px-[7.5rem]">
    <DekoIllustration motiv="tulpe" farbe="#5B5C4F" breite={245} cssRotate={-26.6} top={1070} seite="rechts" abstand={-162} />
    <div class="mx-auto max-w-inhalt">
      <div class="relative h-[68.75rem] w-full">
        <div class="absolute h-[48.125rem] w-[36.25rem]" style="left:0;top:6.25rem;">
          <BildPicture id="kundenstory-01" class="h-full w-full object-cover" />
        </div>
        <div class="absolute h-[25.8125rem] w-[38.75rem]" style="left:30rem;top:31.25rem;">
          <BildPicture id="kundenstory-02" class="h-full w-full object-cover" />
        </div>
        <div class="absolute flex w-[43.75rem] items-center justify-center bg-dark p-[3rem]" style="left:43.75rem;top:12.5rem;">
          <p class="font-display text-body-klein italic leading-[1.45] text-cream text-center">{kundenstoryQuote}</p>
        </div>
        <div class="absolute flex w-[20rem] items-center justify-center bg-beige p-[2.25rem]" style="left:65.625rem;top:43.75rem;">
          <p class="font-body text-small leading-[2] text-cream text-center">{kundenstoryName}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ZITAT ===== -->

  <!-- Mobile: rust -->
  <section class="relative isolate md:hidden bg-rust py-12 px-6">
    <DekoIllustration motiv="blattzweig" farbe="#BC541F" breite={122} cssRotate={15} obenAbAnkerAnteil={0.42} seite="links" abstand={-56} mobil={true} deckkraft={0.6} />
    <p class="text-center font-display text-[1.6875rem] leading-[1.28] font-semibold text-cream">{zitatText}</p>
  </section>

  <!-- Desktop: dark -->
  <section class="hidden md:block relative z-0 bg-dark py-xl px-[7.5rem]">
    <div class="mx-auto max-w-inhalt text-center">
      <h2 class="font-display text-h2 font-semibold leading-normal text-cream">{zitatText}</h2>
    </div>
  </section>

  <!-- ===== 05 KONTAKT ===== -->

  <!-- Mobile: dark -->
  <section class="md:hidden bg-dark py-[52px] px-6">
    <div class="flex flex-col gap-[1.125rem]">
      <div class="flex items-center gap-2 mb-[0.375rem]">
        <span class="font-body text-xs font-bold uppercase tracking-[0.08em] text-cream/50">05</span>
        <span class="w-5 h-px bg-cream/50"></span>
        <span class="font-body text-xs uppercase tracking-[0.08em] text-cream/50">KONTAKT</span>
      </div>
    </div>
    <!-- Bildgruppe gespiegelt: gross oben rechts, klein unten links -->
    <div class="relative mx-auto mt-[1.25rem]" style="width:342px;height:322px;">
      <div class="absolute overflow-hidden" style="left:128px;top:0;width:214px;height:286px;">
        <BildPicture id="kontakt-teaser-01" class="h-full w-full object-cover" mobil={true} widths={[214,428]} sizes="214px" />
      </div>
      <div class="absolute overflow-hidden" style="left:0;top:84px;width:178px;height:238px;">
        <BildPicture id="kontakt-teaser-02" class="h-full w-full object-cover" mobil={true} widths={[178,356]} sizes="178px" />
      </div>
    </div>
    <div class="mt-[1.5rem] flex flex-col gap-[1.125rem]">
      <h2 class="font-display text-[1.6875rem] leading-[1.28] font-semibold text-cream">{kontaktH2}</h2>
      <p class="font-body text-[1.0625rem] leading-[1.68] text-cream/90">{kontaktP1}</p>
      <p class="font-body text-[1.0625rem] leading-[1.68] text-cream/90">{kontaktP2}</p>
      <a href="/kontakt" class="self-start inline-flex items-center justify-center rounded-[1.0625rem] bg-beige px-md py-sm font-body text-cta uppercase text-cream">
        KONTAKT
      </a>
    </div>
  </section>

  <!-- Desktop: rust -->
  <section class="hidden md:block bg-rust py-xl px-[7.5rem]">
    <div class="mx-auto flex max-w-inhalt items-center gap-[5rem]">
      <div class="relative h-[31.25rem] w-[37.5rem] shrink-0">
        <div class="absolute h-[20rem] w-[28.75rem]" style="left:8.75rem;top:0;">
          <BildPicture id="kontakt-teaser-01" class="h-full w-full object-cover" />
        </div>
        <div class="absolute h-[14.9375rem] w-[22.375rem]" style="left:0;top:15.0625rem;">
          <BildPicture id="kontakt-teaser-02" class="h-full w-full object-cover" />
        </div>
      </div>
      <div class="flex flex-1 min-w-0 flex-col gap-[2rem]">
        <h2 class="font-display text-h2 font-semibold text-cream">{kontaktH2}</h2>
        <div class="flex flex-col">
          <p class="font-body text-small leading-[2] text-cream/92">{kontaktP1}</p>
          <p class="font-body text-small leading-[2] text-cream/92 mt-[2em]">{kontaktP2}</p>
        </div>
        <a href="/kontakt" class="self-start rounded-[17px] bg-beige px-md py-sm font-body text-small font-medium uppercase tracking-[1.5px] text-cream">
          KONTAKT
        </a>
      </div>
    </div>
  </section>

  <Footer />

</Base>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const cardWidth = 260 + 12;

  const fotostoryTrack = document.getElementById('fotostory-track');
  const fotostoryDots = document.querySelectorAll('.fotostory-dot');
  if (fotostoryTrack && fotostoryDots.length) {
    fotostoryTrack.addEventListener('scroll', () => {
      const idx = Math.min(Math.round(fotostoryTrack.scrollLeft / cardWidth), fotostoryDots.length - 1);
      fotostoryDots.forEach((d, i) => {
        d.classList.toggle('opacity-60', i === idx);
        d.classList.toggle('opacity-20', i !== idx);
      });
    });
  }

  const kundenstoryTrack = document.getElementById('kundenstory-track');
  const kundenstoryDots = document.querySelectorAll('.kundenstory-dot');
  if (kundenstoryTrack && kundenstoryDots.length) {
    kundenstoryTrack.addEventListener('scroll', () => {
      const idx = Math.min(Math.round(kundenstoryTrack.scrollLeft / cardWidth), kundenstoryDots.length - 1);
      kundenstoryDots.forEach((d, i) => {
        d.classList.toggle('opacity-100', i === idx);
        d.classList.toggle('opacity-30', i !== idx);
      });
    });
  }
});
</script>
