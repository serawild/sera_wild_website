---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import BildPicture from '../components/BildPicture.astro';
import DekoIllustration from '../components/DekoIllustration.astro';
import FotoStory from '../components/FotoStory.astro';

const heroSubtitel = 'Authentizität verlangt Mut, doch diesen Schritt braucht es, damit du dein Leben führst.';

const fotostoryH2 = 'Bereit, deinen ganz eigenen Prozess zu entdecken? Diese Reise haben viele schon entdeckt.';
const fotostoryP  = 'Gemeinsam schaffen wir einen Raum, in dem du dich wohlfühlst und einfach du selbst sein darfst.';

const kundenstoryQuote = 'Ich habe mich gesehen, gehalten, ernst genommen und frei gefühlt. Der Prozess war für mich mindestens so wertvoll wie das Ergebnis. Man merkt, dass du nicht nur Bilder machst, sondern Räume öffnest, in denen etwas entstehen darf.';
const kundenstoryName  = 'Simona';
const kundenstoryStudio = 'Studio Benanti';
const kundenstoryStudioUrl = 'https://www.instagram.com/studiobenanti/';

const zitatText = 'Was wäre ein Leben, das sich wahr anfühlt – für mich, hier, jetzt?';

/**
 * Die drei Geschichten als Karten: Bild, Name, ein Satz.
 *
 * Der Satz ist jeweils aus dem Einstieg der eigenen Geschichte abgeleitet, nicht neu
 * erfunden — siehe `geschichteObenP1` auf den drei Unterseiten. Bild ist immer das
 * Porträt `*-geschichte-oben` (alle 0.76 : 1), zugeschnitten auf 3 : 4.
 */
const geschichten = [
  {
    pfad: '/geschichten/tina',
    name: 'Tina',
    bild: 'tina-geschichte-oben',
    satz: 'Sie begegnet dem Wandel des Lebens mit Mut und ihrem inneren Kompass.',
  },
  {
    pfad: '/geschichten/sara',
    name: 'Sara',
    bild: 'sara-geschichte-oben',
    satz: 'Ihr Geschäft wächst. Sie wollte Bilder, die nach ihr aussehen statt nach Katalog.',
  },
  {
    pfad: '/geschichten/simona',
    name: 'Simona',
    bild: 'simona-geschichte-oben',
    satz: 'Sie baut ihr eigenes Business auf — und wollte sich zeigen, wie sie wirklich ist.',
  },
];

---

<Base
  title="Geschichten — sera Wild"
  description="Echte Geschichten von echten Menschen: Wie prozessorientierte Porträt- und Reportagefotografie Verbindung schafft."
>

  <Navigation farbe="hell" />

  <!-- ===== HERO ===== -->

  <!-- Mobile -->
  <section class="relative md:hidden h-[43.75rem] overflow-hidden bg-olive">
    <BildPicture
      id="hero-geschichten"
      class="absolute inset-0 h-full w-full object-cover"
      mobil={true}
      loading="eager"
      fetchpriority="high"
      widths={[390, 780]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-black/35 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-10 left-6 max-w-[21rem]">
      <h1 class="font-display text-[1.9375rem] leading-[1.3] font-semibold text-cream">Geschichten</h1>
      <p class="font-body text-[1.125rem] leading-[1.6] text-cream mt-[0.5rem]">{heroSubtitel}</p>
    </div>
  </section>

  <!-- Desktop -->
  <section class="hidden md:block relative h-[100svh] min-h-[600px] overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <BildPicture
        id="hero-geschichten"
        class="absolute inset-0 h-full w-full object-cover object-[78%_83%] scale-[1.20] origin-[78%_83%]"
        loading="eager"
        fetchpriority="high"
        widths={[768, 1280, 1728, 2560]}
        sizes="100vw"
      />
    </div>
    <div class="absolute inset-0 bg-black/40 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-[10rem] right-[7.5rem] flex max-w-[74.875rem] flex-col items-end text-right">
      <h1 class="font-display text-h1 font-semibold leading-normal text-cream">Geschichten</h1>
      <p class="font-display text-h2 font-semibold leading-normal text-cream">{heroSubtitel}</p>
    </div>
  </section>

  <!-- ===== 01 FOTO-STORY ===== -->

  <!-- Mobile: cream -->
  <section class="relative isolate overflow-visible md:hidden bg-cream py-12">
    <DekoIllustration motiv="tulpe" farbe="#A0886D" breite={186} cssRotate={-27} obenAbAnkerAnteil={0.05} seite="rechts" abstand={-86} mobil={true} deckkraft={0.5} />
    <div class="px-6 flex flex-col gap-[1.125rem]">
      <div class="flex items-center gap-2 mb-[0.375rem]">
        <span class="font-body text-xs font-bold uppercase tracking-[0.08em] text-dark/50">01</span>
        <span class="w-5 h-px bg-dark/50"></span>
        <span class="font-body text-xs uppercase tracking-[0.08em] text-dark/50">FOTO-STORY</span>
      </div>
      <h2 class="font-display text-[1.6875rem] leading-[1.28] font-semibold">{fotostoryH2}</h2>
      <p class="font-body text-[1.0625rem] leading-[1.68]">{fotostoryP}</p>
    </div>
    <!-- Wischleiste 260×340 -->
    <div
      class="mt-[1.25rem] overflow-x-auto"
      id="fotostory-track"
      style="scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;"
    >
      <div class="flex gap-3 px-6" style="width:max-content;">
        {['geschichten-fotostory-01','geschichten-fotostory-02','geschichten-fotostory-03'].map(id => (
          <div class="shrink-0" style="scroll-snap-align:start;width:16.25rem;height:21.25rem;overflow:hidden;position:relative;">
            <BildPicture id={id} class="absolute inset-0 h-full w-full object-cover" mobil={true} widths={[260,520]} sizes="260px" />
          </div>
        ))}
        <div class="shrink-0 w-3" aria-hidden="true"></div>
      </div>
    </div>
    <!-- Dots -->
    <div class="flex justify-center gap-[0.5rem] mt-[1.25rem]">
      {Array.from({length: 3}, (_, i) => (
        <span class={`fotostory-dot h-[0.375rem] w-[0.375rem] rounded-full bg-dark transition-opacity ${i === 0 ? 'opacity-60' : 'opacity-20'}`}></span>
      ))}
    </div>
    <div class="px-6 mt-[1.5rem]">
      <a href="/kontakt" class="inline-flex items-center justify-center rounded-[1.0625rem] bg-beige px-md py-sm font-body text-cta uppercase text-cream">
        KONTAKT
      </a>
    </div>
  </section>

  <!-- Desktop: dark -->
  <section class="hidden md:block relative isolate overflow-visible bg-dark py-xl">
    <DekoIllustration motiv="mohn" farbe="#5B5C4F" breite={276} cssRotate={35} top={51} seite="links" abstand={-176} />
    <div class="mx-auto max-w-inhalt px-[7.5rem] flex flex-col items-center gap-[1.5rem] text-center">
      <h2 class="font-display text-h2 font-semibold text-cream max-w-[62.5rem]">{fotostoryH2}</h2>
      <p class="font-body text-body leading-[1.65] text-cream max-w-[62.5rem]">{fotostoryP}</p>
    </div>
    <div class="mt-[3rem]">
      <FotoStory id1="geschichten-fotostory-01" id2="geschichten-fotostory-02" id3="geschichten-fotostory-03" />
    </div>
    <div class="mx-auto max-w-inhalt px-[7.5rem] mt-[3rem] flex justify-center">
      <a href="/kontakt" class="rounded-[17px] bg-beige px-md py-sm font-body text-small font-medium uppercase tracking-[1.5px] text-cream">
        KONTAKT
      </a>
    </div>
  </section>

  <!-- ===== 02 DIE GESCHICHTEN ===== -->
  <section class="bg-cream-warm px-6 py-12 md:px-[7.5rem] md:py-xl">
    <div class="mx-auto max-w-inhalt flex flex-col gap-[1.75rem] md:gap-[3rem]">
      <div class="flex flex-col items-center gap-[1.125rem] text-center">
        <div class="flex items-center gap-2">
          <span class="font-body text-xs font-bold uppercase tracking-[0.08em] text-dark/50">02</span>
          <span class="w-5 h-px bg-dark/50"></span>
          <span class="font-body text-xs uppercase tracking-[0.08em] text-dark/50">DIE GESCHICHTEN</span>
        </div>
        <h2 class="font-display text-[1.6875rem] md:text-h2 font-semibold leading-[1.28] md:leading-normal">
          Drei Frauen, drei Geschichten
        </h2>
      </div>

      <div class="flex flex-col gap-[2.5rem] md:flex-row md:gap-[2.5rem]">
        {geschichten.map(g => (
          <a href={g.pfad} class="group flex flex-1 flex-col gap-[1rem] min-w-0">
            <div class="w-full overflow-hidden rounded-[0.25rem]" style="aspect-ratio:3/4;">
              <BildPicture
                id={g.bild}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                mobil={true}
                widths={[390, 780]}
                sizes="(max-width: 767px) 100vw, 29rem"
              />
            </div>
            <h3 class="font-display text-[1.375rem] md:text-h4 font-semibold leading-[1.3]">{g.name}</h3>
            <p class="font-body text-[1.0625rem] md:text-body-klein leading-[1.7] text-dark/85">{g.satz}</p>
            <span class="font-body text-label uppercase tracking-[0.08em] text-rust transition-colors group-hover:text-orange">
              Geschichte lesen
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== 03 KUNDENSTORY ===== -->

  <!-- Mobile: olive -->
  <section class="relative isolate overflow-visible md:hidden bg-olive py-[52px]">
    <DekoIllustration motiv="eukalyptus" farbe="#5B5C4F" breite={140} cssRotate={-33} obenAbAnkerAnteil={-0.08} seite="rechts" abstand={-64} mobil={true} deckkraft={0.5} />
    <div class="px-6 flex flex-col gap-[1.125rem]">
      <div class="flex items-center gap-2 mb-[0.375rem]">
        <span class="font-body text-xs font-bold uppercase tracking-[0.08em] text-cream/50">03</span>
        <span class="w-5 h-px bg-cream/50"></span>
        <span class="font-body text-xs uppercase tracking-[0.08em] text-cream/50">KUNDENSTORY</span>
      </div>
    </div>
    <!-- Wischleiste 260×340 -->
    <div
      class="mt-[1.25rem] overflow-x-auto"
      id="kundenstory-track"
      style="scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;"
    >
      <div class="flex gap-3 px-6" style="width:max-content;">
        {['kundenstory-01','kundenstory-02'].map(id => (
          <div class="shrink-0" style="scroll-snap-align:start;width:16.25rem;height:21.25rem;overflow:hidden;position:relative;">
            <BildPicture id={id} class="absolute inset-0 h-full w-full object-cover" mobil={true} widths={[260,520]} sizes="260px" />
          </div>
        ))}
        <div class="shrink-0 w-3" aria-hidden="true"></div>
      </div>
    </div>
    <!-- Dots -->
    <div class="flex justify-center gap-[0.5rem] mt-[1.25rem]">
      {Array.from({length: 2}, (_, i) => (
        <span class={`kundenstory-dot h-[0.375rem] w-[0.375rem] rounded-full bg-cream transition-opacity ${i === 0 ? 'opacity-100' : 'opacity-30'}`}></span>
      ))}
    </div>
    <div class="px-6 mt-[1.5rem] flex flex-col gap-[1.125rem]">
      <p class="font-display text-[1.375rem] font-semibold italic leading-[1.4] text-cream">
        &laquo;{kundenstoryQuote}&raquo;
      </p>
      <p class="font-body text-[1rem] leading-[1.65] text-cream/70">{kundenstoryName}, <a
            href={kundenstoryStudioUrl}
            target="_blank"
            rel="noopener"
            class="underline underline-offset-4 decoration-1 transition-colors hover:text-orange"
          >{kundenstoryStudio}</a></p>
    </div>
  </section>

  <!-- Desktop: cream -->
  <section class="hidden md:block relative isolate overflow-visible bg-cream py-xl px-[7.5rem]">
    <DekoIllustration motiv="tulpe" farbe="#5B5C4F" breite={245} cssRotate={-26.6} top={-80} seite="rechts" abstand={-162} />
    <div class="mx-auto max-w-inhalt">
      <div class="relative h-[57.0625rem] w-full">
        <div class="absolute h-[48.125rem] w-[36.25rem]" style="left:0;top:6.25rem;">
          <BildPicture id="kundenstory-01" class="h-full w-full object-cover" />
        </div>
        <div class="absolute h-[25.8125rem] w-[38.75rem]" style="left:30rem;top:31.25rem;">
          <BildPicture id="kundenstory-02" class="h-full w-full object-cover" />
        </div>
        <div class="absolute flex w-[43.75rem] items-center justify-center bg-dark p-[3rem]" style="left:43.75rem;top:12.5rem;">
          <p class="font-display text-body-klein italic leading-[1.45] text-cream text-center">{kundenstoryQuote}</p>
        </div>
        <div class="absolute flex w-[20rem] items-center justify-center bg-beige p-[2.25rem]" style="left:65.625rem;top:43.75rem;">
          <p class="font-body text-small leading-[2] text-cream text-center">{kundenstoryName}, <a
            href={kundenstoryStudioUrl}
            target="_blank"
            rel="noopener"
            class="underline underline-offset-4 decoration-1 transition-colors hover:text-orange"
          >{kundenstoryStudio}</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ZITAT ===== -->

  <!-- Mobile: rust -->
  <section class="relative isolate overflow-visible md:hidden bg-rust py-12 px-6">
    <DekoIllustration motiv="blattzweig" farbe="#BC541F" breite={122} cssRotate={15} obenAbAnkerAnteil={-0.08} seite="links" abstand={-56} mobil={true} deckkraft={0.5} />
    <p class="text-center font-display text-[1.6875rem] leading-[1.28] font-semibold text-cream">{zitatText}</p>
  </section>

  <!-- Desktop: dark -->
  <section class="hidden md:block relative bg-dark py-xl px-[7.5rem]">
    <div class="mx-auto max-w-inhalt text-center">
      <h2 class="font-display text-h2 font-semibold leading-normal text-cream">{zitatText}</h2>
    </div>
  </section>

  <Footer />

</Base>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const cardWidth = 260 + 12;

  const fotostoryTrack = document.getElementById('fotostory-track');
  const fotostoryDots = document.querySelectorAll('.fotostory-dot');
  if (fotostoryTrack && fotostoryDots.length) {
    fotostoryTrack.addEventListener('scroll', () => {
      const idx = Math.min(Math.round(fotostoryTrack.scrollLeft / cardWidth), fotostoryDots.length - 1);
      fotostoryDots.forEach((d, i) => {
        d.classList.toggle('opacity-60', i === idx);
        d.classList.toggle('opacity-20', i !== idx);
      });
    });
  }

  const kundenstoryTrack = document.getElementById('kundenstory-track');
  const kundenstoryDots = document.querySelectorAll('.kundenstory-dot');
  if (kundenstoryTrack && kundenstoryDots.length) {
    kundenstoryTrack.addEventListener('scroll', () => {
      const idx = Math.min(Math.round(kundenstoryTrack.scrollLeft / cardWidth), kundenstoryDots.length - 1);
      kundenstoryDots.forEach((d, i) => {
        d.classList.toggle('opacity-100', i === idx);
        d.classList.toggle('opacity-30', i !== idx);
      });
    });
  }
});
</script>
