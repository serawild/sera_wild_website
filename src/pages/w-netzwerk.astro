---
/**
 * Netzwerk — Figma-Rahmen 10_Netzwerk (2289:770), Seite „Desktop | Designs".
 * Aufbau vollständig aus spec/seiten/netzwerk.json.
 *
 * Online seit 06.10.2026 (Freigabe Seraina): in der Navigation unter «sera Wild»,
 * in der Sitemap, ohne noindex. Fünf Partner, Texte und Fotos vollständig.
 */
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import BildPicture from '../components/BildPicture.astro';
import DekoIllustration from '../components/DekoIllustration.astro';
import NetzwerkEintrag from '../components/blocks/NetzwerkEintrag.astro';
import Wortmarke from '../components/Wortmarke.astro';
import spec from '../../spec/seiten/netzwerk.json';
import bilderSpec from '../../spec/bilder.json';

const partner   = spec.abschnitte.find((a) => a.id === 'partner')!;
const intro     = spec.abschnitte.find((a) => a.id === 'intro')!;
const einladung = spec.abschnitte.find((a) => a.id === 'einladung')!;

// Blindtexte aus Figma. Wörtlich übernommen, bis die echten Texte da sind.
const blind = partner.blindtexte;

/**
 * Illustrationen aus spec/seiten/netzwerk.json → deko.
 * In Figma stehen sie mit absoluter y-Position im 6593 px hohen Rahmen. Hier hängen
 * sie am Abschnitt DARUNTER mit negativem `top` und ragen nach oben hinein — das ist
 * das Muster, das im Projekt überall verwendet wird (siehe ueber.astro, geschichten.astro).
 * Sonst würde der spätere Abschnitt sie überdecken.
 *
 * `breite` ist die Breite VOR der Drehung (so erwartet es DekoIllustration und so steht
 * es in deko.json). Figma liefert über die API den GEDREHTEN Begrenzungsrahmen. Umrechnung:
 *   breite = BBoxBreite / (cos θ + a · sin θ),  a = SVG-Höhe / SVG-Breite
 * Mohn 409 → 248, Tulpe 466 → 252, Eukalyptus 350 → 211, Blattzweig 306 → 170.
 */
const DEKO_JE_EINTRAG: Record<string, any> = {
  /*
   * Mohn am ERSTEN Eintrag, im rechten Seitenrand neben dem Partnernamen
   * (Entscheid Seraina, 06.10.2026). Davor stand er in der Luecke zwischen Bild und
   * Text und wirkte dort wie ein Versehen.
   *
   * `top` und `abstand` zaehlen ab der Inhaltsspalte (Rahmen in NetzwerkEintrag.astro),
   * nicht ab der Fensterkante — sonst wandert die Blume auf breiten Monitoren weg.
   *
   *   breite 145  → Begrenzungsrahmen 239 x 273
   *   abstand -239 → die linke Kante liegt genau auf der rechten Spaltenkante,
   *                  die Blume steht also vollstaendig im Seitenrand und beruehrt
   *                  keinen Buchstaben. Sichtbar ist, was der Rand hergibt: bei
   *                  1728 px die Haelfte, auf breiten Schirmen mehr.
   *   top 10      → auf Hoehe von Logo und Name
   */
  'netzwerk-studio-benanti': {
    motiv: 'mohn', farbe: '#5B5C4F', breite: 145, cssRotate: 29, top: 10, seite: 'rechts', abstand: -239,
  },
};

/**
 * Partnerfotos sind in bilder.json vorbereitet, die Dateien fehlen aber noch.
 * Statt einer beigen Platzhalterflaeche wird `foto` nur durchgereicht, wenn die
 * Datei wirklich im Ordner liegt — sonst greift das Logo-Layout in NetzwerkEintrag.
 * Sobald eine Datei abgelegt wird, erscheint das Foto von selbst. Nichts umzustellen.
 */
const vorhandeneBilder = new Set(
  Object.keys({
    ...import.meta.glob('/src/assets/images/**/*.jpg'),
    ...import.meta.glob('/src/assets/images/**/*.avif'),
  }).map((k) => k.replace(/^\//, '').replace(/\.(jpg|avif)$/, ''))
);

const fotoDatei = (id: string): string | null => {
  const eintrag = (bilderSpec.bilder as any[]).find((b) => b.id === id);
  if (!eintrag?.datei) return null;
  return vorhandeneBilder.has(String(eintrag.datei).replace(/\.(jpg|avif)$/, '')) ? id : null;
};

// Nur Partner mit aktiv !== false. Fotostudio Fokus ist vorerst zurueckgestellt.
const eintraege = partner.eintraege
  .filter((e: any) => e.aktiv !== false)
  .map((e: any, i: number) => ({
    ...e,
    nummer: String(i + 1).padStart(2, '0'),
    beschrieb: e.beschrieb ?? blind.beschrieb,
    geschichte: e.geschichte ?? blind.geschichte,
    foto: e.foto ? fotoDatei(e.foto) : null,
    deko: DEKO_JE_EINTRAG[e.id] ?? null,
  }));

// Der Einladungs-Abschnitt steht in der Mitte der Liste.
const einladungNach = (partner as any).einladungNachEintrag ?? Math.ceil(eintraege.length / 2);
const vorEinladung  = eintraege.slice(0, einladungNach);
const nachEinladung = eintraege.slice(einladungNach);

/**
 * Die Intro-Ueberschrift «Menschen, mit denen ich gerne arbeite» ist auf Serainas
 * Wunsch (07.10.2026) in den Hero gewandert — Figma `2293:862` hat dort nur die
 * Titelzeile. Im Intro-Abschnitt entfaellt sie dafuer, sonst stuende sie zweimal
 * auf derselben Seite. Der Absatz traegt den Abschnitt allein, als Lauftext.
 */
const heroUnterzeile = intro.text.h2 + '.';
const introP = intro.text.absaetze[0].text;

const einladungH2  = einladung.text.h2;
const einladungP   = einladung.text.absaetze[0].text;
const einladungCta = einladung.cta;

const kontakt   = spec.abschnitte.find((a) => a.id === 'kontakt-teaser')!;
const kontaktP1 = kontakt.text.absaetze[0].text;
const kontaktP2 = kontakt.text.absaetze[1].text;

---

<Base
  title="Netzwerk — sera Wild"
  description="Menschen, mit denen Seraina Wild gerne arbeitet — und die Geschichten hinter den Begegnungen."
>

  <Navigation farbe="hell" />

  <!-- ===== HERO ===== -->

  <!-- Mobile -->
  <section class="relative md:hidden h-[43.75rem] overflow-hidden bg-olive">
    <BildPicture
      id="hero-netzwerk"
      class="absolute inset-0 h-full w-full object-cover"
      mobil={true}
      loading="eager"
      fetchpriority="high"
      widths={[390, 780]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-black/35 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-10 left-6 max-w-[21rem]">
      <h1 aria-label="W-Netzwerk">
        <Wortmarke wort="Netzwerk" breite={16.3125} klasse="text-cream" />
      </h1>
      <p class="font-body text-[1.125rem] leading-[1.6] text-cream mt-[1.125rem]">{heroUnterzeile}</p>
    </div>
  </section>

  <!-- Desktop -->
  <section class="hidden md:block relative h-[100svh] min-h-[600px] overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <BildPicture
        id="hero-netzwerk"
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
        widths={[768, 1280, 1728, 2560]}
        sizes="100vw"
      />
    </div>
    <div class="absolute inset-0 bg-black/40 pointer-events-none" aria-hidden="true"></div>

    <div class="absolute bottom-[10rem] right-[7.5rem] flex max-w-[96.75rem] flex-col items-end text-right">
      <h1 class="mb-[0.75rem]" aria-label="W-Netzwerk">
        <Wortmarke wort="Netzwerk" breite={30} klasse="text-cream" />
      </h1>
      <p class="font-display text-h2 font-semibold leading-normal text-cream">{heroUnterzeile}</p>
    </div>
  </section>

  <div class="relative isolate">

  <!-- ===== 01 INTRO ===== -->

  <!-- Mobile -->
  <section class="relative isolate overflow-hidden md:hidden bg-cream py-12 px-6">
    <div class="flex flex-col gap-[1.125rem]">
      <p class="font-body text-[1.0625rem] leading-[1.68] text-olive">{introP}</p>
    </div>
  </section>

  <!-- Desktop -->
  <section class="relative isolate hidden overflow-hidden md:block bg-cream pt-[6.25rem] pb-[3.75rem]">
    <div class="mx-auto max-w-inhalt px-6 md:px-0">
      <p class="max-w-[68.75rem] font-body text-[1.5rem] leading-[2] text-olive">{introP}</p>
    </div>
  </section>

  <!-- ===== 02 PARTNER 1–3 ===== -->
  {vorEinladung.map((e) => (
    <NetzwerkEintrag
      nummer={e.nummer}
      name={e.name}
      logo={e.logo}
      beschrieb={e.beschrieb}
      geschichte={e.geschichte}
      link={e.link}
      linkZiel={e.linkZiel}
      bildSeite={e.bildSeite as 'links' | 'rechts'}
      foto={e.foto}
      deko={e.deko}
      label={e.label ?? null}
    />
  ))}

  <!-- ===== 03 EINLADUNG ===== -->

  <!-- Mobile -->
  <section class="md:hidden bg-dark py-[52px] px-6">
    <div class="flex flex-col items-center gap-[1.125rem] text-center">
      <h2 class="font-display text-[1.6875rem] leading-[1.28] font-semibold text-cream">{einladungH2}</h2>
      <p class="font-body text-[1.0625rem] leading-[1.68] text-beige">{einladungP}</p>
      <a
        href={einladungCta.ziel}
        class="mt-[0.375rem] inline-flex items-center justify-center rounded-[1.0625rem] bg-rust px-md py-sm font-body text-cta uppercase text-cream"
      >{einladungCta.text}</a>
    </div>
  </section>

  <!-- Desktop -->
  <section class="relative isolate hidden overflow-visible md:block bg-dark py-[6.875rem]">
    <DekoIllustration motiv="tulpe" farbe="#5B5C4F" breite={252} cssRotate={-30} top={-183} seite="rechts" abstand={-180} />
    <div class="mx-auto flex max-w-inhalt flex-col items-center gap-8 px-[7.5rem] text-center">
      <h2 class="font-display text-[3.5rem] leading-[1.39] font-semibold text-cream">{einladungH2}</h2>
      <p class="max-w-[78rem] font-body text-body leading-[1.68] text-beige">{einladungP}</p>
      <a
        href={einladungCta.ziel}
        class="inline-flex items-center justify-center rounded-[1.0625rem] bg-rust px-md py-sm font-body text-cta uppercase text-cream transition-colors hover:bg-orange"
      >{einladungCta.text}</a>
    </div>
  </section>

  <!-- ===== 04 PARTNER 4–5 ===== -->
  {nachEinladung.map((e, i) => (
    <NetzwerkEintrag
      nummer={e.nummer}
      name={e.name}
      logo={e.logo}
      beschrieb={e.beschrieb}
      geschichte={e.geschichte}
      link={e.link}
      linkZiel={e.linkZiel}
      bildSeite={e.bildSeite as 'links' | 'rechts'}
      foto={e.foto}
      deko={e.deko}
      label={e.label ?? null}
    />
  ))}

  <!-- ===== 05 KONTAKT-TEASER ===== -->

  <!-- Mobile -->
  <section class="md:hidden bg-dark py-[52px] px-6">
    <div class="flex items-center gap-2 mb-[0.375rem]">
      <span class="font-body text-xs font-bold uppercase tracking-[0.08em] text-cream/50">05</span>
      <span class="w-5 h-px bg-cream/50"></span>
      <span class="font-body text-xs uppercase tracking-[0.08em] text-cream/50">Kontakt</span>
    </div>
    <div class="relative mx-auto mt-[1.25rem]" style="width:342px;height:322px;">
      <div class="absolute overflow-hidden" style="left:0;top:0;width:214px;height:286px;">
        <BildPicture id="kontakt-teaser-01" class="h-full w-full object-cover" mobil={true} widths={[214,428]} sizes="214px" />
      </div>
      <div class="absolute overflow-hidden" style="left:164px;top:84px;width:178px;height:238px;">
        <BildPicture id="kontakt-teaser-02" class="h-full w-full object-cover" mobil={true} widths={[178,356]} sizes="178px" />
      </div>
    </div>
    <div class="mt-[1.5rem] flex flex-col gap-[1.125rem]">
      <h2 class="font-display text-[1.6875rem] leading-[1.28] font-semibold text-cream">Für alle, die zu sich zurückfinden möchten.</h2>
      <p class="font-body text-[1.0625rem] leading-[1.68] text-cream/[0.92]">{kontaktP1}</p>
      <p class="font-body text-[1.0625rem] leading-[1.68] text-cream/[0.92]">{kontaktP2}</p>
      <a href="/kontakt" class="self-start inline-flex items-center justify-center rounded-[1.0625rem] bg-beige px-md py-sm font-body text-cta uppercase text-cream">
        Kontakt
      </a>
    </div>
  </section>

  <!-- Desktop -->
  <section class="relative isolate hidden overflow-visible md:block bg-rust py-xl">
    <DekoIllustration motiv="eukalyptus" farbe="#BC541F" breite={211} cssRotate={29} top={65} seite="links" abstand={-130} />
    <DekoIllustration motiv="blattzweig" farbe="#BC541F" breite={170} cssRotate={-30} top={300} seite="rechts" abstand={-210} />
    <div class="mx-auto flex max-w-inhalt flex-col gap-[5rem] px-6 md:flex-row md:items-center md:px-0">
      <div class="relative h-[30rem] w-full shrink-0 md:w-[37.5rem]">
        <div class="absolute left-[8.75rem] top-0 h-[20rem] w-[28.75rem] overflow-hidden">
          <BildPicture id="kontakt-teaser-01" class="h-full w-full object-cover" widths={[460, 920]} sizes="(max-width: 768px) 100vw, 460px" />
        </div>
        <div class="absolute left-0 top-[15.0625rem] h-[14.9375rem] w-[22.375rem] overflow-hidden">
          <BildPicture id="kontakt-teaser-02" class="h-full w-full object-cover" widths={[358, 716]} sizes="(max-width: 768px) 100vw, 358px" />
        </div>
      </div>
      <div class="flex flex-1 min-w-0 flex-col gap-8">
        <h2 class="font-display text-h2 font-semibold leading-normal text-cream">
          Für alle,<br>die zu sich zurückfinden<br>möchten.
        </h2>
        <p class="font-body text-small leading-[2] text-cream/[0.92]">{kontaktP1}</p>
        <p class="font-body text-small leading-[2] text-cream/[0.92]">{kontaktP2}</p>
        <a href="/kontakt" class="inline-flex self-start items-center justify-center rounded-[1.0625rem] bg-beige px-md py-sm font-body text-cta uppercase text-cream transition-colors hover:bg-orange">
          Kontakt
        </a>
      </div>
    </div>
  </section>

  </div>

  <Footer />

</Base>
