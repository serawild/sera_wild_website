  </section>

  </div>

  <Footer />
</Base>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const track = document.getElementById('galerie-track') as HTMLElement | null;
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.galerie-dot'));
  if (!track || !dots.length) return;
  // Die Karten sind unterschiedlich breit (quer und hoch gemischt), darum wird
  // die naechstgelegene Kartenkante gesucht statt mit einer festen Breite gerechnet.
  const karten = Array.from(track.querySelectorAll<HTMLElement>('.galerie-karte'));
  track.addEventListener('scroll', () => {
    let idx = 0;
    let beste = Infinity;
    karten.forEach((k, i) => {
      const abstand = Math.abs(k.offsetLeft - track.scrollLeft - 24);
      if (abstand < beste && i < dots.length) { beste = abstand; idx = i; }
    });
    dots.forEach((d, i) => {
      d.classList.toggle('opacity-100', i === idx);
      d.classList.toggle('opacity-30', i !== idx);
    });
  });
});
</script>
