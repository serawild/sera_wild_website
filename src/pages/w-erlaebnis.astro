---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import BildPicture from '../components/BildPicture.astro';
import DekoIllustration from '../components/DekoIllustration.astro';
import FaqListe from '../components/FaqListe.astro';
import Wortmarke from '../components/Wortmarke.astro';

// Wird im "Das W"-Abschnitt als reine Bildmarke (ohne Text) benötigt
const W_PATH =
  'M881.4,117.35c282.95,21.85,598.33,247.43,856,154.88,4.73-1.7,7.95-6.11,8.15-11.14' +
  '.69-17.3-1.88-60.18-6.11-69.29-2.38-5.13-9.54-5.9-14.62-3.43-188.71,91.8-623.66' +
  '-133.23-831.73-151.36-124.72-10.86-179.85,31.53-213.39,154.86-32.8,120.6-157.59,' +
  '618.16-201.63,788.23-5.65,21.82-9.92,15.23-9.92,15.23-19.82-23.76-34.89-483.1' +
  '-45.26-513.63-.68-2.01-10.13-25.66-27.07-10.46-11.23,10.08-60.87,52.27-79.74,' +
  '67.1-5.12,4.02-8.6,9.56-10.77,15.81,0,0-76.99,237.1-102.29,279.14-7.09,10.84' +
  '-21.74,15.31-29.98,1.32-28.86-49,3.34-527.09,3.34-527.09,0,0,4.11-64.62-17.8' +
  '-64.82-19.95-.18-90.94,73.97-119.74,94.43-4.53,3.22-7.36,8.9-3.56,16.51,4.67,' +
  '9.38,37.18-8.33,32.36,188.34-2.47,100.99-23.62,418.02,19.61,454.73,18,15.28,' +
  '50.21,15.87,74.51-4.17,75.84-62.54,157.07-334.88,169.23-360.7,6.06-12.9,19.82' +
  '-5.8,19.7,4.87,12.28,155.86,21.46,379.45,32.15,469.48,12.29,103.53,28.71,126.98' +
  ',66.89,126.98s66.01-23.21,88.51-111.77c81.99-322.71,112.53-465.65,154.17-641.85' +
  ',72.17-305.42,95.16-369.45,188.98-362.2Z';

// Shared text (used in both mobile and desktop blocks)
const heroSubZ1 = 'Wenn du weisst, wer du bist,';
const heroSubZ2 = 'kannst du sein, wer du willst.';

const begegnungH2 = 'Das W-Erläbnis ist mehr als ein Fotoshooting. Sie ist eine Begegnung.';
const begegnungP1 = 'Da steckt mehr in dir, als du gerade siehst.';
const begegnungP2 = 'Gemeinsam gehen wir auf die Suche nach dem, was dich lebendig macht. Die «W»-Session stellt die Fragen, die wirklich zählen: Wer bist du? Was bewegt dich? Wofür stehst du?';

const dasWFragen = [
  { w: 'Wann',   rest: ' fühlst du dich am lebendigsten?' },
  { w: 'Wo',     rest: ' trägst du eine Maske – und warum?' },
  { w: 'Welche', rest: ' Teile von dir hätten gerne mehr Raum?' },
  { w: 'Wenn',   rest: ' du keine Angst hättest: Was würdest du beginnen?' },
];
const dasWFussnote = 'Vier Fragen, auf die es keine schnelle Antwort gibt. Genau deshalb nehmen wir uns zwei bis drei Stunden Zeit.';

const angebotH2  = 'Ein Preis, keine Überraschungen';
const angebotSub = 'Alles, was dazugehört, ist drin. Was mehr wird, siehst du hier – nicht erst auf der Rechnung.';
const angebotLeistungen = [
  'Vorbereitungsgespräch und gemeinsame Planung',
  '2–3 Stunden fotografieren, mit Pause',
  'Reportage statt Posieren',
  'Deine Bilderreise: mindestens 40 Bilder, die dich nicht abbilden, sondern zeigen',
  'Licht, Farbe und Ausschnitt – bei jedem einzelnen Bild',
  'Alle Bilder ohne Wasserzeichen',
  'Leichte Hautretusche, wo sie guttut',
  'Deine Favoriten gedruckt, in einer Leinenschachtel',
  'Persönliche Übergabe statt Downloadlink',
];
const angebotExtras = [
  { text: 'Eine zweite Session später',                       preis: 'CHF 450.–' },
  { text: 'Zusätzliche Prints oder ein grösseres Format',     preis: 'auf Anfrage' },
];
const angebotFN = 'Fahrspesen im Raum Aareland sind inbegriffen. Shooting auf dem Berg, in der Stadt oder im Ausland? Das sprechen wir individuell ab.';

const timelineSchritte = [
  {
    nr: 1, icon: '01-telefon', titel: 'Wir reden',
    label: 'Telefon · ca. 15 Minuten',
    text: 'Wo stehst du gerade? Was möchtest du sichtbar machen? Wir klären in Ruhe, ob es passt – und finden einen Termin.',
    extra: null as string | null,
  },
  {
    nr: 2, icon: '02-brief', titel: 'Du denkst nach',
    label: 'In deinem Tempo · zu Hause',
    text: 'Du bekommst von mir ein paar Fragen zu dir selbst. Keine Prüfung, kein Aufwand – einfach Zeit für dich, bevor wir uns treffen.',
    extra: null as string | null,
  },
  {
    nr: 3, icon: '03-karte', titel: 'Wir planen',
    label: 'Telefon · ca. 30 Minuten',
    text: 'Anhand deiner Antworten entscheiden wir gemeinsam: welcher Ort, welche Stimmungen, was du mitbringst, was du tun magst.',
    extra: null as string | null,
  },
  {
    nr: 4, icon: '04-kamera', titel: 'Dein W-Erläbnis',
    label: 'Vor Ort · 2–3 Stunden',
    text: 'Dein Lieblingsplatz, eine Pause, viel Raum. Die Kamera ist Begleiterin – kein Star.',
    extra: 'Viel länger fotografieren wir bewusst nicht: Es geht in die Tiefe, und das braucht Kraft.' as string | null,
  },
  {
    nr: 5, icon: '05-bilder', titel: 'Deine Bilder',
    label: 'Persönlich · rund zwei Wochen später',
    text: 'Wir treffen uns noch einmal. Deine Lieblingsbilder liegen gedruckt vor dir – und deine ganze Bilderreise nimmst du digital mit nach Hause.',
    extra: null as string | null,
  },
];

const orteH2  = 'Wo wir fotografieren könnten';
const orteSub = 'Der Ort ist nicht Kulisse, sondern Teil deiner Geschichte. Am schönsten wird es dort, wo du dich lebendig fühlst – wo dich etwas inspiriert oder deine Leidenschaft weckt. Hier ein paar Vorschläge. Vielleicht fällt dir beim Lesen längst ein anderer ein.';
const orteList = [
  { id: 'orte-aare',    titel: 'Aare',                text: 'Wasser, Weite, Bewegung. Kiesbank, Uferweg oder Auenwald – das Wasser nimmt dir einen Teil des Gesprächs ab.' },
  { id: 'orte-wald',    titel: 'Wald',                text: 'Gedämpftes Licht, viel Grün, kaum Publikum. Für alle, die etwas Zeit brauchen, bis sie auftauen.' },
  { id: 'orte-stadt',   titel: 'Stadt',               text: 'Mauern, Gassen, Fenster, Reflexe. Der Gegenpol zur Natur – klarer, direkter, wacher.' },
  { id: 'orte-atelier', titel: 'Atelier oder zu Hause', text: 'Der eigene Sessel, die eigene Küche, dein Arbeitsplatz. Für alle, die sich dort am ehesten wie sich selbst fühlen.' },
  { id: 'orte-scheune', titel: 'Die Scheune',         text: 'Vier Kulissen, viel Holz, Licht von der Seite. Wetterunabhängig – und trotzdem alles andere als ein Studio.' },
];

const richtigH2    = 'Du bist hier richtig wenn,';
const richtigItems = [
  '…du dich in einer Übergangsphase befindest',
  '…du dich in einer Neuorientierung befindest',
  '…du gerade eine Rollenveränderung erlebt hast',
  '…du keine Bilder willst, auf denen du dich verstellen musst',
];
const richtigBold  = 'Viele kommen zu mir, wenn sich gerade etwas verändert. Neuer Job, Kinder aus dem Haus, ein Kapitel zu Ende.';

const ctaH2 = 'Noch nicht sicher, ob das W-Erläbnis das Richtige ist?';
const ctaP1 = 'Dann fangen wir kleiner an – in einer alten Scheune, vier Kulissen, viel Holz und Licht von der Seite. 15 bis 60 Minuten statt einem halben Tag.';
const ctaP2 = 'Kein Studio im klassischen Sinn: keine weisse Wand, keine Heizung. Im Sommer warm, im Winter frisch. Genau das macht die Bilder aus.';

const simonaH2 = 'So sah ein ganzes W-Erläbnis aus';
const simonaP  = 'Simona hatte schon Bilder – und hat sich auf keinem davon wiedererkannt. Ihre Geschichte, und was an diesem Nachmittag entstanden ist.';

const faqFragen = [
  { q: 'Muss ich Erfahrung vor der Kamera haben?',       a: 'Überhaupt nicht – die meisten meiner Kundinnen stehen zum ersten Mal bewusst vor einer Kamera. Genau dafür bin ich da.' },
  { q: 'Wie viel kostet ein Shooting?',                  a: 'Das W-Momänt startet bei CHF 149. Das W-Erläbnis kostet CHF 950 – alles inbegriffen, Fahrspesen im Raum Aareland eingerechnet.' },
  { q: 'Wie viel Zeit sollte ich einplanen?',            a: 'Für das W-Erläbnis zwei bis drei Stunden vor Ort, mit Pause. Beim W-Momänt je nach Paket 15 bis 60 Minuten. Sei bitte 15 Minuten vor dem Start da, damit wir in Ruhe ankommen.' },
  { q: 'Wo findet das Shooting statt?',                  a: 'Das W-Momänt findet in 5014 Gretzenbach statt. Für das W-Erläbnis fahren wir zu deinem Lieblingsort oder finden gemeinsam ein oder mehrere Fotospots.' },
  { q: 'Was soll ich anziehen?',                         a: 'Du erhältst nach der Buchung meinen persönlichen Guide mit Tipps zu Kleidung und Vorbereitung.' },
  { q: 'Was passiert bei schlechtem Wetter?',            a: 'Wir verschieben kostenlos, auch kurzfristig. Bei leichtem Regen frage ich dich vorher – manchmal entstehen dann die ruhigsten Bilder. In der Scheune sind wir vom Wetter unabhängig.' },
  { q: 'Wann bekomme ich meine Bilder?',                 a: 'In der Regel zwei bis drei Wochen nach dem Shooting. Du bekommst deine ganze Bilderreise – und deine Favoriten zusätzlich gedruckt, persönlich übergeben in einer Leinenschachtel.' },
  { q: 'Wie weit im Voraus soll ich mich melden?',       a: 'Vier bis sechs Wochen sind ideal. Fragen ist immer erlaubt - vielleicht finden wir sogar ganz kurzfristig und spontan einen Termin.' },
  { q: 'Für wen ist das W-Erläbnis nicht das Richtige?', a: 'Wenn du klassische Bewerbungsfotos brauchst, bist du woanders besser aufgehoben. Und wenn du Bilder willst, auf denen du perfekt aussiehst statt wie du selbst, passen wir nicht zusammen.' },
];
---

<Base
  title="W-Erläbnis — sera Wild"
  description="Das W-Erläbnis: eine prozessorientierte Fotosession in zwei bis drei Stunden, die zeigt, wer du wirklich bist."
>

  <!-- ===== 1. HERO ===== -->
  <section class="relative h-[43.75rem] overflow-hidden md:h-[100svh] md:min-h-[600px]">

    <!-- Mobiles Hintergrundbild (-hoch Variante) -->
    <div class="absolute inset-0 overflow-hidden md:hidden">
      <BildPicture
        id="hero-erlaebnis"
        mobil={true}
        class="absolute inset-0 h-full w-full object-cover object-top"
        loading="eager"
        fetchpriority="high"
        widths={[390, 780]}
        sizes="100vw"
      />
    </div>
    <!-- Desktop-Hintergrundbild -->
    <div class="absolute inset-0 hidden overflow-hidden md:block">
      <BildPicture
        id="hero-erlaebnis"
        class="absolute inset-0 h-full w-full object-cover object-[56%_35%] scale-[1.35] origin-[56%_35%]"
        loading="eager"
        fetchpriority="high"
        widths={[768, 1280, 1728, 2560]}
        sizes="100vw"
      />
    </div>

    <div class="absolute inset-0 bg-black/40 pointer-events-none" aria-hidden="true"></div>
    <Navigation farbe="hell" />

    <!-- Mobiler Text: links unten — Wortmarke + Untertitel -->
    <div class="absolute bottom-16 left-6 flex flex-col items-start gap-[18px] md:hidden">
      <h1 aria-label="W-Erläbnis">
        <Wortmarke wort="Erläbnis" breite={15} klasse="text-cream" />
      </h1>
      <div>
        <p class="font-body text-[1.125rem] leading-[1.6] text-cream">{heroSubZ1}</p>
        <p class="font-body text-[1.125rem] leading-[1.6] text-cream">{heroSubZ2}</p>
      </div>
    </div>

    <!-- Desktop-Text: rechts unten -->
    <div class="absolute bottom-[10rem] right-6 hidden flex-col items-end text-right md:flex md:right-[7.5rem]">
      <h1 class="mb-[1.625rem]" aria-label="W-Erläbnis">
        <Wortmarke wort="Erläbnis" breite={27.5} klasse="text-cream" />
      </h1>
      <p class="font-display text-h2 font-semibold leading-normal text-cream">{heroSubZ1}</p>
      <p class="font-display text-h2 font-semibold leading-normal text-cream">{heroSubZ2}</p>
    </div>
  </section>


  <!-- ===== 2a. MOBIL: 01 Begegnung ===== -->
  <section class="relative isolate overflow-hidden bg-cream px-6 pt-12 pb-12 md:hidden">
    <DekoIllustration motiv="tulpe" farbe="#A0886D" breite={186} cssRotate={-27} obenAbAnkerAnteil={0.05} seite="rechts" abstand={-86} mobil={true} deckkraft={0.5} />
    <div class="mb-[18px] flex items-center gap-3">
      <span class="font-body font-bold text-[0.75rem] uppercase tracking-[0.08em] text-dark/50">01</span>
      <div class="h-px w-5 bg-dark/50" aria-hidden="true"></div>
      <span class="font-body text-[0.75rem] uppercase tracking-[0.16em] text-dark/50">BEGEGNUNG</span>
    </div>
    <h2 class="mb-[18px] font-display text-[1.6875rem] font-semibold leading-[1.28] text-dark">{begegnungH2}</h2>
    <div class="mb-8 flex flex-col gap-[14px]">
      <p class="font-body text-[1.0625rem] leading-[1.68] text-dark font-bold">{begegnungP1}</p>
      <p class="font-body text-[1.0625rem] leading-[1.68] text-dark">{begegnungP2}</p>
    </div>
    <!-- Bildgruppe: gross 214×286 bei 0/0, klein 178×238 bei 164/84 -->
    <div class="relative mx-auto" style="width:342px;height:322px">
      <div class="absolute overflow-hidden rounded-[3px]" style="left:0;top:0;width:214px;height:286px">
        <BildPicture
          id="begegnung-01"
          mobil={true}
          class="h-full w-full object-cover"
          widths={[214, 428]}
          sizes="214px"
        />
      </div>
      <div class="absolute overflow-hidden rounded-[3px]" style="left:164px;top:84px;width:178px;height:238px">
        <BildPicture
          id="begegnung-02"
          mobil={true}
          class="h-full w-full object-cover"
          widths={[178, 356]}
          sizes="178px"
        />
      </div>
    </div>
  </section>

  <!-- ===== 2b. DESKTOP: Begegnung ===== -->
  <section class="relative isolate overflow-visible bg-cream-warm py-xl hidden md:block">
    <DekoIllustration motiv="mohn" farbe="#5B5C4F" breite={130} cssRotate={-16.2} top={525} seite="links" abstand={189} />
    <div class="mx-auto flex max-w-inhalt items-center gap-[5rem]">
      <div class="relative h-[37.5rem] w-[35rem] shrink-0">
        <div class="absolute left-0 top-0 h-[25rem] w-[20rem]">
          <BildPicture id="begegnung-01" class="h-full w-full object-cover" />
        </div>
        <div class="absolute left-[15rem] top-[12.5rem] h-[25rem] w-[20rem]">
          <BildPicture id="begegnung-02" class="h-full w-full object-cover" />
        </div>
      </div>
      <div class="flex flex-1 min-w-0 flex-col gap-[3rem]">
        <h2 class="font-display text-h2 font-semibold leading-normal">{begegnungH2}</h2>
        <div class="flex flex-col gap-[1.5rem]">
          <p class="font-body text-body leading-[1.65] font-bold">{begegnungP1}</p>
          <p class="font-body text-body leading-[1.65]">{begegnungP2}</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ===== 3a. MOBIL: 02 Das W ===== -->
  <section class="relative isolate overflow-hidden bg-dark px-6 pt-[52px] pb-[52px] md:hidden">
    <div class="mb-[18px] flex items-center gap-3">
      <span class="font-body font-bold text-[0.75rem] uppercase tracking-[0.08em] text-cream/50">02</span>
      <div class="h-px w-5 bg-cream/50" aria-hidden="true"></div>
      <span class="font-body text-[0.75rem] uppercase tracking-[0.16em] text-cream/50">DAS W</span>
    </div>
    <p class="mb-1 font-body text-[0.75rem] uppercase tracking-[0.11em] text-beige">DAS W IM W-ERLÄBNIS</p>
    <h2 class="mb-[18px] font-display text-[1.6875rem] font-semibold leading-[1.28] text-cream">Wofür das W steht</h2>
    <div class="flex flex-col gap-3">
      {dasWFragen.map((f) => (
        <div class="rounded-[8px] bg-cream/10 px-5 py-4">
          <p class="font-display text-[1.25rem] font-semibold leading-[1.3] text-cream">
            <span class="text-orange">{f.w}</span>{f.rest}
          </p>
        </div>
      ))}
    </div>
    <p class="mt-5 font-body text-[0.9375rem] leading-[1.65] text-beige">{dasWFussnote}</p>
  </section>

  <!-- ===== 3b. DESKTOP: Das W ===== -->
  <section class="relative isolate overflow-visible z-10 bg-dark py-[6rem] hidden md:block">
    <DekoIllustration motiv="eukalyptus" farbe="#BC541F" breite={348} cssRotate={-25.3} top={-80} seite="rechts" abstand={-240} />
    <div class="mx-auto flex max-w-inhalt items-center gap-[5rem] px-[7.5rem]">
      <svg
        viewBox="0 0 1765.27 1262.84"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        class="w-[27.5rem] shrink-0 text-cream"
        fill="currentColor"
      >
        <path d={W_PATH} />
      </svg>
      <div class="flex flex-col gap-[1.375rem]">
        <p class="font-body text-body-klein uppercase tracking-[1.76px] text-beige">DAS W IM W-ERLÄBNIS</p>
        <h2 class="font-display text-h2 font-semibold leading-normal">Wofür das W steht</h2>
        <div class="flex flex-col gap-[0.75rem]">
          {dasWFragen.map((f) => (
            <p class="font-display text-h3 font-semibold leading-[1.45]">
              <span class="text-orange">{f.w}</span>{f.rest}
            </p>
          ))}
        </div>
        <p class="font-body text-small leading-[2] text-beige">{dasWFussnote}</p>
      </div>
    </div>
  </section>


  <!-- ===== 4. WONACH WIR SUCHEN (responsive) ===== -->
  <section class="relative isolate overflow-visible z-[2] bg-cream-warm px-6 py-12 md:py-[6rem] md:px-[16.25rem]">
    <DekoIllustration motiv="mohn" farbe="#BC541F" breite={306} cssRotate={29.4} top={-80} seite="links" abstand={-226} />
    <DekoIllustration motiv="mohn" farbe="#A0886D" breite={162} cssRotate={21} obenAbAnkerAnteil={-0.08} seite="links" abstand={-75} mobil={true} deckkraft={0.5} />
    <div class="flex flex-col items-center gap-[1.25rem] text-center md:gap-[2rem]">
      <p class="font-body text-[0.75rem] uppercase tracking-[0.08em] text-rust md:text-[1rem] md:tracking-[1.28px]">LÄB DIS LÄBE</p>
      <h2 class="font-display text-[1.6875rem] font-semibold leading-[1.28] md:text-[3.25rem] md:leading-normal">Wonach wir suchen</h2>
      <p class="font-body text-[1.0625rem] leading-[1.68] md:text-[1.75rem] md:leading-[1.7]">
        Lebendigkeit ist kein Zustand, den man erreicht. Sie ist das Prickeln auf der Haut, ein Lachen aus dem Bauch, ein Moment der Klarheit im Chaos – das Gefühl, wirklich da zu sein.
      </p>
      <p class="font-body text-[1.0625rem] leading-[1.68] md:text-[1.75rem] md:leading-[1.7]">
        Genau danach halte ich Ausschau. Nicht nach dem besten Winkel.
      </p>
    </div>
  </section>


  <!-- ===== 5a. MOBIL: 04 Angebot ===== -->
  <section class="bg-olive px-6 pt-[52px] pb-[52px] md:hidden">
    <div class="mb-[18px] flex items-center gap-3">
      <span class="font-body font-bold text-[0.75rem] uppercase tracking-[0.08em] text-cream/50">04</span>
      <div class="h-px w-5 bg-cream/50" aria-hidden="true"></div>
      <span class="font-body text-[0.75rem] uppercase tracking-[0.16em] text-cream/50">ANGEBOT</span>
    </div>
    <h2 class="mb-[14px] font-display text-[1.6875rem] font-semibold leading-[1.28] text-cream">{angebotH2}</h2>
    <p class="mb-6 font-body text-[1.0625rem] leading-[1.68] text-cream/80">{angebotSub}</p>

    <!-- Preisbox -->
    <div class="mb-6 rounded-[8px] bg-cream px-5 py-6 text-center shadow-sm">
      <p class="font-display text-[2rem] font-semibold text-dark">CHF 950.–</p>
      <p class="mt-1 font-body text-[0.875rem] font-medium text-beige">2–3 Fotospots · 2–3 Stunden</p>
      <p class="mt-2 font-display text-[1rem] italic text-dark">Ein Ort, den du liebst – und vielleicht noch einer gleich um die Ecke.</p>
    </div>

    <!-- Das ist immer dabei -->
    <p class="mb-4 font-display text-[1.25rem] font-semibold text-cream">Das ist immer dabei</p>
    <div class="mb-6 flex flex-col gap-[10px]">
      {angebotLeistungen.map((item) => (
        <div class="flex items-start gap-3">
          <div class="mt-[5px] h-[10px] w-[10px] shrink-0 rounded-full bg-beige"></div>
          <p class="font-body text-[1rem] leading-[1.65] text-cream/90">{item}</p>
        </div>
      ))}
    </div>

    <!-- Wenn du mehr möchtest (aufklappbar) -->
    <details class="mb-4 rounded-[8px] bg-cream/10">
      <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 font-display text-[1.25rem] font-semibold text-cream">
        Wenn du mehr möchtest
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 shrink-0" aria-hidden="true">
          <path d="M8 3v10M3 8h10" />
        </svg>
      </summary>
      <div class="px-5 pb-5">
        {angebotExtras.map((e, i) => (
          <>
            {i > 0 && <div class="h-px bg-cream/20"></div>}
            <div class="flex items-start justify-between gap-4 py-3">
              <p class="font-body text-[1rem] leading-[1.65] text-cream/90">{e.text}</p>
              <p class="font-body text-[1rem] font-medium text-cream shrink-0">{e.preis}</p>
            </div>
          </>
        ))}
        <div class="mt-4 h-px bg-cream/20"></div>
        <!-- Win-Win -->
