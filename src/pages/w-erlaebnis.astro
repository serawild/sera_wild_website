  const orteDots   = Array.from(document.querySelectorAll<HTMLElement>('.orte-dot'));

  function orteStep(): number {
    const item = orteTrack?.querySelector<HTMLElement>('div') ?? null;
    if (!item) return 270;
    return item.offsetWidth + 10;
  }

  function updateOrteDots() {
    if (!orteScroll || !orteDots.length) return;
    const idx = Math.round(orteScroll.scrollLeft / orteStep());
    orteDots.forEach((d, i) => {
      d.classList.toggle('opacity-100', i === idx);
      d.classList.toggle('opacity-40',  i !== idx);
    });
  }

  orteScroll?.addEventListener('scroll', updateOrteDots, { passive: true });
</script>
