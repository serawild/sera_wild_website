---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import BildPicture from '../components/BildPicture.astro';
import DekoIllustration from '../components/DekoIllustration.astro';

const FARBEN = { Hellgrün: '#5B5C4F', Hellorange: '#BC541F', Beige: '#A0886D', Hell: '#F5F3ED' };
---

<Base
  title="Kontakt — sera Wild"
  description="Schreib mir! Seraina freut sich auf deine Nachricht – per Mail, Telefon oder WhatsApp."
>

  <Navigation farbe="hell" />

  <!-- ===== HERO ===== -->

  <!-- Mobile: olive + hoch-Bild -->
  <section class="relative md:hidden h-[43.75rem] overflow-hidden bg-olive">
    <BildPicture
      id="hero-kontakt"
      class="absolute inset-0 h-full w-full object-cover"
      mobil={true}
      loading="eager"
      fetchpriority="high"
      widths={[390, 780]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-black/30 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-10 left-6 max-w-[21rem]">
      <h1 class="font-display text-[1.9375rem] leading-[1.3] font-semibold text-cream">Schreib mir!</h1>
      <p class="font-body text-[1.125rem] leading-[1.6] text-cream mt-[0.5rem]">Ich freue mich auf Dich!</p>
    </div>
  </section>

  <!-- Desktop: Landschaftsbild -->
  <section class="hidden md:block relative h-[100svh] min-h-[600px] overflow-hidden">
    <div class="absolute inset-0 overflow-hidden opacity-[0.87]">
      <BildPicture
        id="hero-kontakt"
        class="absolute inset-0 h-full w-full object-cover object-[50%_0%]"
        loading="eager"
        fetchpriority="high"
        widths={[768, 1280, 1728, 2560]}
        sizes="100vw"
      />
    </div>
    <div class="absolute inset-0 bg-black/40 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-[10rem] right-6 max-w-[73.4375rem] text-right md:right-[7.5rem]">
      <h1 class="font-display text-h1 font-semibold leading-tight text-cream">Schreib mir!</h1>
      <p class="font-display text-h2 font-semibold leading-tight text-cream">Ich freue mich auf Dich!</p>
    </div>
  </section>

  <div class="relative isolate">

  <!-- ===== 01 KONTAKTDATEN ===== -->
  <section class="relative isolate overflow-hidden bg-cream-warm py-12 md:py-[5.5rem]">
    <!-- W-Hintergrund (desktop only) -->
    <svg
      viewBox="0 0 1765.27 1262.84"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      class="pointer-events-none absolute -z-10 hidden md:block"
      style="top:1.25rem;left:64.3125rem;width:48.875rem;height:35rem;opacity:0.07;"
      fill="#2e322c"
    >
      <path d="M881.4,117.35c282.95,21.85,598.33,247.43,856,154.88,4.73-1.7,7.95-6.11,8.15-11.14.69-17.3-1.88-60.18-6.11-69.29-2.38-5.13-9.54-5.9-14.62-3.43-188.71,91.8-623.66-133.23-831.73-151.36-124.72-10.86-179.85,31.53-213.39,154.86-32.8,120.6-157.59,618.16-201.63,788.23-5.65,21.82-9.92,15.23-9.92,15.23-19.82-23.76-34.89-483.1-45.26-513.63-.68-2.01-10.13-25.66-27.07-10.46-11.23,10.08-60.87,52.27-79.74,67.1-5.12,4.02-8.6,9.56-10.77,15.81,0,0-76.99,237.1-102.29,279.14-7.09,10.84-21.74,15.31-29.98,1.32-28.86-49,3.34-527.09,3.34-527.09,0,0,4.11-64.62-17.8-64.82-19.95-.18-90.94,73.97-119.74,94.43-4.53,3.22-7.36,8.9-3.56,16.51,4.67,9.38,37.18-8.33,32.36,188.34-2.47,100.99-23.62,418.02,19.61,454.73,18,15.28,50.21,15.87,74.51-4.17,75.84-62.54,157.07-334.88,169.23-360.7,6.06-12.9,19.82-5.8,19.7,4.87,12.28,155.86,21.46,379.45,32.15,469.48,12.29,103.53,28.71,126.98,66.89,126.98s66.01-23.21,88.51-111.77c81.99-322.71,112.53-465.65,154.17-641.85,72.17-305.42,95.16-369.45,188.98-362.2Z"/>
    </svg>

    <div class="mx-auto max-w-inhalt px-6 md:px-[7.5rem]">
      <div class="mb-md flex flex-col items-center gap-4 text-center">
        <p class="font-display text-[2rem] md:text-[3rem] font-semibold uppercase tracking-[0.15em] text-dark">Kontakt</p>
        <p class="font-body text-[1.0625rem] md:text-body text-dark/85">Schreib einfach drauf los...</p>
      </div>
      <div class="mx-auto mb-[2rem] md:mb-[3.5rem] h-[3px] w-20 bg-rust"></div>

      <div class="flex flex-col gap-5 md:gap-7">
        <!-- Mail + Telefon -->
        <div class="grid grid-cols-1 gap-5 md:gap-7 md:grid-cols-2">
          <a
            href="mailto:info@serawild.com"
            class="flex flex-col gap-[1.125rem] rounded-[0.625rem] border border-[rgba(160,136,109,0.45)] bg-white p-6 md:p-9 transition-shadow hover:shadow-md"
          >
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[rgba(176,131,86,0.1)]">
                <svg viewBox="0 0 20 20" fill="none" stroke="#b08257" stroke-width="1.5" class="h-5 w-5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M1.667 5.833A1.667 1.667 0 0 1 3.333 4.167h13.334A1.667 1.667 0 0 1 18.333 5.833v8.334A1.667 1.667 0 0 1 16.667 15.833H3.333A1.667 1.667 0 0 1 1.667 14.167V5.833ZM1.667 5.833l8.333 5 8.333-5" />
                </svg>
              </div>
              <span class="font-body text-label font-bold uppercase tracking-[0.15em] text-[#b08257]">Mail</span>
            </div>
            <span class="font-body text-[1.0625rem] md:text-body leading-[2] text-dark">info@serawild.com</span>
          </a>

          <div class="flex flex-col gap-[1.125rem] rounded-[0.625rem] border border-[rgba(160,136,109,0.45)] bg-white p-6 md:p-9">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[rgba(176,131,86,0.1)]">
                <svg viewBox="0 0 20 20" fill="none" stroke="#b08257" stroke-width="1.5" class="h-5 w-5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 3.333h3.333L7.5 7.5 5.417 8.75A9.167 9.167 0 0 0 11.25 14.583L12.5 12.5l4.167 1.667v3.333A1.667 1.667 0 0 1 15 19.167C7.716 18.75 1.25 12.284.833 5A1.667 1.667 0 0 1 2.5 3.333Z" />
                </svg>
              </div>
              <span class="font-body text-label font-bold uppercase tracking-[0.15em] text-[#b08257]">Telefon</span>
            </div>
            <span class="font-body text-[1.0625rem] md:text-body leading-[2] text-dark">+41 79 790 57 01</span>
          </div>
        </div>

        <!-- Adresse + Instagram + LinkedIn -->
        <div class="grid grid-cols-1 gap-5 md:gap-7 md:grid-cols-3">
          <div class="flex flex-col gap-[1.125rem] rounded-[0.625rem] border border-[rgba(160,136,109,0.45)] bg-white p-6 md:p-9">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[rgba(176,131,86,0.1)]">
                <svg viewBox="0 0 20 20" fill="none" stroke="#b08257" stroke-width="1.5" class="h-5 w-5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 11.25a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.25 10c0 5.952-6.25 9.375-6.25 9.375S3.75 15.952 3.75 10a6.25 6.25 0 0 1 12.5 0Z" />
                </svg>
              </div>
              <span class="font-body text-label font-bold uppercase tracking-[0.15em] text-[#b08257]">Adresse</span>
            </div>
            <span class="font-body text-[1rem] md:text-small leading-[2] text-dark">
              Pfarrmattstrasse 9<br />5014 Gretzenbach
            </span>
          </div>

          <a
            href="https://www.instagram.com/serawild/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col gap-[1.125rem] rounded-[0.625rem] border border-[rgba(160,136,109,0.45)] bg-white p-6 md:p-9 transition-shadow hover:shadow-md"
          >
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[rgba(176,131,86,0.1)]">
                <svg viewBox="0 0 20 20" fill="none" class="h-5 w-5" aria-hidden="true">
                  <rect x="2.5" y="2.5" width="15" height="15" rx="4" stroke="#b08257" stroke-width="1.5"/>
                  <circle cx="10" cy="10" r="3.5" stroke="#b08257" stroke-width="1.5"/>
                  <circle cx="14.5" cy="5.5" r="0.75" fill="#b08257"/>
                </svg>
              </div>
              <span class="font-body text-label font-bold uppercase tracking-[0.15em] text-[#b08257]">Instagram</span>
            </div>
            <span class="font-body text-[1rem] md:text-small leading-[2] text-dark">@serawild</span>
          </a>

          <a
            href="https://www.linkedin.com/in/seraina-stettler-a7b3a32a3/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col gap-[1.125rem] rounded-[0.625rem] border border-[rgba(160,136,109,0.45)] bg-white p-6 md:p-9 transition-shadow hover:shadow-md"
          >
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[rgba(176,131,86,0.1)]">
                <svg viewBox="0 0 20 20" fill="#b08257" class="h-5 w-5" aria-hidden="true">
                  <path d="M4.15 2.917a2.083 2.083 0 1 1 0 4.166 2.083 2.083 0 0 1 0-4.166ZM2.5 7.5h3.333V17.5H2.5V7.5Zm5.833 0h3.194v1.367h.042c.444-.792 1.527-1.625 3.139-1.625 3.361 0 3.984 2.131 3.984 4.903V17.5h-3.334v-4.917c0-1.172-.021-2.681-1.666-2.681-1.667 0-1.923 1.277-1.923 2.597V17.5H8.333V7.5Z"/>
                </svg>
              </div>
              <span class="font-body text-label font-bold uppercase tracking-[0.15em] text-[#b08257]">LinkedIn</span>
            </div>
            <span class="font-body text-[1rem] md:text-small leading-[2] text-dark">Sera Wild</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 02 NACH DEINER NACHRICHT ===== -->

  <!-- Mobile: dark -->
  <section class="md:hidden bg-dark py-[52px] px-6">
    <h2 class="font-display text-[1.6875rem] leading-[1.28] font-semibold text-cream mb-[2rem]">
      Was passiert, nachdem du geschrieben hast
    </h2>
    <div class="flex flex-col gap-[1.5rem]">
      <div class="flex flex-col gap-[0.625rem]">
        <div class="flex h-[2.5rem] w-[2.5rem] items-center justify-center rounded-full bg-orange">
          <span class="font-display text-[1.125rem] font-semibold text-cream">1</span>
        </div>
        <p class="font-display text-[1.375rem] font-semibold text-cream mt-[0.25rem]">Ich melde mich</p>
        <p class="font-body text-[1.0625rem] leading-[1.68] text-cream/90">Per Mail oder Telefon – so, wie du geschrieben hast. Du musst nichts weiter tun.</p>
      </div>
      <div class="flex flex-col gap-[0.625rem]">
        <div class="flex h-[2.5rem] w-[2.5rem] items-center justify-center rounded-full bg-orange">
          <span class="font-display text-[1.125rem] font-semibold text-cream">2</span>
        </div>
        <p class="font-display text-[1.375rem] font-semibold text-cream mt-[0.25rem]">Wir telefonieren kurz</p>
        <p class="font-body text-[1.0625rem] leading-[1.68] text-cream/90">Rund 15 Minuten, unverbindlich. Du erzählst, was du dir vorstellst, ich höre zu und stelle Fragen.</p>
      </div>
      <div class="flex flex-col gap-[0.625rem]">
        <div class="flex h-[2.5rem] w-[2.5rem] items-center justify-center rounded-full bg-orange">
          <span class="font-display text-[1.125rem] font-semibold text-cream">3</span>
        </div>
        <p class="font-display text-[1.375rem] font-semibold text-cream mt-[0.25rem]">Entscheide später</p>
        <p class="font-body text-[1.0625rem] leading-[1.68] text-cream/90">Kein Druck, keine Anzahlung. Wenn es nicht passt, ist das völlig in Ordnung.</p>
      </div>
    </div>
  </section>

  <!-- Desktop: cream-warm -->
  <section class="hidden md:block bg-cream-warm py-[4.8125rem]">
    <div class="mx-auto max-w-inhalt px-6 md:px-[7.5rem]">
      <h2 class="mb-[3.5rem] text-center font-display text-h3 font-semibold text-dark">
        Was passiert, nachdem du geschrieben hast
      </h2>
      <div class="grid grid-cols-3 gap-[2.5rem]">
        <div class="flex flex-col gap-4 overflow-hidden rounded-lg bg-dark px-[2.5rem] py-[3rem]">
          <span class="font-display text-h3 font-semibold text-orange">1</span>
          <p class="font-display text-[1.75rem] font-semibold text-cream">Ich melde mich</p>
          <p class="font-body text-small leading-[2] text-cream/90">Per Mail oder Telefon – so, wie du geschrieben hast. Du musst nichts weiter tun.</p>
        </div>
        <div class="flex flex-col gap-4 overflow-hidden rounded-lg bg-dark px-[2.5rem] py-[3rem]">
          <span class="font-display text-h3 font-semibold text-orange">2</span>
          <p class="font-display text-[1.75rem] font-semibold text-cream">Wir telefonieren kurz</p>
          <p class="font-body text-small leading-[2] text-cream/90">Rund 15 Minuten, unverbindlich. Du erzählst, was du dir vorstellst, ich höre zu und stelle Fragen.</p>
        </div>
        <div class="flex flex-col gap-4 overflow-hidden rounded-lg bg-dark px-[2.5rem] py-[3rem]">
          <span class="font-display text-h3 font-semibold text-orange">3</span>
          <p class="font-display text-[1.75rem] font-semibold text-cream">Entscheide später</p>
          <p class="font-body text-small leading-[2] text-cream/90">Kein Druck, keine Anzahlung. Wenn es nicht passt, ist das völlig in Ordnung.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 03 EVENT-REPORTAGE ===== -->

  <!-- Mobile: olive -->
  <section class="md:hidden bg-olive py-[52px] px-6 text-center">
    <h2 class="font-display text-[1.6875rem] leading-[1.28] font-semibold text-cream mb-[1.125rem]">
      Du brauchst eine Fotografin für eine Event-Reportage?
    </h2>
    <div class="font-body text-[1.0625rem] leading-[1.68] text-cream/90 mb-[1.5rem]">
      <p>Auch das mache ich liebend gerne.</p>
      <p>Gib mir Bescheid:</p>
      <p>Datum, Zeit, Anlass – und ich melde mich mit einer Offerte bei dir.</p>
    </div>
    <a
      href="/reportage"
      class="inline-flex items-center justify-center rounded-[1.0625rem] bg-beige px-md py-sm font-body text-cta uppercase text-cream"
    >
      Mehr zur Reportage
    </a>
  </section>

  <!-- Desktop: dark -->
  <section class="hidden md:block bg-dark py-xl">
    <div class="mx-auto flex max-w-inhalt flex-col items-center gap-6 px-6 text-center md:px-[7.5rem]">
      <h2 class="font-display text-h3 font-semibold text-cream">
        Du brauchst eine Fotografin<br />für eine Event-Reportage?
      </h2>
      <div class="font-body text-body leading-[2] text-cream/90">
        <p>Auch das mache ich liebend gerne.</p>
        <p>Gib mir Bescheid:</p>
        <p>Datum, Zeit, Anlass – und ich melde mich mit einer Offerte bei dir.</p>
      </div>
      <a
        href="/reportage"
        class="inline-flex items-center justify-center rounded-[1.0625rem] bg-beige px-md py-sm font-body text-cta uppercase text-cream transition-colors hover:bg-orange"
      >
        Mehr zur Reportage
      </a>
    </div>
  </section>

  <!-- ===== 04 KARTE ===== -->
  <section class="bg-cream-warm py-12 md:py-[3.75rem]">
    <div class="mx-auto max-w-inhalt px-6 md:px-[7.5rem]">
      <div id="map-container" class="relative overflow-hidden rounded-[0.75rem] border border-[#e0d4c2]">
        <div
          id="map-placeholder"
          class="flex flex-col items-center justify-center gap-3 bg-[#fffcfa] px-[2.5rem] py-[3.75rem] text-center"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-10 w-10 text-beige" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          <p class="font-display text-h4 font-semibold text-dark">Karte anzeigen</p>
          <p class="font-body text-[1rem] md:text-small leading-[2] text-dark">
            Beim Anzeigen wird eine Verbindung zu Google Maps aufgebaut.
          </p>
          <button
            id="map-load-btn"
            class="mt-2 inline-flex items-center justify-center rounded-[1.0625rem] bg-dark px-md py-sm font-body text-cta uppercase text-cream transition-colors hover:bg-rust"
          >
            Karte laden
          </button>
        </div>
      </div>
      <a
        href="https://maps.google.com/?q=Pfarrmattstrasse+9,+5014+Gretzenbach,+Schweiz"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-block font-body text-[1rem] md:text-body-klein leading-[1.7] text-[#b08257] transition-colors hover:text-rust"
      >
        Route berechnen
      </a>
    </div>
  </section>

  <script>
    const btn = document.getElementById('map-load-btn');
    const placeholder = document.getElementById('map-placeholder');
    const container = document.getElementById('map-container');

    btn?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src =
        'https://maps.google.com/maps?q=Pfarrmattstrasse+9,+5014+Gretzenbach,+Schweiz&output=embed&z=15';
      iframe.title = 'Standort Seraina Stettler auf Google Maps';
      iframe.width = '100%';
      iframe.height = '480';
      iframe.style.border = '0';
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('loading', 'lazy');
      iframe.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');

      placeholder?.remove();
      container?.appendChild(iframe);
    });
  </script>

  <!-- ===== 05 WO ICH FOTOGRAFIERE ===== -->
  <section class="bg-cream-warm py-12 md:py-[4.8125rem]">
    <div class="mx-auto flex max-w-inhalt flex-col items-center gap-6 md:gap-8 px-6 text-center md:px-[15rem]">
      <h2 class="font-display text-[1.6875rem] md:text-h3 leading-[1.28] md:leading-normal font-semibold text-dark">
        Wo ich fotografiere
      </h2>
      <div class="font-body text-[1.0625rem] md:text-body leading-[1.68] md:leading-[2] text-dark">
        <p>
          Ich fotografiere dort, wo du dich wohlfühlst – an deinem Lieblingsort, an einem
          besonderen, versteckten Platz oder einfach dort, wo du gerade bist. Es gibt keinen
          falschen Ort für ein gutes Bild.
        </p>
        <p class="mt-[2em]">
          Die Scheune-Shootings finden in Gretzenbach statt – wetterunabhängig, mit viel Holz
          und schönem Seitenlicht. In der Region Aareland (Gretzenbach, Olten, Aarau und
          Umgebung) sind die Fahrspesen bereits im Preis inbegriffen.
        </p>
        <p class="mt-[2em]">
          Weiter weg? Kein Problem – alles Weitere besprechen wir ganz individuell.
        </p>
      </div>
      <a
        href="/geschichten"
        class="inline-flex items-center justify-center rounded-[1.0625rem] bg-beige px-md py-sm font-body text-cta uppercase text-cream transition-colors hover:bg-orange"
      >
        Lass dich inspirieren
      </a>
    </div>
  </section>

  <!-- ===== GRUSS ===== -->
  <section class="relative overflow-hidden bg-rust py-12 md:py-[6rem] text-center">
    <div class="mx-auto max-w-inhalt px-6 md:px-[15rem]">
      <p class="font-display text-[1.6875rem] md:text-h2 leading-[1.28] md:leading-normal font-semibold text-cream">
        Ich freue mich auf dich!
      </p>
      <p class="mt-[2rem] md:mt-[3rem] font-display text-[3rem] md:text-[4.5rem] font-semibold italic leading-none text-cream">
        Seraina
      </p>
    </div>
  </section>

  <!-- Illustrationen (desktop only) -->
  <div class="hidden md:block">
    <DekoIllustration
      motiv="mohn"
      farbe={FARBEN.Hellgrün}
      breite={261}
      cssRotate={29}
      top={1361}
      seite="links"
      abstand={-157}
    />
    <DekoIllustration
      motiv="tulpe"
      farbe={FARBEN.Hellgrün}
      breite={220}
      cssRotate={23.4}
      top={2905}
      seite="links"
      abstand={-148}
    />
  </div>

  </div>

  <Footer />

</Base>
