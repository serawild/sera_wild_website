---
import Base from '../../layouts/Base.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import BildPicture from '../../components/BildPicture.astro';
import DekoIllustration from '../../components/DekoIllustration.astro';
import FotoStory from '../../components/FotoStory.astro';

const heroH1       = 'Die Geschichte von Sara';
const heroSubtitel = '«Sera hat eine super Stimmung geschaffen, sodass es mir leicht fiel, natürlich in die Kamera zu schauen.»';

const geschichteObenZitat = 'Die Frau auf den Bildern sollte dieselbe sein wie die im Beratungszimmer.';
const geschichteObenBold  = 'Sara berät Frauen zu ihrer Gesundheit. Ihre Kundinnen kennen sie als jemanden, der zuhört, erklärt und dabei lacht. Genau diese Frau sollte auf den Bildern zu sehen sein.';
const geschichteObenP1    = 'Ihr Geschäft wächst, und mit ihm der Bedarf: eine Website, die zeigt, wer da eigentlich berät. Bilder, die nicht nach Katalog aussehen, sondern nach ihr.';
const geschichteObenP2    = 'Wir haben uns Zeit genommen für das, was sie ausmacht – die Neugier auf den Körper, die Freude am Erklären, den Humor, der sich nicht abstellen lässt. Fotografiert haben wir dort, wo sie sowieso ist: in ihrer eigenen Küche und draussen im Wald bei Aarau.';

const fotostoryH2 = 'Alles begann mit der Frage: «Wie zeige ich auf Bildern, was meine Kundinnen längst an mir kennen?»';

const geschichteUntenZitat = 'Es war mir wichtig, dass in den Fotos meine Persönlichkeit zur Geltung kommt.';
const geschichteUntenBold  = 'Ich bin sehr happy mit den Fotos – sie zeigen mich genau so, wie mich meine besten Freunde jeweils erleben.';
const geschichteUntenP     = 'Der ganze Ablauf war klar strukturiert. Sera hat sich Zeit genommen, um vorher zu verstehen, was ich mir wünsche und wofür ich die Fotos brauche. Am Ende hatte ich eine tolle Auswahl an Bildern, die ich nun mit Freude für mein Business nutzen kann.';

const collageLabelText = 'AUS SARAS W-ERLÄBNIS';
const collageH2        = 'Ein Ausschnitt aus Saras Bilderreise';
const collageFotospots = 'Mit folgenden Fotospots: Saras eigene Küche · verschiedene Plätze im Wald bei Aarau';

const zitatText = 'Vertrauen entsteht nicht durch das perfekte Bild, sondern durch das erkennbare.';

const collageIds = Array.from({length: 14}, (_, i) => `sara-collage-${String(i + 1).padStart(2, '0')}`);
---

<Base
  title="Saras Geschichte — sera Wild"
  description="Sara berät Frauen zu ihrer Gesundheit und brauchte Bilder für ihre Website. Ihre Geschichte mit dem W-Erläbnis."
  noindex={true}
>

  <Navigation farbe="hell" />

  <!-- ===== HERO ===== -->

  <!-- Mobile -->
  <section class="relative md:hidden h-[43.75rem] overflow-hidden bg-olive">
    <BildPicture
      id="hero-sara"
      class="absolute inset-0 h-full w-full object-cover"
      mobil={true}
      loading="eager"
      fetchpriority="high"
      widths={[390, 780]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-black/35 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-10 left-6 max-w-[21rem]">
      <h1 class="font-display text-[1.9375rem] leading-[1.3] font-semibold text-cream">{heroH1}</h1>
      <p class="font-body text-[1.125rem] leading-[1.6] text-cream mt-[0.5rem]">{heroSubtitel}</p>
    </div>
  </section>

  <!-- Desktop -->
  <section class="hidden md:block relative h-[100svh] min-h-[600px] overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <BildPicture
        id="hero-sara"
        class="absolute inset-0 h-full w-full object-cover object-[40%_50%] scale-[1.1] origin-[0%_50%]"
        loading="eager"
        fetchpriority="high"
        widths={[768, 1280, 1728, 2560]}
        sizes="100vw"
      />
    </div>
    <div class="absolute inset-0 bg-black/40 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-[10rem] right-[7.5rem] flex max-w-[74.875rem] flex-col items-end text-right">
      <h1 class="font-display text-h1 font-semibold leading-normal text-cream">{heroH1}</h1>
      <p class="font-display text-h2 font-semibold leading-normal text-cream max-w-[54rem]">{heroSubtitel}</p>
    </div>
  </section>

  <!-- ===== 01 GESCHICHTE OBEN ===== -->
  <!-- cream bg both versions — one section, responsive layout -->
  <section class="relative isolate overflow-visible bg-cream-warm py-12 md:py-xl px-6 md:px-0">
    <div class="hidden md:block"><DekoIllustration motiv="tulpe" farbe="#5B5C4F" breite={220} cssRotate={39.8} top={919} seite="links" abstand={-119} /></div>
    <DekoIllustration motiv="tulpe" farbe="#A0886D" breite={186} cssRotate={-27} obenAbAnkerAnteil={0.16} seite="rechts" abstand={-86} mobil={true} deckkraft={0.6} />
    <div class="mx-auto max-w-inhalt flex flex-col gap-[2.5rem] md:flex-row md:items-center md:gap-[5rem]">
      <!-- Bild -->
      <div class="w-full shrink-0 overflow-hidden md:hidden" style="aspect-ratio:342/456;">
        <BildPicture id="sara-geschichte-oben" class="h-full w-full object-cover" widths={[342,684]} sizes="100vw" />
      </div>
      <div class="hidden md:block h-[46.25rem] w-[35rem] shrink-0 overflow-hidden">
        <BildPicture id="sara-geschichte-oben" class="h-full w-full object-cover" widths={[560,1120]} sizes="560px" />
      </div>
      <!-- Text -->
      <div class="flex flex-1 min-w-0 flex-col gap-[1.5rem]">
        <p class="font-display text-[1.6875rem] md:text-h2 font-semibold italic leading-[1.28] md:leading-normal">{geschichteObenZitat}</p>
        <p class="font-body text-[1.0625rem] md:text-body font-bold leading-[1.68] md:leading-[1.65]">{geschichteObenBold}</p>
        <p class="font-body text-[1.0625rem] md:text-body leading-[1.68] md:leading-[1.65] md:mt-[2em]">{geschichteObenP1}</p>
        <p class="font-body text-[1.0625rem] md:text-body leading-[1.68] md:leading-[1.65]">{geschichteObenP2}</p>
      </div>
    </div>
  </section>

  <!-- ===== 02 FOTO-STORY ===== -->
  <!-- dark bg both — one section, two inner blocks -->
  <section class="relative isolate bg-dark py-12 md:py-xl">
    <DekoIllustration motiv="mohn" farbe="#5B5C4F" breite={162} cssRotate={21} obenAbAnkerAnteil={0.16} seite="links" abstand={-75} mobil={true} deckkraft={0.6} />

    <!-- Mobile inner -->
    <div class="md:hidden px-6 flex flex-col gap-[1.125rem]">
      <div class="flex items-center gap-2 mb-[0.375rem]">
        <span class="font-body text-xs font-bold uppercase tracking-[0.08em] text-cream/50">02</span>
        <span class="w-5 h-px bg-cream/50"></span>
        <span class="font-body text-xs uppercase tracking-[0.08em] text-cream/50">FOTO-STORY</span>
      </div>
      <h2 class="font-display text-[1.6875rem] leading-[1.28] font-semibold text-cream">{fotostoryH2}</h2>
    </div>
    <!-- Wischleiste (mobile) -->
    <div
      class="md:hidden mt-[1.25rem] overflow-x-auto"
      id="sara-fotostory-track"
      style="scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;"
    >
      <div class="flex gap-3 px-6" style="width:max-content;">
        {['sara-fotostory-01','sara-fotostory-02','sara-fotostory-03'].map(id => (
          <div class="shrink-0" style="scroll-snap-align:start;width:16.25rem;height:21.25rem;overflow:hidden;position:relative;">
            <BildPicture id={id} class="absolute inset-0 h-full w-full object-cover" mobil={true} widths={[260,520]} sizes="260px" />
          </div>
        ))}
        <div class="shrink-0 w-3" aria-hidden="true"></div>
      </div>
    </div>
    <div class="md:hidden flex justify-center gap-[0.5rem] mt-[1.25rem]">
      {Array.from({length: 3}, (_, i) => (
        <span class={`sara-fotostory-dot h-[0.375rem] w-[0.375rem] rounded-full bg-cream transition-opacity ${i === 0 ? 'opacity-100' : 'opacity-30'}`}></span>
      ))}
    </div>
    <div class="md:hidden px-6 mt-[1.5rem]">
      <a href="/w-erlaebnis" class="inline-flex items-center justify-center rounded-[1.0625rem] bg-cream px-md py-sm font-body text-cta uppercase text-dark">
        zum Angebot
      </a>
    </div>

    <!-- Desktop inner -->
    <div class="hidden md:block">
      <div class="mx-auto max-w-inhalt px-[7.5rem] flex justify-center">
        <h2 class="font-display text-h2 font-semibold leading-[1.4] max-w-[62.5rem] text-center text-cream">{fotostoryH2}</h2>
      </div>
      <div class="mt-[3rem]">
        <FotoStory id1="sara-fotostory-01" id2="sara-fotostory-02" id3="sara-fotostory-03" />
      </div>
      <div class="mx-auto max-w-inhalt px-[7.5rem] mt-[3rem] flex justify-center">
        <a href="/w-erlaebnis" class="rounded-[17px] bg-cream px-md py-sm font-body text-small font-medium uppercase tracking-[1.5px] text-dark">
          zum Angebot
        </a>
      </div>
    </div>

  </section>

  <!-- ===== 03 WAS GEBLIEBEN IST ===== -->
  <!-- cream-warm bg both — one section, two inner blocks -->
  <section class="relative isolate overflow-visible bg-cream-warm py-12 md:py-xl px-6 md:px-0">
    <DekoIllustration motiv="eukalyptus" farbe="#A0886D" breite={140} cssRotate={-33} obenAbAnkerAnteil={0.16} seite="rechts" abstand={-64} mobil={true} deckkraft={0.6} />

    <!-- Mobile inner: text then Bildgruppe -->
    <div class="md:hidden flex flex-col gap-[1.125rem]">
      <div class="flex items-center gap-2 mb-[0.375rem]">
        <span class="font-body text-xs font-bold uppercase tracking-[0.08em] text-dark/50">03</span>
        <span class="w-5 h-px bg-dark/50"></span>
        <span class="font-body text-xs uppercase tracking-[0.08em] text-dark/50">WAS GEBLIEBEN IST</span>
      </div>
      <p class="font-display text-[1.6875rem] leading-[1.28] font-semibold italic">{geschichteUntenZitat}</p>
      <p class="font-body text-[1.0625rem] leading-[1.68] font-bold">{geschichteUntenBold}</p>
      <p class="font-body text-[1.0625rem] leading-[1.68]">{geschichteUntenP}</p>
    </div>
    <!-- Bildgruppe mobile: gross oben links, klein unten rechts -->
    <div class="md:hidden relative mx-auto mt-[1.5rem]" style="width:342px;height:322px;">
      <div class="absolute overflow-hidden" style="left:0;top:0;width:214px;height:286px;">
        <BildPicture id="sara-geschichte-unten-01" class="h-full w-full object-cover" mobil={true} widths={[214,428]} sizes="214px" />
      </div>
      <div class="absolute overflow-hidden" style="left:164px;top:84px;width:178px;height:238px;">
        <BildPicture id="sara-geschichte-unten-02" class="h-full w-full object-cover" mobil={true} widths={[178,356]} sizes="178px" />
      </div>
    </div>

    <!-- Desktop inner: text + collage -->
    <div class="hidden md:block">
      <DekoIllustration motiv="eukalyptus" farbe="#BC541F" breite={305} cssRotate={-30} top={644} seite="rechts" abstand={-181} />
      <div class="mx-auto flex max-w-inhalt items-end gap-[5rem]">
        <div class="flex flex-1 min-w-0 flex-col gap-[1.5rem]">
          <p class="font-display text-h2 font-semibold italic leading-normal">{geschichteUntenZitat}</p>
          <p class="font-body text-body font-bold leading-[1.65]">{geschichteUntenBold}</p>
          <p class="font-body text-body leading-[1.65]">{geschichteUntenP}</p>
        </div>
        <div class="relative h-[38.75rem] w-[35rem] shrink-0">
          <div class="absolute h-[33.75rem] w-[23.75rem]" style="left:0;top:5rem;">
            <BildPicture id="sara-geschichte-unten-01" class="h-full w-full object-cover" />
          </div>
          <div class="absolute h-[23.75rem] w-[16.25rem]" style="left:17.5rem;top:0;">
            <BildPicture id="sara-geschichte-unten-02" class="h-full w-full object-cover" />
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- ===== 04 COLLAGE ===== -->

  <!-- Mobile: olive -->
  <section class="relative isolate md:hidden bg-olive py-[52px]">
    <DekoIllustration motiv="blattzweig" farbe="#5B5C4F" breite={122} cssRotate={15} obenAbAnkerAnteil={0.16} seite="links" abstand={-56} mobil={true} deckkraft={0.6} />
    <div class="px-6 flex flex-col items-center gap-[0.75rem] text-center mb-[1.25rem]">
      <p class="font-body text-xs uppercase tracking-[1.28px] text-cream/50">{collageLabelText}</p>
      <h2 class="font-display text-[1.6875rem] leading-[1.28] font-semibold text-cream">{collageH2}</h2>
      <p class="font-body text-[1rem] leading-[1.65] text-cream/70">{collageFotospots}</p>
    </div>
    <!-- Wischleiste 220×290 -->
    <div
      class="overflow-x-auto"
      id="collage-track"
      style="scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;"
    >
      <div class="flex gap-3 px-6" style="width:max-content;">
        {collageIds.map(id => (
          <div class="shrink-0" style="scroll-snap-align:start;width:13.75rem;height:18.125rem;overflow:hidden;position:relative;">
            <BildPicture id={id} class="absolute inset-0 h-full w-full object-cover" mobil={true} widths={[220,440]} sizes="220px" />
          </div>
        ))}
        <div class="shrink-0 w-3" aria-hidden="true"></div>
      </div>
    </div>
    <!-- Dots -->
    <div class="flex justify-center gap-[0.375rem] mt-[1.25rem] flex-wrap px-6">
      {collageIds.map((_, i) => (
        <span class={`collage-dot h-[0.3125rem] w-[0.3125rem] rounded-full bg-cream transition-opacity ${i === 0 ? 'opacity-100' : 'opacity-20'}`}></span>
      ))}
    </div>
  </section>

  <!-- Desktop: cream-warm -->
  <section class="hidden md:block bg-cream-warm py-[5.5rem] px-[7.5rem]">
    <div class="mx-auto flex max-w-inhalt flex-col gap-[3rem]">
      <div class="flex flex-col items-center gap-[1.125rem] px-[15rem] text-center">
        <p class="font-body text-[1rem] uppercase tracking-[1.28px] text-orange">{collageLabelText}</p>
        <h2 class="font-display text-h2 font-semibold text-dark">{collageH2}</h2>
        <p class="font-body text-body-klein leading-[1.7] text-[#5b5c4f]">{collageFotospots}</p>
      </div>
      <div class="flex flex-col gap-[1.25rem]">
        <div class="flex gap-[1.25rem]">
          {collageIds.slice(0,4).map(id => (
            <div class="flex-1"><BildPicture id={id} class="h-[29.75rem] w-full object-cover rounded-[3px]" /></div>
          ))}
        </div>
        <div class="flex gap-[1.25rem]">
          <div class="basis-[49.25rem] shrink-0"><BildPicture id="sara-collage-05" class="h-[27.5rem] w-full object-cover rounded-[3px]" /></div>
          <div class="basis-[20.625rem] shrink-0"><BildPicture id="sara-collage-06" class="h-[27.5rem] w-full object-cover rounded-[3px]" /></div>
          <div class="basis-[20.625rem] shrink-0"><BildPicture id="sara-collage-07" class="h-[27.5rem] w-full object-cover rounded-[3px]" /></div>
        </div>
        <div class="flex gap-[1.25rem]">
          <div class="basis-[41.75rem] shrink-0"><BildPicture id="sara-collage-08" class="h-[31.25rem] w-full object-cover rounded-[3px]" /></div>
          <div class="basis-[24.375rem] shrink-0"><BildPicture id="sara-collage-09" class="h-[31.25rem] w-full object-cover rounded-[3px]" /></div>
          <div class="basis-[24.375rem] shrink-0"><BildPicture id="sara-collage-10" class="h-[31.25rem] w-full object-cover rounded-[3px]" /></div>
        </div>
        <div class="flex gap-[1.25rem]">
          <div class="basis-[39.375rem] shrink-0"><BildPicture id="sara-collage-11" class="h-[26.25rem] w-full object-cover rounded-[3px]" /></div>
          <div class="basis-[16.625rem] shrink-0"><BildPicture id="sara-collage-12" class="h-[26.25rem] w-full object-cover rounded-[3px]" /></div>
          <div class="basis-[16.625rem] shrink-0"><BildPicture id="sara-collage-13" class="h-[26.25rem] w-full object-cover rounded-[3px]" /></div>
          <div class="basis-[16.625rem] shrink-0"><BildPicture id="sara-collage-14" class="h-[26.25rem] w-full object-cover rounded-[3px]" /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ZITAT ===== -->

  <!-- Mobile: rust -->
  <section class="md:hidden bg-rust py-12 px-6">
    <p class="text-center font-display text-[1.6875rem] leading-[1.28] font-semibold text-cream">{zitatText}</p>
  </section>

  <!-- Desktop: dark -->
  <section class="hidden md:block bg-dark py-xl px-[7.5rem]">
    <div class="mx-auto max-w-inhalt text-center">
      <h2 class="font-display text-h2 font-semibold leading-normal text-cream/90">{zitatText}</h2>
    </div>
  </section>

  <!-- ===== VERWEIS AUF SARAS WEBSITE ===== -->
  <section class="bg-cream-warm px-6 py-10 md:px-[7.5rem] md:py-[3.5rem]">
    <div class="mx-auto max-w-inhalt text-center">
      <p class="font-body text-[1rem] leading-[1.7] text-dark/70 md:text-body-klein">
        Sara berät Frauen zu ihrer Gesundheit —{' '}
        <a
          href="https://baravital.ch"
          target="_blank"
          rel="noopener"
          class="underline underline-offset-4 decoration-1 transition-colors hover:text-orange"
        >baravital.ch</a>
      </p>
    </div>
  </section>

  <Footer />

</Base>

<script>
document.addEventListener('DOMContentLoaded', () => {
  function setupTrack(trackId, dotClass, cardW) {
    const track = document.getElementById(trackId);
    const dots = document.querySelectorAll('.' + dotClass);
    if (!track || !dots.length) return;
    track.addEventListener('scroll', () => {
      const idx = Math.min(Math.round(track.scrollLeft / cardW), dots.length - 1);
      dots.forEach((d, i) => {
        d.classList.toggle('opacity-100', i === idx);
        d.classList.toggle('opacity-20', i !== idx);
      });
    });
  }
  setupTrack('sara-fotostory-track', 'sara-fotostory-dot', 272);
  setupTrack('collage-track', 'collage-dot', 220 + 12);
});
</script>
