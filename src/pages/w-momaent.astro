<script>
document.addEventListener('DOMContentLoaded', () => {
  const track = document.getElementById('kulissen-track');
  const dots = document.querySelectorAll('.kulissen-dot');
  if (!track || !dots.length) return;
  track.addEventListener('scroll', () => {
    const cardWidth = 260 + 12;
    const idx = Math.min(Math.round(track.scrollLeft / cardWidth), dots.length - 1);
    dots.forEach((d, i) => {
      d.classList.toggle('opacity-100', i === idx);
      d.classList.toggle('opacity-30', i !== idx);
    });
  });
});
</script>
