---
import logoDark  from '../assets/logo-primary-dark.svg';
import logoWhite from '../assets/logo-primary-white.svg';

interface MenuItem {
  label: string;
  href: string;
  matchPaths: string[];
  submenu?: Array<{ label: string; href: string }>;
}

const menu: MenuItem[] = [
  {
    label: 'Angebot',
    href: '/w-erlaebnis',
    matchPaths: ['/w-erlaebnis', '/w-momaent'],
    submenu: [
      { label: 'W-Erläbnis', href: '/w-erlaebnis' },
      { label: 'W-Momänt',   href: '/w-momaent' },
    ],
  },
  {
    label: 'Geschichten',
    href: '/geschichten',
    matchPaths: ['/geschichten'],
    submenu: [
      { label: 'Simonas Geschichte', href: '/geschichten/simona' },
    ],
  },
  {
    label: 'Sera Wild',
    href: '/ueber',
    matchPaths: ['/ueber'],
    submenu: [],
  },
];

interface Props {
  farbe?: 'hell' | 'dunkel';
}
const { farbe = 'hell' } = Astro.props;

const MOHN_PATH = 'M129 414C128 414 130 402 132 388C140 341 138 328 117 287C90 232 85 200 94 130C97 106 94 102 78 106C61 109 36 100 38 90L39 87L33 87C2 85 -13 43 14 35C18 34 18 34 18 29C18 22 22 17 28 17C34 17 35 16 39 11C44 5 56 1 64 4C68 5 70 5 72 4C77 2 80 3 84 6L88 8L91 6C101 -1 108 -2 119 4C127 7 130 8 138 6C147 4 158 10 160 18C160 21 160 21 165 21C188 17 196 47 177 63C173 66 169 70 168 72C166 77 163 79 157 80C153 80 152 80 150 85C147 95 132 102 116 102C103 102 99 106 99 118C99 122 98 133 97 144C89 205 91 221 116 274C121 285 126 296 126 297C128 301 128 298 127 287C126 280 126 267 126 258C126 242 126 240 124 238C117 229 111 183 116 177C122 172 129 218 123 224C122 225 122 227 123 229C125 235 126 234 126 225C126 217 129 206 133 196C136 189 136 187 132 176C126 161 126 157 128 146C128 141 129 136 129 136C129 133 132 136 134 140C138 149 140 164 137 177C137 182 138 182 141 177C142 175 145 170 147 166C152 158 152 158 153 147C154 130 157 122 164 113C174 102 174 112 164 138C162 144 160 149 160 149C160 150 163 147 167 144C175 137 183 132 195 124C209 116 215 112 223 104C230 97 257 82 259 84C261 86 259 89 253 94C250 97 248 99 249 99C254 97 259 97 259 98C259 103 245 110 232 111C227 112 222 112 220 113C219 113 214 115 209 118C201 123 199 126 203 125C214 122 233 121 233 123C233 128 218 133 199 134C180 135 180 135 168 147L158 157L170 152C185 144 187 144 181 153C177 158 171 162 157 169C144 175 145 175 141 183C136 190 136 192 140 189C145 184 147 186 145 196C143 203 140 209 134 215L128 220L128 235C128 253 128 253 133 241C142 216 157 194 163 197C169 199 162 214 153 221C128 241 125 262 136 320C142 351 142 362 137 390C133 409 130 417 129 414ZM152 219C159 211 164 202 161 202C158 202 144 219 141 226C140 229 145 226 152 219ZM122 205C121 192 120 185 118 185C117 185 117 199 118 207C121 227 124 225 122 205ZM141 202C143 196 144 190 142 190C138 191 132 203 131 212L130 216L134 211C136 209 139 204 141 202ZM136 161C135 144 131 137 130 151C130 157 130 161 132 167C135 177 137 174 136 161ZM159 164C167 160 175 155 175 153C175 152 172 154 168 156C165 158 160 160 158 160C155 161 153 163 152 165C149 169 149 169 159 164ZM161 138C165 127 168 116 167 116C163 116 157 131 156 142C156 151 157 150 161 138ZM209 130C219 129 226 127 226 125C226 123 200 127 194 129L190 131L195 131C197 131 203 131 209 130ZM243 106C246 105 250 103 252 102L256 100L251 101C245 101 230 107 229 108C227 110 236 109 243 106ZM253 92C258 86 257 86 244 93C232 99 226 104 227 105C227 106 248 96 253 92ZM98 94C97 79 100 73 118 53L123 47L119 47C110 49 103 56 99 69L97 76L97 71C99 57 108 48 123 45C149 39 163 25 154 15C150 10 145 9 138 10C129 12 125 11 121 9C113 3 104 2 96 7C90 10 90 10 93 17C96 23 96 36 94 47C92 56 91 76 94 86C94 89 95 94 96 95C96 99 94 99 93 96C92 94 91 93 90 93C89 93 87 92 86 91C84 90 77 85 70 81C55 70 45 61 40 53C37 47 34 45 29 45C28 45 25 44 22 41C17 37 14 37 11 41C1 51 2 63 12 73C19 81 26 83 46 84C57 85 64 87 76 94C81 97 86 99 88 100C90 100 93 101 94 103C98 106 98 106 98 94ZM81 101C83 99 60 89 52 88C41 88 39 91 48 97C57 103 77 105 81 101ZM107 94C115 85 124 81 146 78C163 76 162 76 166 70C167 66 170 64 174 61C190 49 186 24 169 24C162 24 162 25 158 30C153 37 148 40 137 43C127 45 126 47 115 60C106 71 101 81 100 90C99 100 101 101 107 94ZM136 93C144 89 146 88 147 85L148 81L143 81C134 81 120 86 112 93C102 101 120 102 136 93ZM87 83C87 80 85 73 83 66C80 55 80 52 79 39L79 24L82 17L85 11L83 9C80 7 79 7 72 8C67 10 66 10 63 8C57 5 46 9 41 16C39 20 39 20 33 20C25 20 22 22 21 29C20 38 26 42 42 44C61 46 69 53 78 75C83 88 87 92 87 83ZM75 73C67 55 57 47 44 47C39 47 39 48 44 54C51 62 76 84 80 84C80 84 78 79 75 73ZM92 36C93 26 91 14 88 15C81 17 80 44 86 62L87 66L89 55C90 49 91 40 92 36Z';

const W_MARK_PATH = 'M881.4,117.35c282.95,21.85,598.33,247.43,856,154.88,4.73-1.7,7.95-6.11,8.15-11.14.69-17.3-1.88-60.18-6.11-69.29-2.38-5.13-9.54-5.9-14.62-3.43-188.71,91.8-623.66-133.23-831.73-151.36-124.72-10.86-179.85,31.53-213.39,154.86-32.8,120.6-157.59,618.16-201.63,788.23-5.65,21.82-9.92,15.23-9.92,15.23-19.82-23.76-34.89-483.1-45.26-513.63-.68-2.01-10.13-25.66-27.07-10.46-11.23,10.08-60.87,52.27-79.74,67.1-5.12,4.02-8.6,9.56-10.77,15.81,0,0-76.99,237.1-102.29,279.14-7.09,10.84-21.74,15.31-29.98,1.32-28.86-49,3.34-527.09,3.34-527.09,0,0,4.11-64.62-17.8-64.82-19.95-.18-90.94,73.97-119.74,94.43-4.53,3.22-7.36,8.9-3.56,16.51,4.67,9.38,37.18-8.33,32.36,188.34-2.47,100.99-23.62,418.02,19.61,454.73,18,15.28,50.21,15.87,74.51-4.17,75.84-62.54,157.07-334.88,169.23-360.7,6.06-12.9,19.82-5.8,19.7,4.87,12.28,155.86,21.46,379.45,32.15,469.48,12.29,103.53,28.71,126.98,66.89,126.98s66.01-23.21,88.51-111.77c81.99-322.71,112.53-465.65,154.17-641.85,72.17-305.42,95.16-369.45,188.98-362.2Z';

const rawPath = Astro.url.pathname;
const pathname = rawPath === '/' ? '/' : rawPath.replace(/\/$/, '');

function isTopActive(item: MenuItem): boolean {
  return item.matchPaths.some(
    (p) => pathname === p || pathname.startsWith(p + '/')
  );
}
function isExactActive(href: string): boolean {
  return pathname === (href === '/' ? '/' : href.replace(/\/$/, ''));
}
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50"
  data-farbe={farbe}
  data-logo-light={logoWhite.src}
  data-logo-dark={logoDark.src}
>
  <div class="mx-auto flex h-full max-w-content items-center justify-between px-6 md:px-[7.5rem]">

    <!-- Logo -->
    <a href="/" aria-label="sera Wild – Startseite" class="shrink-0">
      <img
        id="site-logo"
        src={farbe === 'hell' ? logoWhite.src : logoDark.src}
        alt="sera Wild – prozessorientierte Fotografie"
        class="w-auto"
        width={logoWhite.width}
        height={logoWhite.height}
      />
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="Hauptnavigation" class="hidden items-center gap-[3.75rem] md:flex">
      <ul class="flex items-center gap-[3.75rem]" role="list">
        {menu.map((item) => {
          const topActive  = isTopActive(item);
          const exactMatch = isExactActive(item.href);
          const hasSub     = (item.submenu?.length ?? 0) > 0;
          return (
            <li class="relative" data-nav-item>
              <a
                href={item.href}
                class:list={['nav-main-link relative flex items-center gap-[0.375rem] font-body text-cta uppercase', topActive && 'nav-active']}
                aria-expanded={hasSub ? 'false' : undefined}
                aria-current={exactMatch ? 'page' : undefined}
              >
                <span>{item.label}</span>

                {topActive && (
                  <svg class="nav-blume absolute -top-[1.4375rem] left-full h-[3.75rem] w-[2.375rem] shrink-0" viewBox="0 0 260 415" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d={MOHN_PATH} />
                  </svg>
                )}

                {hasSub && (
                  <svg class="nav-chevron h-[0.875rem] w-[0.875rem] shrink-0 transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6l4 4 4-4"/>
                  </svg>
                )}
              </a>

              {hasSub && (
                <ul class="nav-submenu absolute left-0 top-full min-w-[13rem] w-max py-[0.375rem] border-t border-[rgba(160,136,109,0.35)]" role="list">
                  {item.submenu!.map((sub) => {
                    const subExact = isExactActive(sub.href);
                    return (
                      <li>
                        <a
                          href={sub.href}
                          class:list={['block whitespace-nowrap px-[1.25rem] py-[0.5rem] font-body text-small text-cream/80 transition-colors hover:text-orange', subExact && 'text-orange hover:text-orange']}
                          aria-current={subExact ? 'page' : undefined}
                        >
                          {sub.label}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )}
            </li>
          );
        })}
      </ul>

      <a
        href="/kontakt"
        class="inline-flex items-center justify-center rounded-[1.0625rem] bg-rust px-md py-sm font-body text-cta uppercase text-cream transition-colors hover:bg-orange"
        aria-current={isExactActive('/kontakt') ? 'page' : undefined}
      >
        Kontakt
      </a>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="nav-open"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="nav-hamburger flex flex-col gap-[5px] p-2 md:hidden"
    >
      <span class="block h-[2px] w-6 bg-current"></span>
      <span class="block h-[2px] w-6 bg-current"></span>
      <span class="block h-[2px] w-6 bg-current"></span>
    </button>
  </div>
</header>

<!-- Mobile Vollbild-Dialog -->
<dialog
  id="mobile-nav"
  class="fixed inset-0 m-0 h-full max-h-full w-full max-w-full overflow-hidden bg-dark p-0 text-cream backdrop:bg-dark/80"
>
  <!-- W Wasserzeichen -->
  <svg
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1765.27 1262.84"
    fill="currentColor"
    style="position:absolute;bottom:-60px;right:-80px;width:420px;height:auto;color:#F5F3ED;opacity:0.07;pointer-events:none;z-index:0"
  >
    <path d={W_MARK_PATH}/>
  </svg>

  <!-- Inhalt -->
  <div style="position:relative;z-index:1;display:flex;flex-direction:column;height:100%;overflow-y:auto">

    <!-- Kopfzeile -->
    <div style="display:flex;align-items:center;justify-content:space-between;padding:20px 24px;flex-shrink:0">
      <a href="/" aria-label="sera Wild – Startseite">
        <img src={logoWhite.src} alt="sera Wild" width={logoWhite.width} height={logoWhite.height} style="height:2.5rem;width:auto" />
      </a>
      <button
        id="nav-close"
        aria-label="Menü schliessen"
        style="width:40px;height:40px;display:flex;align-items:center;justify-content:center;color:#F5F3ED;background:none;border:none;cursor:pointer;flex-shrink:0"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:24px;height:24px" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Menüzeilen -->
    <nav aria-label="Mobile Navigation" style="flex-shrink:0">
      {menu.map((item, idx) => {
        const hasSub   = (item.submenu?.length ?? 0) > 0;
        const exactRow = isExactActive(item.href);
        const isLast   = idx === menu.length - 1;
        return (
          <div style={`border-top:1px solid rgba(160,136,109,0.28)${isLast ? ';border-bottom:1px solid rgba(160,136,109,0.28)' : ''}`}>
            <a
              href={item.href}
              aria-current={exactRow ? 'page' : undefined}
              style={`display:flex;align-items:center;justify-content:space-between;padding:16px 24px;text-decoration:none;color:${!hasSub && exactRow ? '#BC541F' : '#F5F3ED'}`}
            >
              <span style="display:flex;align-items:center;gap:16px">
                {item.label === 'Angebot' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:20px;height:20px;color:#A0886D;flex-shrink:0" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                  </svg>
                )}
                {item.label === 'Geschichten' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:20px;height:20px;color:#A0886D;flex-shrink:0" aria-hidden="true">
                    <rect x="3" y="5" width="9" height="14" rx="0.5" stroke-linejoin="round"/>
                    <rect x="12" y="5" width="9" height="14" rx="0.5" stroke-linejoin="round"/>
                    <line x1="14" y1="9" x2="19" y2="9" stroke-linecap="round"/>
                    <line x1="14" y1="12" x2="19" y2="12" stroke-linecap="round"/>
                    <line x1="14" y1="15" x2="19" y2="15" stroke-linecap="round"/>
                  </svg>
                )}
                {item.label === 'Sera Wild' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:20px;height:20px;color:#A0886D;flex-shrink:0" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
                  </svg>
                )}
                <span style="font-size:1.0625rem;letter-spacing:0.02em">{item.label}</span>
              </span>
              {hasSub && (
                <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" style="width:18px;height:18px;color:#A0886D;flex-shrink:0" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6l5 5 5-5"/>
                </svg>
              )}
            </a>
            {hasSub && (
              <div style="padding-left:58px;padding-bottom:14px;display:flex;flex-direction:column;gap:12px">
                {item.submenu!.map((sub) => {
                  const subExact = isExactActive(sub.href);
                  return (
                    <a
                      href={sub.href}
                      aria-current={subExact ? 'page' : undefined}
                      style={`font-size:0.9375rem;text-decoration:none;color:${subExact ? '#BC541F' : 'rgba(245,243,237,0.65)'}`}
                    >
                      {sub.label}
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        );
      })}
    </nav>

    <!-- Schreib mir -->
    <div style="margin-top:28px;padding:0 24px;flex-shrink:0">
      <a
        href="/kontakt"
        style="display:inline-flex;align-items:center;gap:8px;background:#983515;color:#F5F3ED;border-radius:8px;padding:15px 28px;font-size:0.875rem;text-transform:uppercase;letter-spacing:0.1em;text-decoration:none"
      >
        Schreib mir
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:16px;height:16px;flex-shrink:0" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15M15 6l6 6-6 6"/>
        </svg>
      </a>
    </div>

    <!-- Footer -->
    <div style="margin-top:auto;padding:40px 24px 48px;flex-shrink:0">
      <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:20px">
        <a href="tel:+41797905701" style="font-size:0.9375rem;color:rgba(245,243,237,0.75);text-decoration:none">+41 79 790 57 01</a>
        <a href="mailto:info@serawild.com" style="font-size:0.9375rem;color:rgba(245,243,237,0.75);text-decoration:none">info@serawild.com</a>
      </div>
      <div style="font-size:0.75rem;color:#A0886D">
        <a href="/datenschutz" style="color:inherit;text-decoration:none">Datenschutz</a>
        {' · '}
        <a href="/impressum" style="color:inherit;text-decoration:none">Impressum</a>
        {' · '}
        <a href="/agb" style="color:inherit;text-decoration:none">AGB</a>
      </div>
    </div>

  </div>
</dialog>

<style>
  /* ── Höhe ── */
  #site-header {
    height: 5rem;
    background-color: transparent;
    transition: background-color 250ms ease, backdrop-filter 250ms ease, height 250ms ease;
  }
  #site-header.nav-scrolled {
    background-color: rgba(47, 50, 45, 0.5);
    backdrop-filter: blur(8px);
  }
  @media (min-width: 768px) {
    #site-header          { height: 10rem; }
    #site-header.nav-scrolled { height: 6rem; }
  }

  /* ── Logo-Höhe ── */
  #site-logo {
    height: 2.5rem;
    transition: height 250ms ease;
  }
  @media (min-width: 768px) {
    #site-logo { height: 4.5rem; }
    #site-header.nav-scrolled #site-logo { height: 3rem; }
  }

  /* ── Link-Farben ── */
  .nav-main-link { color: #F5F3ED; }
  [data-farbe="dunkel"] .nav-main-link { color: #2F322D; }
  #site-header.nav-scrolled .nav-main-link { color: #F5F3ED; }
  .nav-main-link:hover { color: #BC541F; }

  /* ── Hamburger-Farbe ── */
  .nav-hamburger { color: #F5F3ED; }
  [data-farbe="dunkel"] .nav-hamburger { color: #2F322D; }
  #site-header.nav-scrolled .nav-hamburger { color: #F5F3ED; }

  /* ── Aktive Unterstreichung ── */
  .nav-main-link.nav-active > span {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  /* ── Untermenü: verborgen → sichtbar ── */
  .nav-submenu {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease, visibility 0s linear 150ms;
    background-color: rgba(47, 50, 45, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  @supports not (backdrop-filter: blur(10px)) {
    .nav-submenu { background-color: rgba(47, 50, 45, 0.94); }
  }
  [data-nav-item].nav-open .nav-submenu {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 150ms ease, visibility 0s linear 0s;
  }

  /* ── Chevron-Drehung ── */
  [data-nav-item].nav-open .nav-chevron { transform: rotate(180deg); }

  /* ── Kein Übergang bei prefers-reduced-motion ── */
  @media (prefers-reduced-motion: reduce) {
    #site-header,
    #site-logo,
    .nav-submenu,
    .nav-chevron {
      transition: none !important;
    }
  }
</style>

<script>
  /* ── Mobile: Dialog öffnen/schliessen ── */
  const openBtn  = document.getElementById('nav-open')  as HTMLButtonElement | null;
  const closeBtn = document.getElementById('nav-close') as HTMLButtonElement | null;
  const dialog   = document.getElementById('mobile-nav') as HTMLDialogElement | null;

  function openMobile() {
    dialog?.showModal();
    openBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMobile() {
    dialog?.close();
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  openBtn?.addEventListener('click', openMobile);
  closeBtn?.addEventListener('click', closeMobile);
  dialog?.addEventListener('close', () => {
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  });
  // Klick neben Dialog-Inhalt schliesst
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) closeMobile();
  });

  /* ── Desktop: Untermenüs ── */
  const header   = document.getElementById('site-header') as HTMLElement | null;
  const navItems = Array.from(header?.querySelectorAll<HTMLLIElement>('[data-nav-item]') ?? []);

  function openSubmenu(item: HTMLLIElement) {
    item.classList.add('nav-open');
    item.querySelector<HTMLElement>('[aria-expanded]')?.setAttribute('aria-expanded', 'true');
  }
  function closeSubmenu(item: HTMLLIElement) {
    item.classList.remove('nav-open');
    item.querySelector<HTMLElement>('[aria-expanded]')?.setAttribute('aria-expanded', 'false');
  }
  function closeAll() { navItems.forEach(closeSubmenu); }

  navItems.forEach((item) => {
    const submenu = item.querySelector('.nav-submenu');
    if (!submenu) return;

    let closeTimer: ReturnType<typeof setTimeout>;

    /* Hover mit 200 ms Schliess-Verzögerung */
    item.addEventListener('mouseenter', () => {
      clearTimeout(closeTimer);
      closeAll();
      openSubmenu(item);
    });
    item.addEventListener('mouseleave', () => {
      closeTimer = setTimeout(() => closeSubmenu(item), 200);
    });
    submenu.addEventListener('mouseenter', () => clearTimeout(closeTimer));
    submenu.addEventListener('mouseleave', () => {
      closeTimer = setTimeout(() => closeSubmenu(item), 200);
    });

    /* Tastatur: öffnet bei Fokus, schliesst beim Verlassen der Gruppe */
    const parentLink = item.querySelector<HTMLElement>('[aria-expanded]');
    parentLink?.addEventListener('focus', () => { closeAll(); openSubmenu(item); });
    item.addEventListener('focusout', (e) => {
      if (!item.contains((e as FocusEvent).relatedTarget as Node | null)) {
        closeSubmenu(item);
      }
    });

    /* Touch: erstes Tippen öffnet, zweites folgt dem Link */
    parentLink?.addEventListener('click', (e) => {
      if (parentLink.getAttribute('aria-expanded') !== 'true') {
        e.preventDefault();
        closeAll();
        openSubmenu(item);
      }
    });
  });

  /* Escape schliesst alle Untermenüs */
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });

  /* ── Scroll: IntersectionObserver auf Sentinel ── */
  const logoEl   = document.getElementById('site-logo')   as HTMLImageElement | null;
  const farbe    = header?.dataset.farbe ?? 'hell';
  const logoLight = header?.dataset.logoLight ?? '';
  const logoDarkSrc = header?.dataset.logoDark ?? '';

  function applyScrolled(scrolled: boolean) {
    header?.classList.toggle('nav-scrolled', scrolled);
    if (logoEl) {
      logoEl.src = scrolled || farbe === 'hell' ? logoLight : logoDarkSrc;
    }
  }

  /* Sentinel bei 120 px: sichtbar beim Laden, verlässt Viewport nach 120 px Scroll */
  const sentinel = document.createElement('div');
  sentinel.setAttribute('aria-hidden', 'true');
  sentinel.style.cssText = 'position:absolute;top:120px;left:0;height:1px;width:1px;pointer-events:none;';
  document.body.prepend(sentinel);

  new IntersectionObserver(
    ([entry]) => applyScrolled(!entry.isIntersecting),
    { rootMargin: '0px', threshold: 0 }
  ).observe(sentinel);
</script>
