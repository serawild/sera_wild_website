---
/**
 * Platzhalter für noch fehlende Fotos (erster Durchgang der Startseite).
 * Wird später durch echte Bilder (astro:assets <Image />) ersetzt.
 */
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
  label?: string;
}
const { tone = 'light', class: className = '', label = 'Foto folgt' } = Astro.props;

const tones = {
  light: 'bg-olive/15 text-dark/40',
  dark: 'bg-cream/10 text-cream/40',
};
---

<div class:list={['flex items-center justify-center overflow-hidden rounded-lg', tones[tone], className]}>
  <span class="font-display text-body italic">{label}</span>
</div>
