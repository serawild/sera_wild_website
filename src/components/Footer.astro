---
import { Image } from 'astro:assets';
import logoDark from '../assets/logo-primary-dark.svg';
import flowerRust from '../assets/deco-flower-rust.png';

/**
 * Footer — responsiv nach Figma:
 *  - Desktop (node 13:258): Rechtslinks | Logo | Kontakt+LinkedIn, Mohn-Illu in der Ecke
 *  - Mobile  (node 85:1409): Logo, Kontakt+LinkedIn, dunkler Balken mit Rechtslinks, Mohn-Illu überlappend
 */
const legalLinks = [
  { label: 'Datenschutz', href: '/datenschutz' },
  { label: 'Impressum', href: '/impressum' },
  { label: 'AGB', href: '/agb' },
];

const phone = '+41 79 790 57 01';
const whatsappHref = 'https://wa.me/41797905701';
const email = 'info@serawild.com';
const linkedInUrl = 'https://www.linkedin.com/';
---

<footer class="relative overflow-hidden bg-cream text-dark">
  <!-- ===== Desktop ===== -->
  <div class="hidden md:grid md:grid-cols-3 md:items-center md:gap-md md:px-xl md:py-lg">
    <!-- Rechtslinks -->
    <nav aria-label="Rechtliches">
      <ul class="flex flex-col gap-sm">
        {
          legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-base uppercase tracking-wider underline underline-offset-4 transition-colors hover:text-rust"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Logo -->
    <div class="flex justify-center">
      <a href="/" aria-label="sera Wild – Startseite">
        <img src={logoDark.src} alt="sera Wild – prozessorientierte Fotografie" class="w-[22rem] max-w-full" />
      </a>
    </div>

    <!-- Kontakt + LinkedIn -->
    <div class="flex flex-col items-end gap-sm text-right">
      <a
        href={linkedInUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="inline-flex h-11 w-11 items-center justify-center rounded-md bg-dark text-cream transition-colors hover:bg-rust"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M4.98 3.5a2.5 2.5 0 1 1 0 5.001 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.83v1.64h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.56 4.78 5.9V21h-4v-5.9c0-1.41-.03-3.22-2-3.22-2 0-2.31 1.53-2.31 3.11V21h-4V9Z"
          ></path>
        </svg>
      </a>
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`WhatsApp: ${phone}`}
        class="inline-flex items-center gap-xs font-display text-2xl transition-colors hover:text-rust"
      >
        <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M17.5 14.38c-.28-.14-1.65-.81-1.9-.9-.26-.1-.44-.14-.63.14-.18.28-.72.9-.88 1.08-.16.18-.32.2-.6.07-.28-.14-1.17-.43-2.23-1.38-.83-.73-1.38-1.64-1.54-1.92-.16-.28-.02-.43.12-.57.13-.13.28-.32.42-.49.14-.16.18-.28.28-.46.09-.18.05-.35-.02-.49-.07-.14-.63-1.51-.86-2.07-.23-.54-.46-.47-.63-.48h-.54c-.18 0-.47.07-.72.35-.25.28-.95.93-.95 2.26 0 1.33.97 2.62 1.1 2.8.14.18 1.92 2.93 4.65 4.11.65.28 1.16.45 1.56.58.65.21 1.25.18 1.72.11.53-.08 1.65-.67 1.88-1.32.23-.65.23-1.2.16-1.32-.07-.11-.25-.18-.53-.32zM12 2a10 10 0 0 0-8.53 15.3L2 22l4.8-1.26A10 10 0 1 0 12 2zm0 18.18a8.16 8.16 0 0 1-4.16-1.14l-.3-.18-2.95.78.79-2.88-.2-.3A8.18 8.18 0 1 1 12 20.18z"
          ></path>
        </svg>
        {phone}
      </a>
      <a href={`mailto:${email}`} class="font-display text-2xl transition-colors hover:text-rust">{email}</a>
    </div>
  </div>

  <!-- ===== Mobile ===== -->
  <div class="md:hidden">
    <div class="flex flex-col gap-lg px-sm pb-lg pt-md">
      <!-- Logo -->
      <a href="/" aria-label="sera Wild – Startseite">
        <img src={logoDark.src} alt="sera Wild – prozessorientierte Fotografie" class="w-64 max-w-[70%]" />
      </a>

      <!-- Kontakt + LinkedIn -->
      <div class="flex items-end justify-between">
        <div class="flex flex-col gap-sm">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`WhatsApp: ${phone}`}
            class="inline-flex items-center gap-xs font-display text-2xl transition-colors hover:text-rust"
          >
            <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M17.5 14.38c-.28-.14-1.65-.81-1.9-.9-.26-.1-.44-.14-.63.14-.18.28-.72.9-.88 1.08-.16.18-.32.2-.6.07-.28-.14-1.17-.43-2.23-1.38-.83-.73-1.38-1.64-1.54-1.92-.16-.28-.02-.43.12-.57.13-.13.28-.32.42-.49.14-.16.18-.28.28-.46.09-.18.05-.35-.02-.49-.07-.14-.63-1.51-.86-2.07-.23-.54-.46-.47-.63-.48h-.54c-.18 0-.47.07-.72.35-.25.28-.95.93-.95 2.26 0 1.33.97 2.62 1.1 2.8.14.18 1.92 2.93 4.65 4.11.65.28 1.16.45 1.56.58.65.21 1.25.18 1.72.11.53-.08 1.65-.67 1.88-1.32.23-.65.23-1.2.16-1.32-.07-.11-.25-.18-.53-.32zM12 2a10 10 0 0 0-8.53 15.3L2 22l4.8-1.26A10 10 0 1 0 12 2zm0 18.18a8.16 8.16 0 0 1-4.16-1.14l-.3-.18-2.95.78.79-2.88-.2-.3A8.18 8.18 0 1 1 12 20.18z"
              ></path>
            </svg>
            {phone}
          </a>
          <a href={`mailto:${email}`} class="font-display text-2xl transition-colors hover:text-rust">{email}</a>
        </div>
        <a
          href={linkedInUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="inline-flex h-14 w-14 items-center justify-center rounded-md bg-dark text-cream transition-colors hover:bg-rust"
        >
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M4.98 3.5a2.5 2.5 0 1 1 0 5.001 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.83v1.64h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.56 4.78 5.9V21h-4v-5.9c0-1.41-.03-3.22-2-3.22-2 0-2.31 1.53-2.31 3.11V21h-4V9Z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Dunkler Balken mit Rechtslinks -->
    <nav aria-label="Rechtliches" class="relative z-10 bg-dark px-sm py-sm">
      <ul class="flex flex-wrap items-center justify-center gap-x-md gap-y-xs">
        {
          legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-base uppercase tracking-wider text-cream underline underline-offset-4 transition-colors hover:text-orange"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- Mohn-Illustration (dekorativ, Markenelement) -->
  <Image
    src={flowerRust}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute bottom-0 right-0 z-20 w-28 select-none md:w-36"
  />
</footer>
