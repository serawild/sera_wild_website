---
/**
 * KulissenWaehler — Kulissen zum Durchklicken.
 *
 * Die Bilder werden automatisch aus src/assets/images/Kulissen/ geladen.
 * Dateiname bestimmt die Zuordnung:  <kuerzel>-01.jpg, <kuerzel>-02.jpg …
 * Neue Bilder einfach dort ablegen — sie erscheinen von selbst, ohne
 * Eintrag in bilder.json.
 *
 * Rechner: links ein grosses Bild, rechts die Namen zum Anklicken.
 * Handy:   wischbare Leiste, nach Kulissen gruppiert.
 */
import { Picture } from 'astro:assets';
import DekoIllustration from './DekoIllustration.astro';
import type { ImageMetadata } from 'astro';

interface Kulisse {
  kuerzel: string;
  name: string;
  text: string;
}

interface Props {
  kulissen: Kulisse[];
  ueberschrift: string;
  abschluss: string;
}

const { kulissen, ueberschrift, abschluss } = Astro.props;

const dateien = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/Kulissen/*.{jpg,jpeg,png}',
  { eager: true }
);

// Pro Kulisse die Bilder sammeln, nach Dateiname sortiert
const gruppen = kulissen.map(k => {
  const bilder = Object.entries(dateien)
    .filter(([pfad]) => pfad.split('/').pop()!.startsWith(`${k.kuerzel}-`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
  return { ...k, bilder };
});

// Die zwei überlappenden Plätze — alle im Verhältnis 2:3,
// damit an den Bildern nichts beschnitten wird.
// Drei Bilder: feste Plaetze, Formate 3:2 / 2:3 / 4:5.
const plaetze3 = [
  'left:3rem;top:18rem;width:21rem;height:14rem;',       // quer 3:2, unten — zuoberst
  'left:0;top:0;width:12.5rem;height:18.75rem;',         // hoch 2:3, oben links
  'left:14rem;top:3rem;width:14.5rem;height:18.125rem;', // hoch 4:5, oben rechts
];

// Bei einem oder zwei Bildern richtet sich die Breite nach dem Bild selbst.
// So wird nichts beschnitten, egal in welchem Format es abgelegt wurde.
const rem = (px: number) => Math.round(px * 1000) / 1000;

function plaetzeFuer(bilder: ImageMetadata[]): string[] {
  if (bilder.length >= 3) return plaetze3;

  if (bilder.length === 1) {
    const h = 33.75;   // 27 x 1.25
    const b = rem(h * (bilder[0].width / bilder[0].height));
    return [`left:${rem((33 - b) / 2)}rem;top:1.5rem;width:${b}rem;height:${h}rem;`];
  }

  const hA = 24, hB = 18.5;
  const bA = rem(hA * (bilder[0].width / bilder[0].height));
  const bB = rem(hB * (bilder[1].width / bilder[1].height));
  return [
    `left:0;top:0;width:${bA}rem;height:${hA}rem;`,
    `left:${rem(Math.max(bA - 3, 6))}rem;top:${rem(hA - hB + 4)}rem;width:${bB}rem;height:${hB}rem;`,
  ];
}

const mitBildern = gruppen.filter(g => g.bilder.length > 0);
const erste = mitBildern[0]?.kuerzel ?? '';
---

<!-- ══════════════ Handy: wischbare Leiste ══════════════ -->
<section class="md:hidden bg-dark py-[52px]">
  <div class="px-6 flex flex-col gap-[1.125rem]">
    <div class="flex items-center gap-2 mb-[0.375rem]">
      <span class="font-body text-xs font-bold uppercase tracking-[0.08em] text-cream/50">02</span>
      <span class="w-5 h-px bg-cream/50"></span>
      <span class="font-body text-xs uppercase tracking-[0.08em] text-cream/50">KULISSEN</span>
    </div>
    <h2 class="font-display text-[1.6875rem] leading-[1.28] font-semibold text-cream">{ueberschrift}</h2>
  </div>

  <div
    class="mt-[1.25rem] overflow-x-auto"
    id="kulissen-track"
    style="scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;"
  >
    <div class="flex gap-3 px-6" style="width:max-content;">
      {gruppen.map(g => (
        g.bilder.length > 0 ? g.bilder.map((bild, i) => (
          <div class="shrink-0 flex flex-col" style="scroll-snap-align:start;width:16.25rem;">
            <div style="width:16.25rem;height:21.25rem;overflow:hidden;position:relative;">
              <Picture
                src={g.bilder[i]}
                alt={`${g.name} — ${g.text.replace(/^\.\.\./, '')}`}
                formats={['avif', 'webp']}
                widths={[260, 520]}
                sizes="260px"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
            {i === 0 && (
              <div class="mt-[0.75rem] flex flex-col gap-[0.25rem]">
                <p class="font-body text-xs font-bold uppercase tracking-[0.08em] text-cream">{g.name}</p>
                <p class="font-body text-[1.0625rem] leading-[1.68] text-cream/80">{g.text}</p>
              </div>
            )}
          </div>
        )) : (
          <div class="shrink-0 flex flex-col" style="scroll-snap-align:start;width:16.25rem;">
            <div class="flex items-center justify-center bg-olive/60" style="width:16.25rem;height:21.25rem;">
              <p class="font-display text-[1.6875rem] font-semibold italic text-cream/60 text-center px-4">{g.name}</p>
            </div>
            <div class="mt-[0.75rem] flex flex-col gap-[0.25rem]">
              <p class="font-body text-xs font-bold uppercase tracking-[0.08em] text-cream">{g.name}</p>
              <p class="font-body text-[1.0625rem] leading-[1.68] text-cream/80">{g.text}</p>
            </div>
          </div>
        )
      ))}
      <div class="shrink-0 w-3" aria-hidden="true"></div>
    </div>
  </div>

  <div class="px-6 mt-[1.5rem] flex flex-col gap-[1.125rem]">
    <p class="font-body text-[1.0625rem] leading-[1.68] font-bold text-cream">{abschluss}</p>
    <a
      href="/kontakt"
      class="self-start inline-flex items-center justify-center rounded-[1.0625rem] bg-[#b08257] px-md py-sm font-body text-cta uppercase text-cream"
    >
      MEHR DAZU
    </a>
  </div>
</section>

<!-- ══════════════ Rechner: Durchklicken ══════════════ -->
<section class="hidden md:block relative z-10 overflow-visible bg-cream-warm py-xl">
  <DekoIllustration motiv="eukalyptus" farbe="#5B5C4F" breite={320} cssRotate={-22} top={330} seite="links" abstand={-60} />
  <div class="mx-auto flex max-w-inhalt items-center gap-[5rem]">

    <!-- Bühne: pro Kulisse eine überlappende Dreiergruppe -->
    <div class="relative shrink-0" style="width:35rem;height:36rem;">
      {gruppen.map(g => (
        <div
          class="kulisse-gruppe absolute inset-0 transition-opacity duration-300"
          data-kuerzel={g.kuerzel}
          style={`opacity:${g.kuerzel === erste ? 1 : 0};pointer-events:none;`}
        >
          {g.bilder.length === 0 && (
            <div class="absolute flex items-center justify-center bg-olive/60"
                 style="left:14rem;top:3rem;width:14.5rem;height:18.125rem;">
              <p class="font-display text-h3 font-semibold italic text-cream/70 text-center px-4">{g.name}</p>
            </div>
          )}
          {(() => {
            const pl = plaetzeFuer(g.bilder);
            const reihenfolge = pl.length === 3 ? [1, 2, 0] : pl.map((_, i) => i);
            return reihenfolge.filter(i => g.bilder[i]).map(i => (
              <div class="absolute overflow-hidden rounded-[3px]" style={pl[i]}>
                <Picture
                  src={g.bilder[i]}
                  alt={`${g.name} — ${g.text.replace(/^\.\.\./, '')}`}
                  formats={['avif', 'webp']}
                  widths={[320, 640]}
                  sizes="320px"
                  class="h-full w-full object-cover"
                />
              </div>
            ));
          })()}
        </div>
      ))}
    </div>

    <!-- Auswahl -->
    <div class="flex flex-1 min-w-0 flex-col items-start gap-[3rem]">
      <h2 class="font-display text-h2 font-semibold leading-normal">{ueberschrift}</h2>
      <div class="flex w-full flex-col gap-[1.5rem]">
        {gruppen.map(g => (
          <button
            type="button"
            class="kulisse-knopf group flex flex-col gap-[0.25rem] text-left transition-opacity"
            data-kuerzel={g.kuerzel}
            aria-pressed={g.kuerzel === erste ? 'true' : 'false'}
          >
            <span class="font-body text-body uppercase tracking-[0.08em] flex items-center gap-[0.625rem]">
              <span class="kulisse-strich h-px bg-dark transition-all duration-300"
                    style={`width:${g.kuerzel === erste ? '1.75rem' : '0.75rem'};opacity:${g.kuerzel === erste ? 1 : 0.35};`}></span>
              {g.name}
            </span>
            <span class="font-body text-body leading-[1.65] pl-[2.375rem]">{g.text}</span>
          </button>
        ))}
        <div class="h-px w-full bg-[#5b5c4f]"></div>
        <p class="font-body text-body font-bold leading-[1.65]">{abschluss}</p>
      </div>
      <a
        href="/kontakt"
        class="inline-flex items-center justify-center rounded-[1.0625rem] bg-[#b08257] px-md py-sm font-body text-cta uppercase text-cream transition-opacity hover:opacity-90"
      >
        MEHR DAZU
      </a>
    </div>
  </div>
</section>

<style>
  .kulisse-knopf { opacity: 0.5; }
  .kulisse-knopf[aria-pressed='true'] { opacity: 1; }
  .kulisse-knopf:hover { opacity: 0.8; }
  .kulisse-knopf[aria-pressed='true']:hover { opacity: 1; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const knoepfe = Array.from(document.querySelectorAll<HTMLButtonElement>('.kulisse-knopf'));
    const gruppen = Array.from(document.querySelectorAll<HTMLElement>('.kulisse-gruppe'));
    if (!knoepfe.length || !gruppen.length) return;

    let aktuell = knoepfe.find(k => k.getAttribute('aria-pressed') === 'true')?.dataset.kuerzel
      ?? knoepfe[0].dataset.kuerzel!;

    function zeigen() {
      gruppen.forEach(g => {
        g.style.opacity = g.dataset.kuerzel === aktuell ? '1' : '0';
      });
      knoepfe.forEach(k => {
        const aktiv = k.dataset.kuerzel === aktuell;
        k.setAttribute('aria-pressed', aktiv ? 'true' : 'false');
        const strich = k.querySelector<HTMLElement>('.kulisse-strich');
        if (strich) {
          strich.style.width = aktiv ? '1.75rem' : '0.75rem';
          strich.style.opacity = aktiv ? '1' : '0.35';
        }
      });
    }

    knoepfe.forEach(k => k.addEventListener('click', () => {
      aktuell = k.dataset.kuerzel!;
      zeigen();
    }));

    zeigen();
  });
</script>
