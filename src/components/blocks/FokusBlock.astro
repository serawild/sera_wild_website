---
import type { ImageMetadata } from 'astro';
import Button from '../Button.astro';
import Photo from '../Photo.astro';

interface PhotoItem {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: PhotoItem[];
  imagesSide?: 'left' | 'right';
  title: string;
  lead?: string;
  text: string;
  ctaText: string;
  ctaHref: string;
  bg?: 'cream' | 'dark' | 'beige';
  illustration?: ImageMetadata;
  illustrationSide?: 'left' | 'right';
}

const {
  images,
  imagesSide = 'left',
  title,
  lead,
  text,
  ctaText,
  ctaHref,
  bg = 'cream',
  illustration,
  illustrationSide = 'left',
} = Astro.props;

const count = images.length;
const isDark = bg !== 'cream';
const bgClass = { cream: 'bg-cream', dark: 'bg-dark', beige: 'bg-beige' }[bg];
const titleColor = isDark ? 'text-cream' : 'text-dark';
const textColor = isDark ? 'text-cream' : 'text-dark';
const btnVariant: 'rust' | 'beige' = isDark ? 'beige' : 'rust';

const collageAspect =
  count === 1 ? 'aspect-[4/3]' : count === 2 ? 'aspect-[800/700]' : 'aspect-[689/780]';
---

<section class:list={['relative overflow-hidden', bgClass]}>
  {illustration && (
    <img
      src={illustration.src}
      alt=""
      aria-hidden="true"
      class:list={[
        'pointer-events-none absolute z-10 w-32 opacity-80 md:w-44',
        illustrationSide === 'right' ? 'bottom-0 right-0' : 'bottom-0 left-0',
      ]}
    />
  )}

  <div class="mx-auto grid max-w-content items-center gap-lg px-sm py-xl md:grid-cols-2 md:px-lg">
    <div
      class:list={[
        'relative w-full',
        collageAspect,
        imagesSide === 'right' && 'md:order-last',
      ]}
    >
      {count === 1 && (
        <Photo src={images[0].src} alt={images[0].alt} class="h-full w-full" />
      )}
      {count === 2 && (
        <>
          <Photo src={images[0].src} alt={images[0].alt} class="absolute left-[32.5%] top-0 h-[78.6%] w-[67.5%]" />
          <Photo src={images[1].src} alt={images[1].alt} class="absolute left-0 top-[42.9%] h-[57.1%] w-[37.5%]" />
        </>
      )}
      {count >= 3 && (
        <>
          <Photo src={images[0].src} alt={images[0].alt} class="absolute left-0 top-[7.4%] h-[47.9%] w-[41.1%]" />
          <Photo src={images[1].src} alt={images[1].alt} class="absolute left-[14.9%] top-[48.5%] h-[51.5%] w-[44%]" />
          <Photo src={images[2].src} alt={images[2].alt} class="absolute left-[46.6%] top-0 h-[62.6%] w-[53.4%]" />
        </>
      )}
    </div>

    <div class:list={['flex flex-col gap-md', imagesSide === 'right' && 'md:order-first']}>
      <h2 class:list={['font-display text-h2 font-semibold md:-ml-sm', titleColor]}>{title}</h2>
      <p class:list={['font-body text-body', textColor]}>
        {lead && <span class="font-bold">{lead} </span>}
        {text}
      </p>
      <Button href={ctaHref} variant={btnVariant} class="self-start">{ctaText}</Button>
    </div>
  </div>
</section>
