---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../Button.astro';

interface Testimonial {
  image: ImageMetadata;
  imageAlt: string;
  ausgangslage: string;
  ausgangslageZitat: string;
  ergebnis: string;
  ergebnisZitat: string;
  mainQuote: string;
}

interface Props {
  title: string;
  testimonials: Testimonial[];
  imageSide?: 'left' | 'right';
  ctaText?: string;
  ctaHref?: string;
}

const { title, testimonials, imageSide = 'left', ctaText, ctaHref } = Astro.props;
---

<section class="bg-cream py-xl" data-referenz>
  <div class="mx-auto max-w-content px-sm md:px-lg">
    <h2 class="text-center font-display text-h2 font-semibold text-dark md:-ml-sm">{title}</h2>
  </div>

  <div class="relative mt-lg">
    <button
      data-referenz-prev
      aria-label="Vorheriges Testimonial"
      class="absolute left-2 top-1/2 z-10 -translate-y-1/2 text-5xl leading-none text-dark transition-colors hover:text-olive md:left-sm"
    >
      ‹
    </button>

    <div class="overflow-hidden" data-referenz-viewport>
      <div class="flex transition-transform duration-500 ease-in-out" data-referenz-track>
        {testimonials.map((t) => (
          <div class="w-full shrink-0 px-sm md:px-0" data-referenz-slide>
            <div class="relative mx-auto max-w-content">
              {/* Bild: 62% Breite, je nach imageSide links oder rechts */}
              <div class:list={['w-full md:w-[62%]', imageSide === 'right' && 'md:ml-auto']}>
                <Image
                  src={t.image}
                  alt={t.imageAlt}
                  widths={[400, 700, 900]}
                  sizes="(max-width: 768px) 90vw, 55vw"
                  class="aspect-[3/4] w-full object-cover"
                />
              </div>

              {/* Textblock: überlappt Bild auf der gegenüberliegenden Seite */}
              <div
                class:list={[
                  'mt-md flex flex-col gap-md bg-cream px-sm py-md',
                  'md:absolute md:top-[8%] md:w-[48%] md:px-lg md:py-lg',
                  imageSide === 'right' ? 'md:left-0' : 'md:right-0',
                ]}
              >
                <div>
                  <p class="font-body font-bold text-dark">{t.ausgangslage}</p>
                  <p class="mt-xs font-display text-body italic text-dark">„{t.ausgangslageZitat}"</p>
                  <hr class="mt-md border-dark/20" />
                </div>
                <div>
                  <p class="font-body font-bold text-dark">{t.ergebnis}</p>
                  <p class="mt-xs font-display text-body italic text-dark">„{t.ergebnisZitat}"</p>
                  <hr class="mt-md border-dark/20" />
                </div>
                <div class="bg-dark p-md text-center">
                  <p class="font-body font-bold text-body text-cream">{t.mainQuote}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <button
      data-referenz-next
      aria-label="Nächstes Testimonial"
      class="absolute right-2 top-1/2 z-10 -translate-y-1/2 text-5xl leading-none text-dark transition-colors hover:text-olive md:right-sm"
    >
      ›
    </button>
  </div>

  {ctaText && ctaHref && (
    <div class="mt-lg text-center">
      <Button href={ctaHref} variant="rust">{ctaText}</Button>
    </div>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-referenz]').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-referenz-track]')!;
    const slides = section.querySelectorAll<HTMLElement>('[data-referenz-slide]');
    const prev = section.querySelector<HTMLButtonElement>('[data-referenz-prev]')!;
    const next = section.querySelector<HTMLButtonElement>('[data-referenz-next]')!;

    let current = 0;
    const max = slides.length - 1;

    function update() {
      const w = slides[0]?.offsetWidth ?? 0;
      track.style.transform = `translateX(-${current * w}px)`;
      prev.style.opacity = current === 0 ? '0.3' : '1';
      next.style.opacity = current >= max ? '0.3' : '1';
      prev.disabled = current === 0;
      next.disabled = current >= max;
    }

    prev.addEventListener('click', () => { current = Math.max(0, current - 1); update(); });
    next.addEventListener('click', () => { current = Math.min(max, current + 1); update(); });

    update();
    window.addEventListener('resize', update);
  });
</script>
