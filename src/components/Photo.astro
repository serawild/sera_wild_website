---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Foto in einem Container mit Seitenverhältnis/Rundung.
 * Nutzt astro:assets (WebP, responsive). `class` steuert Grösse/Aspect.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}
const { src, alt, class: className = '' } = Astro.props;
---

<div class:list={['overflow-hidden', className]}>
  <Image
    src={src}
    alt={alt}
    widths={[400, 600, 900]}
    sizes="(max-width: 768px) 90vw, 45vw"
    class="h-full w-full object-cover"
  />
</div>
